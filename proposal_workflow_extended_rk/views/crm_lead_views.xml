<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form_reference" model="ir.ui.view">
        <field name="name">crm.lead.form.reference</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']/h1" position="before">
                <label for="crm_ref" class="oe_edit_only"/>
                <h3 class="text-muted mb-0"><field name="crm_ref" readonly="1" placeholder="Assigned on save"/></h3>
            </xpath>
        </field>
    </record>

    <record id="crm_case_tree_view_oppor_reference" model="ir.ui.view">
        <field name="name">crm.lead.list.reference</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="crm_ref" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_crm_case_opportunities_filter_reference" model="ir.ui.view">
        <field name="name">crm.lead.search.reference</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="crm_ref" string="CRM Reference"/>
            </xpath>
        </field>
    </record>

</odoo>
