<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_proposal" model="ir.ui.view">
        <field name="name">product.template.form.proposal</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Reporting flag sits with the rest of the product classification. -->
            <xpath expr="//field[@name='type'][@widget='radio']" position="after">
                <field name="is_einvoicing_product"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Proposal" name="proposal">
                    <div class="text-muted mb-3">
                        This text is copied onto the Proposal tab of any quotation this
                        product is added to, where it can still be edited for that
                        particular proposal. Enter one bullet per line.
                    </div>
                    <group>
                        <field name="proposal_scope" nolabel="1"
                               placeholder="Scope of work — one bullet per line"/>
                    </group>
                    <group>
                        <field name="proposal_methodology" nolabel="1"
                               placeholder="Methodology — one bullet per line"/>
                    </group>
                    <group>
                        <field name="proposal_deliverables" nolabel="1"
                               placeholder="Deliverables — one per line, optionally 'Title | description'"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view_proposal" model="ir.ui.view">
        <field name="name">product.template.list.proposal</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="is_einvoicing_product" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_proposal" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="name">product.template.search.proposal</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='services']" position="after">
                <separator/>
                <filter string="eInvoicing Products" name="einvoicing_products"
                        domain="[('is_einvoicing_product', '=', True)]"/>
            </xpath>
            <!-- Anchored on the Product Type group-by; 'string' is not a legal
                 inheritance selector. -->
            <xpath expr="//filter[@name='type']" position="after">
                <filter string="eInvoicing Product" name="groupby_einvoicing"
                        context="{'group_by': 'is_einvoicing_product'}"/>
            </xpath>
        </field>
    </record>

</odoo>
