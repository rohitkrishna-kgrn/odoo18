<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_proposal" model="ir.ui.view">
        <field name="name">sale.order.form.proposal</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Documents -->
            <xpath expr="//header" position="inside">
                <button name="action_download_proposal" type="object"
                        string="Download Proposal" class="btn-primary"
                        invisible="not einvoicing_service or state not in ('draft', 'sent') or approval_state == 'approved'"/>
                <button name="action_download_se" type="object"
                        string="Download SE" class="btn-primary"
                        invisible="not einvoicing_service or approval_state != 'approved'"/>
                <field name="is_service_engagement_stage" invisible="1"/>
                <field name="approval_state" invisible="1"/>
                <field name="einvoicing_service" invisible="1"/>
            </xpath>

            <!-- CRM pipeline link - mandatory only while the quotation is
                 being created ("not id" = unsaved record). Once saved it stays
                 editable, so the thousands of existing quotations that have no
                 pipeline record can still be modified. -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="new_renewed" invisible="1"/>
                <field name="crm_pipeline_id"
                       options="{'no_quick_create': True}"
                       required="not id and new_renewed == 'new' and not crm_link_override"/>
                <field name="crm_ref" invisible="not crm_pipeline_id"/>
                <field name="crm_link_override"
                       invisible="new_renewed != 'new' or crm_pipeline_id or (id and not crm_link_override)"/>
                <field name="crm_link_override_reason"
                       placeholder="Why is there no pipeline record for this quotation? Logged in the chatter."
                       invisible="not crm_link_override or crm_pipeline_id"
                       required="crm_link_override and not crm_pipeline_id"/>
            </xpath>

            <!-- Proposal narrative -->
            <xpath expr="//notebook" position="inside">
                <page string="Proposal" name="proposal">
                    <group>
                        <field name="proposal_name"
                               placeholder="e.g. eInvoicing Services"/>
                    </group>
                    <group string="Service Engagement Agreement"
                           invisible="not is_service_engagement_stage">
                        <field name="se_agreement_type"/>
                        <field name="se_effective_date"/>
                        <field name="se_project_duration"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
