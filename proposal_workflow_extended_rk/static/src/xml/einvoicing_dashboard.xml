<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="proposal_workflow_extended_rk.EinvoicingDashboard">
    <div t-att-class="props.className" class="kgrn-shell">
        <div class="o_content kgrn-dash">

        <!-- ── Header ─────────────────────────────────────────────── -->
        <div class="kgrn-dash-head">
            <div class="kgrn-dash-title">
                <h1><t t-esc="state.title"/></h1>
                <span class="kgrn-dash-sub"><t t-esc="state.subtitle"/></span>
            </div>
            <div class="kgrn-dash-filters">
                <div class="kgrn-field">
                    <label>From</label>
                    <input type="date" t-model="state.dateFrom" t-on-change="() => this.load()"/>
                </div>
                <div class="kgrn-field">
                    <label>To</label>
                    <input type="date" t-model="state.dateTo" t-on-change="() => this.load()"/>
                </div>
                <div class="kgrn-field">
                    <label>Salesperson</label>
                    <select t-model="state.salespersonId" t-on-change="() => this.load()">
                        <option value="">All salespeople</option>
                        <option t-foreach="state.salespersons" t-as="user" t-key="user.id"
                                t-att-value="user.id">
                            <t t-esc="user.name"/>
                        </option>
                    </select>
                </div>
                <div class="kgrn-quick">
                    <button t-on-click="() => this.setRange(1)">1M</button>
                    <button t-on-click="() => this.setRange(3)">3M</button>
                    <button t-on-click="() => this.setRange(12)">1Y</button>
                    <button class="kgrn-refresh" t-on-click="() => this.refresh()">
                        <i class="fa fa-refresh"/> Refresh
                    </button>
                </div>
            </div>
        </div>

        <!-- ── States ─────────────────────────────────────────────── -->
        <div t-if="state.error" class="kgrn-alert">
            <i class="fa fa-exclamation-triangle"/> <t t-esc="state.error"/>
        </div>
        <div t-elif="state.loading" class="kgrn-loading">
            <i class="fa fa-circle-o-notch fa-spin"/> Loading…
        </div>

        <t t-else="">
            <!-- ── KPI cards ──────────────────────────────────────── -->
            <div class="kgrn-kpis">
                <div class="kgrn-kpi">
                    <div class="kgrn-kpi-label">Pipeline Records</div>
                    <div class="kgrn-kpi-value"><t t-esc="state.kpis.leads"/></div>
                </div>
                <div class="kgrn-kpi" title="Quotations still numbered Sxxxxx — not yet converted to a Service Engagement.">
                    <div class="kgrn-kpi-label">Proposals Sent</div>
                    <div class="kgrn-kpi-value"><t t-esc="state.kpis.proposals"/></div>
                </div>
                <div class="kgrn-kpi" title="Total value of the Sxxxxx quotations counted under Proposals Sent.">
                    <div class="kgrn-kpi-label">Expected Value</div>
                    <div class="kgrn-kpi-value">
                        <t t-esc="formatMoney(state.kpis.pipeline_value)"/>
                    </div>
                </div>
                <div class="kgrn-kpi" title="Quotations converted on approval and renumbered SExxxxx.">
                    <div class="kgrn-kpi-label">Agreements</div>
                    <div class="kgrn-kpi-value"><t t-esc="state.kpis.agreements"/></div>
                </div>
                <div class="kgrn-kpi" title="Total value of the SExxxxx engagements counted under Agreements.">
                    <div class="kgrn-kpi-label">Order Value</div>
                    <div class="kgrn-kpi-value">
                        <t t-esc="formatMoney(state.kpis.order_value)"/>
                    </div>
                </div>
                <div class="kgrn-kpi kgrn-kpi-alert" t-att-class="{ 'is-clear': !state.kpis.stale }">
                    <div class="kgrn-kpi-label">
                        No Activity &gt; <t t-esc="state.staleDays"/>d
                    </div>
                    <div class="kgrn-kpi-value"><t t-esc="state.kpis.stale"/></div>
                </div>
            </div>

            <!-- ── Status API notice ──────────────────────────────── -->
            <div t-if="state.status_api and (!state.status_api.configured || state.status_api.error)"
                 class="kgrn-status-banner">
                <i class="fa fa-info-circle"/>
                <t t-if="!state.status_api.configured">
                    Project Status Tracker isn't configured — add the URL and token under
                    Settings › CRM › eInvoicing Status API. Project Status, UAT AR/AP and
                    Live AR/AP read NA until then.
                </t>
                <t t-else="">
                    Project Status Tracker: <t t-esc="state.status_api.error"/>
                </t>
            </div>

            <!-- ── Table ──────────────────────────────────────────── -->
            <div class="kgrn-card">
                <div class="kgrn-card-head">
                    <h2>By Pipeline Record</h2>
                </div>
                <div class="kgrn-table-wrap">
                <table class="kgrn-table">
                    <thead>
                        <tr>
                            <th>CRM Ref</th>
                            <th>Opportunity</th>
                            <th>Customer</th>
                            <th>Stage</th>
                            <th>Salesperson</th>
                            <th>Proposals (S)</th>
                            <th class="num">Expected Value</th>
                            <th>Agreements (SE)</th>
                            <th class="num">Order Value</th>
                            <t t-if="state.status_api">
                                <th class="mid" title="From the project status tracker — the position of the SE's least advanced entity.">Project Status</th>
                                <th class="mid" title="UAT invoices issued / received, summed across the SE's entities.">UAT AR/AP</th>
                                <th class="mid" title="Live invoices issued / received, summed across the SE's entities.">Live AR/AP</th>
                            </t>
                            <th class="mid">Last Activity</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-if="!state.rows.length">
                            <td t-att-colspan="state.status_api ? 13 : 10" class="kgrn-empty">
                                No pipeline records in this period.
                            </td>
                        </tr>
                        <tr t-foreach="state.rows" t-as="row" t-key="row.id"
                            t-att-class="{ 'is-stale': row.is_stale }"
                            t-on-click="() => this.openLead(row)">
                            <td class="kgrn-ref"><t t-esc="row.crm_ref"/></td>
                            <td class="kgrn-name"><t t-esc="row.name"/></td>
                            <td><t t-esc="row.partner"/></td>
                            <td><span class="kgrn-stage"><t t-esc="row.stage"/></span></td>
                            <td><t t-esc="row.salesperson"/></td>
                            <td>
                                <a t-if="row.proposal_names.length" href="#"
                                   t-on-click="(ev) => this.openRecordOrders(row, 'proposals', ev)">
                                    <t t-esc="row.proposal_names.join(', ')"/>
                                </a>
                                <span t-else="" class="kgrn-muted">—</span>
                                <span t-if="row.proposal_doc" class="kgrn-pill is-proposal"
                                      title="Proposal PDF generated">P</span>
                            </td>
                            <td class="num"><t t-esc="formatMoney(row.proposal_value)"/></td>
                            <td>
                                <a t-if="row.agreement_names.length" href="#"
                                   t-on-click="(ev) => this.openRecordOrders(row, 'agreements', ev)">
                                    <t t-esc="row.agreement_names.join(', ')"/>
                                </a>
                                <span t-else="" class="kgrn-muted">—</span>
                                <span t-if="row.agreement_doc" class="kgrn-pill is-se"
                                      title="Service Engagement Agreement PDF generated">SE</span>
                            </td>
                            <td class="num"><t t-esc="formatMoney(row.agreement_value)"/></td>
                            <t t-if="state.status_api">
                                <td class="mid">
                                    <span t-att-class="'kgrn-status-pill cat-' + statusCategory(row.status_api.project_status_code)"
                                          t-att-title="row.status_api.project_status_code || ''">
                                        <t t-esc="row.status_api.project_status"/>
                                    </span>
                                </td>
                                <td class="mid">
                                    <span t-att-class="'kgrn-quota is-' + row.status_api.uat.status">
                                        <t t-esc="row.status_api.uat.label"/>
                                    </span>
                                </td>
                                <td class="mid">
                                    <span t-att-class="'kgrn-quota is-' + row.status_api.live.status">
                                        <t t-esc="row.status_api.live.label"/>
                                    </span>
                                </td>
                            </t>
                            <td class="mid">
                                <span t-att-class="row.is_stale ? 'kgrn-pill is-stale' : 'kgrn-muted'"
                                      t-att-title="row.last_activity">
                                    <t t-esc="activityLabel(row)"/>
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
                </div>
            </div>
        </t>
    </div>
    </div>
</t>

</templates>
