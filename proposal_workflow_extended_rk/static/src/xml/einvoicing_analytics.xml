<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="proposal_workflow_extended_rk.EinvoicingAnalytics">
    <div t-att-class="props.className" class="kgrn-shell">
        <div class="o_content kgrn-dash kgrn-analytics">

        <div class="kgrn-dash-head">
            <div class="kgrn-dash-title">
                <h1><t t-esc="state.title"/></h1>
                <span class="kgrn-dash-sub"><t t-esc="state.subtitle"/></span>
            </div>
            <div class="kgrn-dash-filters">
                <div class="kgrn-field">
                    <label>From</label>
                    <input type="date" t-model="state.dateFrom" t-on-change="() => this.load()"/>
                </div>
                <div class="kgrn-field">
                    <label>To</label>
                    <input type="date" t-model="state.dateTo" t-on-change="() => this.load()"/>
                </div>
                <div class="kgrn-field">
                    <label>Salesperson</label>
                    <select t-model="state.salespersonId" t-on-change="() => this.load()">
                        <option value="">All salespeople</option>
                        <option t-foreach="state.salespersons" t-as="user" t-key="user.id"
                                t-att-value="user.id">
                            <t t-esc="user.name"/>
                        </option>
                    </select>
                </div>
                <div class="kgrn-quick">
                    <button t-on-click="() => this.setRange(3)">3M</button>
                    <button t-on-click="() => this.setRange(6)">6M</button>
                    <button t-on-click="() => this.setRange(12)">1Y</button>
                    <button class="kgrn-refresh" t-on-click="() => this.load()">
                        <i class="fa fa-refresh"/> Refresh
                    </button>
                </div>
            </div>
        </div>

        <div t-if="state.error" class="kgrn-alert">
            <i class="fa fa-exclamation-triangle"/> <t t-esc="state.error"/>
        </div>
        <div t-elif="state.loading" class="kgrn-loading">
            <i class="fa fa-circle-o-notch fa-spin"/> Loading…
        </div>
        <div t-elif="!state.hasData" class="kgrn-empty-state">
            <i class="fa fa-pie-chart"/>
            <p>No pipeline records in this period.</p>
            <span>Widen the date range or clear the salesperson filter.</span>
        </div>

        <t t-else="">
            <div class="kgrn-grid">
                <div class="kgrn-card kgrn-chart span-2">
                    <div class="kgrn-chart-head">
                        <h2>Pipeline by Stage</h2>
                        <span>Records and expected value at each stage</span>
                    </div>
                    <div class="kgrn-canvas"><canvas t-ref="stageChart"/></div>
                </div>

                <div class="kgrn-card kgrn-chart">
                    <div class="kgrn-chart-head">
                        <h2>Revenue Mix by Service</h2>
                        <span>Share of order value per eInvoicing service</span>
                    </div>
                    <div class="kgrn-canvas"><canvas t-ref="serviceChart"/></div>
                </div>

                <div class="kgrn-card kgrn-chart">
                    <div class="kgrn-chart-head">
                        <h2>Activity Health</h2>
                        <span>Records worked in the last 7 days</span>
                    </div>
                    <div class="kgrn-canvas"><canvas t-ref="activityChart"/></div>
                </div>

                <div class="kgrn-card kgrn-chart span-2">
                    <div class="kgrn-chart-head">
                        <h2>Monthly Trend</h2>
                        <span>Order value booked against new pipeline records</span>
                    </div>
                    <div class="kgrn-canvas"><canvas t-ref="trendChart"/></div>
                </div>

                <div class="kgrn-card kgrn-chart">
                    <div class="kgrn-chart-head">
                        <h2>Order Value by Salesperson</h2>
                        <span>Top 10 by booked value</span>
                    </div>
                    <div class="kgrn-canvas"><canvas t-ref="salespersonChart"/></div>
                </div>

                <div class="kgrn-card kgrn-chart">
                    <div class="kgrn-chart-head">
                        <h2>Workflow Funnel</h2>
                        <span>Pipeline through to won</span>
                    </div>
                    <div class="kgrn-canvas"><canvas t-ref="funnelChart"/></div>
                </div>
            </div>
        </t>
    </div>
    </div>
</t>

</templates>
