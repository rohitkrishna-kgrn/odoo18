<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Own category, so it gets its own "Project Tools" dropdown instead of
         joining (and breaking) the Project one. The parent puts it under the
         Services heading of the user form; sequence 4 = right after Project (3). -->
    <record id="module_category_project_tools" model="ir.module.category">
        <field name="name">Project Tools</field>
        <field name="parent_id" ref="base.module_category_services"/>
        <field name="sequence">4</field>
    </record>

    <record id="group_project_search_customer" model="res.groups">
        <field name="name">Project Search Customer</field>
        <field name="category_id" ref="module_category_project_tools"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Shows Project > Search Existing Customer and lets the user open every quotation of the chosen customer read-only, without sale access rights.</field>
    </record>

</odoo>
