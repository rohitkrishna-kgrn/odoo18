<odoo>
    <record id="request_extra_hours_wizard_view" model="ir.ui.view">
        <field name="name">request.extra.hours.wizard.form</field>
        <field name="model">request.extra.hours.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Extra Hours">
                <group>
                    <field name="task_id" readonly="1"/>
                    <field name="extra_hours"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button string="Submit" type="object" name="action_submit" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="request_extra_hours_wizard_action" model="ir.actions.act_window">
        <field name="name">Request Extra Hours</field>
        <field name="res_model">request.extra.hours.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="approve_extra_hours_wizard_view" model="ir.ui.view">
        <field name="name">approve.extra.hours.wizard.form</field>
        <field name="model">approve.extra.hours.wizard</field>
        <field name="arch" type="xml">
            <form string="Edit &amp; Approve Extra Hours">
                <group>
                    <field name="task_id"/>
                    <field name="user_id"/>
                    <field name="reason"/>
                    <field name="extra_hours"/>
                </group>
                <footer>
                    <button string="Approve" name="action_approve" type="object" class="btn-primary"/>
                    <button string="Reject" name="action_reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
