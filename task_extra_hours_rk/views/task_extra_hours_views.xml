<odoo>
    <record id="view_task_extra_hours_tree" model="ir.ui.view">
        <field name="name">task.extra.hours.list</field>
        <field name="model">task.extra.hours</field>
        <field name="arch" type="xml">
            <list>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <field name="extra_hours"/>
                <field name="reason"/>
                <field name="status"/>
                <button name="action_approve" string="Approve" type="object"
                        invisible="status != 'draft'"/>
                <button name="action_reject" string="Reject" type="object"
                        invisible="status != 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_task_extra_hours_form" model="ir.ui.view">
        <field name="name">task.extra.hours.form.readonly</field>
        <field name="model">task.extra.hours</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="task_id" readonly="1"/>
                        <field name="project_id" readonly="1"/>
                        <field name="user_id" readonly="1"/>
                        <field name="extra_hours" readonly="1"/>
                        <field name="reason" readonly="1"/>
                        <field name="status" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


</odoo>
