<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="view_crm_external_lead_list" model="ir.ui.view">
        <field name="name">crm.external.lead.list</field>
        <field name="model">crm.external.lead</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Received"/>
                <field name="name"/>
                <field name="company"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="source"/>
                <field name="category"/>
                <field name="user_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'assigned'"
                       decoration-info="state == 'new'"/>
                <button name="action_assign" type="object" string="Assign To"
                        icon="fa-user-plus" class="btn-link"
                        invisible="state == 'assigned'"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_crm_external_lead_form" model="ir.ui.view">
        <field name="name">crm.external.lead.form</field>
        <field name="model">crm.external.lead</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_assign" type="object" string="Assign To"
                            class="btn-primary" invisible="state == 'assigned'"/>
                    <button name="action_view_crm_lead" type="object"
                            string="Open CRM Lead" class="btn-secondary"
                            invisible="not crm_lead_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="source"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="company"/>
                            <field name="city"/>
                        </group>
                        <group>
                            <field name="company_size"/>
                            <field name="currently_uses_erp"/>
                            <field name="plans_to_implement"/>
                            <field name="service_interest"/>
                            <field name="user_id" readonly="1"/>
                            <field name="crm_lead_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Classification">
                        <field name="ai_reason"
                               invisible="category == 'technical'"/>
                        <field name="validity_passed" invisible="category != 'spam'"/>
                        <field name="service_relevant" invisible="category != 'spam'"/>
                        <field name="detail" invisible="category != 'technical'"/>
                        <field name="execution_id" invisible="category != 'technical'"/>
                    </group>
                    <notebook>
                        <page string="Raw Payload">
                            <field name="raw_payload" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_crm_external_lead_search" model="ir.ui.view">
        <field name="name">crm.external.lead.search</field>
        <field name="model">crm.external.lead</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company"/>
                <field name="email"/>
                <filter name="new" string="New" domain="[('state','=','new')]"/>
                <filter name="assigned" string="Assigned" domain="[('state','=','assigned')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_category" string="Category"
                            context="{'group_by': 'category'}"/>
                    <filter name="g_user" string="Salesperson"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Category actions -->
    <record id="action_external_lead_qualified" model="ir.actions.act_window">
        <field name="name">Qualified</field>
        <field name="res_model">crm.external.lead</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category', '=', 'qualified')]</field>
        <field name="context">{'default_category': 'qualified'}</field>
    </record>

    <record id="action_external_lead_spam" model="ir.actions.act_window">
        <field name="name">SPAM / Irrelevant</field>
        <field name="res_model">crm.external.lead</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category', '=', 'spam')]</field>
        <field name="context">{'default_category': 'spam'}</field>
    </record>

    <record id="action_external_lead_technical" model="ir.actions.act_window">
        <field name="name">Technical Issues</field>
        <field name="res_model">crm.external.lead</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category', '=', 'technical')]</field>
        <field name="context">{'default_category': 'technical'}</field>
    </record>

    <!-- Assign wizard -->
    <record id="view_crm_external_lead_assign_wizard_form" model="ir.ui.view">
        <field name="name">crm.external.lead.assign.wizard.form</field>
        <field name="model">crm.external.lead.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign To Salesperson">
                <group>
                    <field name="user_id"/>
                    <field name="date_deadline"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Assign"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- API info wizard -->
    <record id="view_crm_external_lead_api_info_form" model="ir.ui.view">
        <field name="name">crm.external.lead.api.info.form</field>
        <field name="model">crm.external.lead.api.info</field>
        <field name="arch" type="xml">
            <form string="Webhook API Details">
                <group>
                    <field name="full_url"/>
                    <field name="method"/>
                    <field name="auth"/>
                    <field name="content_type"/>
                </group>
                <notebook>
                    <page string="Qualified">
                        <field name="sample_qualified" widget="ace"/>
                    </page>
                    <page string="SPAM / Irrelevant">
                        <field name="sample_spam" widget="ace"/>
                    </page>
                    <page string="Technical Issue">
                        <field name="sample_technical" widget="ace"/>
                    </page>
                </notebook>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crm_external_lead_api_info" model="ir.actions.act_window">
        <field name="name">API Details</field>
        <field name="res_model">crm.external.lead.api.info</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
