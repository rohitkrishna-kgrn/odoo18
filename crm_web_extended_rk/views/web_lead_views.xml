<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ─── List View ─── -->
    <record id="view_crm_web_lead_list" model="ir.ui.view">
        <field name="name">crm.web.lead.list</field>
        <field name="model">crm.web.lead</field>
        <field name="arch" type="xml">
            <list string="Web Leads" decoration-info="state=='new'" decoration-success="state=='allocated'" decoration-muted="state=='converted'">
                <field name="name"/>
                <field name="contact_number"/>
                <field name="email"/>
                <field name="service"/>
                <field name="state" widget="badge" decoration-info="state=='new'" decoration-success="state=='allocated'" decoration-muted="state=='converted'"/>
                <field name="allocated_user_ids" widget="many2many_tags"/>
                <field name="crm_lead_count" string="Leads"/>
                <field name="create_date" string="Received"/>
                <button name="action_allocate" type="object" string="Allocate" icon="fa-user-plus"
                        invisible="state != 'new'"
                        groups="sales_team.group_sale_manager"/>
            </list>
        </field>
    </record>

    <!-- ─── Form View ─── -->
    <record id="view_crm_web_lead_form" model="ir.ui.view">
        <field name="name">crm.web.lead.form</field>
        <field name="model">crm.web.lead</field>
        <field name="arch" type="xml">
            <form string="Web Lead">
                <header>
                    <button name="action_allocate" type="object" string="Allocate to User"
                            class="btn-primary"
                            invisible="state != 'new'"
                            groups="sales_team.group_sale_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,allocated,converted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_crm_leads" type="object"
                                class="oe_stat_button" icon="fa-handshake-o"
                                invisible="crm_lead_count == 0">
                            <field name="crm_lead_count" widget="statinfo" string="Leads"/>
                        </button>
                    </div>
                    <group>
                        <group string="Contact Info">
                            <field name="name"/>
                            <field name="contact_number"/>
                            <field name="email"/>
                            <field name="service"/>
                        </group>
                        <group string="Allocation">
                            <field name="state" readonly="1"/>
                            <field name="allocated_user_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message">
                            <field name="body" placeholder="Message from the web form..."/>
                        </page>
                        <page string="Form Data">
                            <field name="form_data" widget="text" placeholder="Raw JSON form data"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ─── Allocate Wizard ─── -->
    <record id="view_crm_web_lead_allocate_wizard_form" model="ir.ui.view">
        <field name="name">crm.web.lead.allocate.wizard.form</field>
        <field name="model">crm.web.lead.allocate.wizard</field>
        <field name="arch" type="xml">
            <form string="Allocate Web Leads">
                <group>
                    <field name="web_lead_ids" widget="many2many_tags" readonly="1"/>
                    <field name="user_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           domain="[('share', '=', False)]"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Allocate &amp; Create CRM Leads" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ─── Batch Allocate server action (Actions menu in list) ─── -->
    <record id="action_server_batch_allocate_web_leads" model="ir.actions.server">
        <field name="name">Allocate to User</field>
        <field name="model_id" ref="model_crm_web_lead"/>
        <field name="binding_model_id" ref="model_crm_web_lead"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_allocate()</field>
        <field name="groups_id" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <!-- ─── Action ─── -->
    <record id="action_crm_web_lead" model="ir.actions.act_window">
        <field name="name">Web Leads</field>
        <field name="res_model">crm.web.lead</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_state_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No web leads yet</p>
            <p>Leads received via the webhook API will appear here.</p>
        </field>
    </record>

    <!-- ─── API Info Wizard ─── -->
    <record id="view_crm_web_lead_api_info_form" model="ir.ui.view">
        <field name="name">crm.web.lead.api.info.form</field>
        <field name="model">crm.web.lead.api.info</field>
        <field name="arch" type="xml">
            <form string="Webhook API Details">
                <sheet>

                    <!-- Endpoint summary -->
                    <group string="Endpoint">
                        <field name="method" readonly="1"/>
                        <field name="full_url" readonly="1"/>
                        <field name="content_type" readonly="1"/>
                        <field name="auth" readonly="1"/>
                    </group>

                    <!-- How mapping works -->
                    <group string="How Field Mapping Works">
                        <div class="col-12">
                            <div class="alert alert-info" role="alert" style="font-size:13px;">
                                The endpoint <strong>auto-detects</strong> the source on every request:<br/>
                                &#8226; Payload with a <code>"fields"</code> array (id / title / value objects) → treated as <strong>Elementor Pro</strong>.<br/>
                                &#8226; Flat JSON or form-urlencoded → treated as <strong>Custom</strong>.<br/><br/>
                                Field values are resolved via the <strong>Field Mappings</strong> configuration (CRM → Web Leads → Field Mappings).
                                Any key not matched by a mapping is stored verbatim in <em>Form Data</em> and shown in the Internal Notes of the created CRM lead.
                            </div>
                        </div>
                    </group>

                    <!-- Mapped fields table -->
                    <group string="Mapped Target Fields">
                        <div class="col-12">
                            <table class="table table-sm table-bordered" style="font-size:13px;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Odoo Field</th>
                                        <th>Required</th>
                                        <th>Default Custom Keys</th>
                                        <th>Default Elementor IDs</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>name</strong></td>
                                        <td>Yes</td>
                                        <td><code>name</code></td>
                                        <td><code>name</code>, <code>full_name</code>, <code>your-name</code></td>
                                    </tr>
                                    <tr>
                                        <td><strong>contact_number</strong></td>
                                        <td>No</td>
                                        <td><code>contact_number</code>, <code>phone</code></td>
                                        <td><code>phone</code>, <code>your-phone</code>, <code>mobile</code></td>
                                    </tr>
                                    <tr>
                                        <td><strong>email</strong></td>
                                        <td>No</td>
                                        <td><code>email</code></td>
                                        <td><code>email</code>, <code>your-email</code></td>
                                    </tr>
                                    <tr>
                                        <td><strong>body</strong></td>
                                        <td>No</td>
                                        <td><code>body</code>, <code>message</code></td>
                                        <td><code>message</code>, <code>your-message</code></td>
                                    </tr>
                                    <tr>
                                        <td><strong>service</strong></td>
                                        <td>No</td>
                                        <td><code>service</code></td>
                                        <td><code>service</code></td>
                                    </tr>
                                    <tr>
                                        <td><em>any extra</em></td>
                                        <td>No</td>
                                        <td colspan="2">Saved to Form Data → Internal Notes on the CRM lead</td>
                                    </tr>
                                </tbody>
                            </table>
                            <p style="font-size:12px;color:#888;">To add or change mappings go to: CRM → Web Leads → Field Mappings</p>
                        </div>
                    </group>

                    <notebook>
                        <page string="Custom / Flat JSON">
                            <group>
                                <div class="col-12">
                                    <p style="font-size:13px;">Send a plain <code>application/json</code> POST. Keys are matched directly against the mapping table.</p>
                                </div>
                            </group>
                            <field name="sample_custom" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Elementor Pro">
                            <group>
                                <div class="col-12">
                                    <p style="font-size:13px;">
                                        In Elementor Pro → Form → Actions → Webhook, set the URL below.<br/>
                                        Elementor sends <code>application/json</code> with a <code>"fields"</code> array — detected automatically.<br/>
                                        Match is done against each field's <code>id</code> (or <code>title</code> if configured in Field Mappings).
                                    </p>
                                </div>
                            </group>
                            <field name="sample_elementor" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>

                </sheet>
                <footer>
                    <button special="cancel" string="Close" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crm_web_lead_api_info" model="ir.actions.act_window">
        <field name="name">API Details</field>
        <field name="res_model">crm.web.lead.api.info</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_crm_web_lead_api_info_form"/>
        <field name="target">new</field>
    </record>

    <!-- ─── Default search filter ─── -->
    <record id="view_crm_web_lead_search" model="ir.ui.view">
        <field name="name">crm.web.lead.search</field>
        <field name="model">crm.web.lead</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="contact_number"/>
                <field name="service"/>
                <filter name="state_new" string="New" domain="[('state','=','new')]"/>
                <filter name="state_allocated" string="Allocated" domain="[('state','=','allocated')]"/>
                <filter name="state_converted" string="Converted" domain="[('state','=','converted')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_service" string="Service" context="{'group_by': 'service'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
