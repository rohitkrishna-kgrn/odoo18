<odoo>
  <record id="view_move_form_inherit_product" model="ir.ui.view">
    <field name="name">account.move.form.inherit.product</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <!-- Target the tree view inside journal items (account.move.line) -->
      <xpath expr="//field[@name='line_ids']/list/field[@name='partner_id']" position="after">
        <field name="product_id"/>
      </xpath>
    </field>
  </record>
</odoo>