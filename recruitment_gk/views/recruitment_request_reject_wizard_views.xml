<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_recruitment_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">recruitment.request.reject.wizard.form</field>
        <field name="model">recruitment.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Recruitment Request">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="rejection_remark"
                           placeholder="Enter reason for rejection…"
                           nolabel="0"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Confirm Rejection"
                            type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
