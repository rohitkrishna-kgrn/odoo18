<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_recruitment_send_manager_wizard_form" model="ir.ui.view">
        <field name="name">recruitment.send.manager.wizard.form</field>
        <field name="model">recruitment.send.manager.wizard</field>
        <field name="arch" type="xml">
            <form string="Send to Manager">
                <field name="candidate_id" invisible="1"/>
                <group>
                    <field name="manager_id" widget="many2one_avatar_user"
                           string="Select Hiring Manager"/>
                </group>
                <footer>
                    <button string="Send" name="action_confirm"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
