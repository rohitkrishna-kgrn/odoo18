<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_recruitment_send_invitation_wizard_form" model="ir.ui.view">
        <field name="name">recruitment.send.invitation.wizard.form</field>
        <field name="model">recruitment.send.invitation.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Interview Invitation">
                <sheet>
                    <div class="oe_title">
                        <h2>Send Interview Invitation</h2>
                    </div>
                    <group>
                        <field name="interview_round_id" readonly="1"/>
                    </group>
                    <group string="Candidate">
                        <field name="candidate_id" readonly="1" string="Candidate"/>
                        <field name="candidate_email"
                               string="Candidate Email"
                               placeholder="Enter candidate email address…"
                               widget="email"/>
                    </group>
                    <group string="Interviewers">
                        <field name="interviewer_ids"
                               widget="many2many_tags"
                               nolabel="1"
                               domain="[('email', '!=', False)]"
                               options="{'no_create': True}"
                               placeholder="Select interviewers from the system…"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_send" string="Send Invitation"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
