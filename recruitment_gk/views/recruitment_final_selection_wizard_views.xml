<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_recruitment_final_selection_wizard_form" model="ir.ui.view">
        <field name="name">recruitment.final.selection.wizard.form</field>
        <field name="model">recruitment.final.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Final Candidate Selection">
                <sheet>
                    <div class="oe_title">
                        <h2>Final Candidate Selection</h2>
                    </div>
                    <group>
                        <field name="request_id" readonly="1"/>
                        <field name="num_vacancies" readonly="1"/>
                    </group>
                    <field name="candidate_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="name" string="Candidate"/>
                            <field name="current_designation" string="Designation"/>
                            <field name="total_experience" string="Experience"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'selected'"
                                   decoration-info="state == 'interview'"
                                   decoration-warning="state == 'hm_approved'"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_mark_selected" string="Mark as Selected"
                            type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
