<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_recruitment_set_to_new_wizard_form" model="ir.ui.view">
        <field name="name">recruitment.set.to.new.wizard.form</field>
        <field name="model">recruitment.set.to.new.wizard</field>
        <field name="arch" type="xml">
            <form string="Reset Candidate to New">
                <sheet>
                    <div class="oe_title">
                        <h2>Reset Candidate to New</h2>
                    </div>
                    <group>
                        <field name="candidate_id" readonly="1"/>
                        <field name="remark"
                               placeholder="Enter reason for resetting this candidate to New…"
                               nolabel="0"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm Reset"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
