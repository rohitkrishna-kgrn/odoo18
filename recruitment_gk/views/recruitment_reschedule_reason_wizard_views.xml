<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_recruitment_reschedule_reason_wizard_form" model="ir.ui.view">
        <field name="name">recruitment.reschedule.reason.wizard.form</field>
        <field name="model">recruitment.reschedule.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reschedule Interview">
                <group>
                    <field name="interview_round_id" readonly="1"/>
                    <field name="reason"
                           placeholder="Enter the reason for rescheduling this interview…"
                           required="1"/>
                </group>
                <footer>
                    <button name="action_confirm_reschedule" string="Confirm Reschedule"
                            type="object" class="btn-warning"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
