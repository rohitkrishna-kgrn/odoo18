<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- "Referral" dropdown in the CRM top bar (no longer its own app).
         Everything below sits inside it: plain entries are dropdown items,
         Reports and Configuration render as section headers. A referral user
         also needs CRM access to see it. -->
    <menuitem
        id="menu_referral_root"
        name="Referral"
        parent="crm.crm_menu_root"
        sequence="15"
        groups="referral_crm_gk.group_referral_user,referral_crm_gk.group_referral_manager,referral_crm_gk.group_referral_accounts,referral_crm_gk.group_referral_admin"
    />

    <!-- Dashboard -->
    <menuitem
        id="menu_referral_dashboard"
        name="Dashboard"
        parent="menu_referral_root"
        action="action_open_referral_dashboard"
        sequence="1"
        groups="referral_crm_gk.group_referral_user,referral_crm_gk.group_referral_manager"
    />

    <!-- Pipeline — server action applies role-based domain, defaults to Kanban view -->
    <menuitem
        id="menu_referral_pipeline"
        name="Pipeline"
        parent="menu_referral_root"
        action="action_referral_pipeline_dispatch"
        sequence="5"
        groups="referral_crm_gk.group_referral_user,referral_crm_gk.group_referral_manager"
    />

    <!-- My Leads -->
    <menuitem
        id="menu_referral_my_leads"
        name="My Leads"
        parent="menu_referral_root"
        action="action_referral_my_leads"
        sequence="10"
        groups="referral_crm_gk.group_referral_user,referral_crm_gk.group_referral_manager"
    />

    <!-- All Referrals — managers see all; users see only their assigned leads -->
    <record id="menu_referral_all" model="ir.ui.menu">
        <field name="name">All Referrals</field>
        <field name="parent_id" ref="menu_referral_root"/>
        <field name="action" ref="action_referral_all_dispatch"/>
        <field name="sequence">15</field>
        <field name="groups_id" eval="[(6, 0, [ref('referral_crm_gk.group_referral_user'), ref('referral_crm_gk.group_referral_manager')])]"/>
    </record>

    <!-- Converted Referrals — Manager and Accounts access group only -->
    <record id="menu_referral_converted" model="ir.ui.menu">
        <field name="name">Converted Referrals</field>
        <field name="parent_id" ref="menu_referral_root"/>
        <field name="action" ref="action_referral_converted_referrals"/>
        <field name="sequence">16</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('referral_crm_gk.group_referral_manager'),
            ref('referral_crm_gk.group_referral_accounts'),
        ])]"/>
    </record>

    <!-- Referrers -->
    <record id="menu_referral_referrers" model="ir.ui.menu">
        <field name="name">Referrers</field>
        <field name="parent_id" ref="menu_referral_root"/>
        <field name="action" ref="action_referral_referrers"/>
        <field name="sequence">20</field>
        <field name="groups_id" eval="[(6, 0, [ref('referral_crm_gk.group_referral_user'), ref('referral_crm_gk.group_referral_manager')])]"/>
    </record>

    <!-- Commissions -->
    <menuitem
        id="menu_referral_commissions"
        name="Commissions"
        parent="menu_referral_root"
        action="action_referral_commissions"
        sequence="25"
        groups="referral_crm_gk.group_referral_user,referral_crm_gk.group_referral_manager,referral_crm_gk.group_referral_accounts"
    />

    <!-- Reports — manager, accounts and admin -->
    <record id="menu_referral_reports" model="ir.ui.menu">
        <field name="name">Reports</field>
        <field name="parent_id" ref="menu_referral_root"/>
        <field name="sequence">30</field>
        <field name="groups_id" eval="[(6, 0, [ref('referral_crm_gk.group_referral_manager'), ref('referral_crm_gk.group_referral_accounts'), ref('referral_crm_gk.group_referral_admin')])]"/>
    </record>

    <record id="menu_referral_reports_commission" model="ir.ui.menu">
        <field name="name">Commission Report</field>
        <field name="parent_id" ref="menu_referral_reports"/>
        <field name="action" ref="action_referral_commission_report"/>
        <field name="sequence">1</field>
        <field name="groups_id" eval="[(6, 0, [ref('referral_crm_gk.group_referral_manager'), ref('referral_crm_gk.group_referral_accounts'), ref('referral_crm_gk.group_referral_admin')])]"/>
    </record>

    <record id="menu_referral_reports_summary" model="ir.ui.menu">
        <field name="name">Referral Summary</field>
        <field name="parent_id" ref="menu_referral_reports"/>
        <field name="action" ref="action_referral_summary_report"/>
        <field name="sequence">5</field>
        <field name="groups_id" eval="[(6, 0, [ref('referral_crm_gk.group_referral_manager'), ref('referral_crm_gk.group_referral_accounts'), ref('referral_crm_gk.group_referral_admin')])]"/>
    </record>

    <!-- Configuration — Referral Admin only -->
    <record id="menu_referral_config" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="menu_referral_root"/>
        <field name="sequence">100</field>
        <field name="groups_id" eval="[(6, 0, [ref('referral_crm_gk.group_referral_admin')])]"/>
    </record>

    <record id="menu_referral_config_settings" model="ir.ui.menu">
        <field name="name">Settings</field>
        <field name="parent_id" ref="menu_referral_config"/>
        <field name="action" ref="action_referral_settings"/>
        <field name="sequence">1</field>
        <field name="groups_id" eval="[(6, 0, [ref('referral_crm_gk.group_referral_admin')])]"/>
    </record>

</odoo>
