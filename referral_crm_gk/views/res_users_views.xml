<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The Referral role is one dropdown in the Sales block of the Access
         Rights tab; the four group checkboxes are not shown at all (see
         res_users.py). The Sales block is generated by core
         (base.user_groups_view) and named "sales_access" in res_users.py. While a module installs or creates groups,
         core temporarily swaps that view for a placeholder that keeps the
         plain groups_id field instead, so the expression also matches that
         field. Without the fallback, any such install would fail with
         "Element cannot be located in parent view". -->
    <!-- During data loading this writes core's placeholder groups view, so
         the record below validates through the groups_id fallback; core
         regenerates the real view (with name="sales_access") at the end of
         the upgrade. Without it, the first upgrade that adds this anchor
         fails because the stored view is not tagged yet. -->
    <function model="res.groups" name="_update_user_groups_view"/>

    <record id="view_users_form_referral_role" model="ir.ui.view">
        <field name="name">res.users.form.referral.role</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']//group[@name='sales_access']/field[1] | //page[@name='access_rights']//field[@name='groups_id']" position="after">
                <newline/>
                <field name="referral_role" string="Referral Access"/>
            </xpath>
        </field>
    </record>

</odoo>
