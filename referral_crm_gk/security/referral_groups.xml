<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dedicated category so groups appear as their own row in user access rights -->
    <record id="module_category_referral" model="ir.module.category">
        <field name="name">Referral</field>
        <field name="parent_id" ref="base.module_category_sales"/>
        <field name="sequence">25</field>
    </record>

    <record id="group_referral_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="referral_crm_gk.module_category_referral"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_referral_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="referral_crm_gk.module_category_referral"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_referral_accounts" model="res.groups">
        <field name="name">Accounts</field>
        <field name="category_id" ref="referral_crm_gk.module_category_referral"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Admin: every right in this module (it implies Manager, which covers
         User and Accounts) plus Configuration, which only Admin sees; can
         export. Never emailed by this module and never auto-assigned as
         salesperson (see crm_lead.py), although it counts as a Manager. -->
    <record id="group_referral_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="referral_crm_gk.module_category_referral"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_allow_export')), (4, ref('referral_crm_gk.group_referral_manager'))]"/>
    </record>

</odoo>
