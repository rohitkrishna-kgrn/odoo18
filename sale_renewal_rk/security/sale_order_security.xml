<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Odoo's own "Personal Orders" rule restricts a "User: Own Documents
            Only" salesperson to orders where they are the salesperson. That is
            the rule behind

                "GOKUL KRISHNA (id=29) doesn't have 'write' access to
                 Sales Order, SE07770 - Blame the following rules: Personal Orders"

            Record rules attached to groups are OR-ed together, so this rule sits
            alongside "Personal Orders" rather than replacing it: a user keeps the
            Own Documents Only restriction unless the "Sales Team" checkbox on
            their user form is ticked, in which case every order is readable and
            writable.

            Users without the checkbox evaluate to the always-false domain, which
            contributes nothing to the OR - their restriction is untouched.
        -->
        <record id="sale_order_rule_sales_team_all" model="ir.rule">
            <field name="name">Sales Order: Sales Team members work on all orders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)] if user.sales_team else [(0, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
