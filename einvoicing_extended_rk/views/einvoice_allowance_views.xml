<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_einvoice_allowance_list" model="ir.ui.view">
        <field name="name">einvoice.allowance.list</field>
        <field name="model">einvoice.allowance</field>
        <field name="arch" type="xml">
            <list string="Allowances / Charges" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="move_id"/>
                <field name="move_line_id" optional="hide"/>
                <field name="charge_indicator"/>
                <field name="reason_code"/>
                <field name="reason"/>
                <field name="percent"/>
                <field name="base_amount"/>
                <field name="amount"/>
                <field name="vat_category"/>
                <field name="vat_rate"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_einvoice_allowance_form" model="ir.ui.view">
        <field name="name">einvoice.allowance.form</field>
        <field name="model">einvoice.allowance</field>
        <field name="arch" type="xml">
            <form string="Allowance / Charge">
                <sheet>
                    <group>
                        <group>
                            <field name="move_id"/>
                            <field name="move_line_id"/>
                            <field name="charge_indicator"/>
                            <field name="reason_code"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="percent"/>
                            <field name="base_amount"/>
                            <field name="amount"/>
                            <field name="vat_category"/>
                            <field name="vat_rate"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
