<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_form_reminder" model="ir.ui.view">
        <field name="name">project.project.form.reminder</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <!-- Smart button: Reminders count -->
            <div name="button_box" position="inside">
                <button name="action_view_reminders" type="object"
                    class="oe_stat_button" icon="fa-bell">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="reminder_line_count"/>
                        </span>
                        <span class="o_stat_text">Reminders</span>
                    </div>
                </button>
            </div>

            <!-- "Add Reminder" button: hidden for Done and Cancelled stages -->
            <xpath expr="//header" position="inside">
                <field name="is_closed_stage" invisible="1"/>
                <field name="has_active_reminders" invisible="1"/>
                <button name="action_open_reminder_wizard" type="object"
                    string="Add Reminder" class="btn-secondary"
                    invisible="is_closed_stage"
                    readonly="has_active_reminders"/>
            </xpath>

        </field>
    </record>

</odoo>
