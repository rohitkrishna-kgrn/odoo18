<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_reminder_wizard_form" model="ir.ui.view">
        <field name="name">project.reminder.wizard.form</field>
        <field name="model">project.reminder.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Project Reminder">
                <sheet>
                    <group string="Project">
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="sale_order_line_id"
                                domain="[('order_id', '=', sale_order_id)]"
                                options="{'no_create': True}"
                                required="1"/>
                        </group>
                        <group>
                            <field name="engagement_start" readonly="1"/>
                            <field name="engagement_end" readonly="1"/>
                        </group>
                    </group>
                    <group string="Reminder Configuration">
                        <group>
                            <field name="reminder_type"/>
                            <field name="yearly_frequency"
                                invisible="reminder_type != 'yearly'"/>
                        </group>
                        <group>
                            <field name="remarks"
                                placeholder="Optional remarks or notes…"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reminder Dates" name="reminder_dates">
                            <p class="text-muted"
                                invisible="line_ids">
                                Select a Sale Order Line and Reminder Type above — dates will be generated automatically.
                            </p>
                            <field name="line_ids" invisible="not line_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="period_label" readonly="1" string="Period"/>
                                    <field name="period_date_min" column_invisible="1"/>
                                    <field name="period_date_max" column_invisible="1"/>
                                    <field name="reminder_date" required="1"
                                        widget="period_date_field"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm &amp; Schedule"
                        class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_reminder_wizard" model="ir.actions.act_window">
        <field name="name">Add Project Reminder</field>
        <field name="res_model">project.reminder.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
