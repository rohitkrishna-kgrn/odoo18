<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        noupdate="0" → the schedule is re-applied on every module upgrade.
        UAE Standard Time = UTC+4 (no DST).  04:30 UTC = 08:30 UAE, so the
        alerts land at the start of the working day.
    -->
    <data noupdate="0">

        <record id="cron_project_deadline_alerts" model="ir.cron">
            <field name="name">Project Extended: Project Deadline Alerts</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="state">code</field>
            <field name="code">model._cron_deadline_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(lambda n, t: t if t > n else t + timedelta(days=1))(datetime.now(), datetime.now().replace(hour=4, minute=30, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="cron_task_deadline_alerts" model="ir.cron">
            <field name="name">Project Extended: Task Deadline Alerts</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="state">code</field>
            <field name="code">model._cron_deadline_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(lambda n, t: t if t > n else t + timedelta(days=1))(datetime.now(), datetime.now().replace(hour=4, minute=35, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>
