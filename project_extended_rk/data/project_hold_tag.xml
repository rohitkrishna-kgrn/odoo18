<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Task-level counterpart of the project "On Hold" stage.
             noupdate: the firm may recolour / rename it without an upgrade
             putting the original values back. -->
        <record id="project_tag_on_hold" model="project.tags">
            <field name="name">On Hold</field>
            <field name="color">3</field>
        </record>
    </data>
</odoo>
