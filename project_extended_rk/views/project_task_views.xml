<odoo>
    <!-- Inherit the tree view to add fields -->
    <record id="view_task_tree_inherit_custom" model="ir.ui.view">
        <field name="name">project.task.tree.inherit.custom</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <!-- Add your fields here -->
                <field name="completed_date"/>
            </xpath>
            <xpath expr="//list/field[@name='partner_id']" position="replace">
                <field name="partner_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_task_form_inherit_custom" model="ir.ui.view">
        <field name="name">project.task.form.inherit.custom</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="dms_folder_id" readonly="1"/>
                <field name="billable_type" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_task_search_inherit_custom" model="ir.ui.view">
        <field name="name">project.task.search.inherit.custom</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="state_additional_new" string="New" domain="[('state_additional','=','new')]" />
                <filter name="state_additional_in_progress" string="In Progress" domain="[('state_additional','=','in_progress')]" />
                <filter name="state_additional_waiting" string="Waiting for Approval" domain="[('state_additional','=','waiting_for_approval')]" />
                <filter name="state_additional_completed" string="Completed" domain="[('state_additional','=','completed')]" />

                <separator string="Billable Type"/>
                <filter name="filter_billable"
                        string="Billable"
                        domain="[('billable_type','=','billable')]"/>
                <filter name="filter_non_billable"
                        string="Non-Billable"
                        domain="[('billable_type','=','non_billable')]"/>

                <group string="Completed Date" expand="0">
                    <filter name="completed_this_week" string="Completed This Week" domain="[('completed_this_week', '=', True)]"/>
                    <filter name="completed_this_month" string="Completed This Month" domain="[('completed_this_month', '=', True)]"/>
                    <filter name="completed_this_year" string="Completed This Year" domain="[('completed_this_year', '=', True)]"/>
                </group>

                <!-- Optional: manual filter by completed_date -->
                <field name="completed_date" string="Completed Date"/>
            </xpath>
        </field>
    </record>

    <record id="project_project_search_view_inherit" model="ir.ui.view">
        <field name="name">project.project.search.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                
                <separator string="Billable Type"/>

                <filter name="filter_project_billable"
                        string="Billable"
                        domain="[('billable_type','=','billable')]"/>

                <filter name="filter_project_non_billable"
                        string="Non-Billable"
                        domain="[('billable_type','=','non_billable')]"/>

            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_sale_line" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sale.line</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Sale order Line">
                    <field name="sale_order_line_id" widget="many2one"/>
                    <field name="advance_invoice"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
