<odoo>
    <!-- Inherit the tree view to add fields -->
    <record id="view_task_tree_inherit_custom" model="ir.ui.view">
        <field name="name">project.task.tree.inherit.custom</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <!-- Add your fields here -->
                <field name="completed_date"/>
                <field name="is_on_hold" optional="hide"/>
            </xpath>
            <xpath expr="//list/field[@name='partner_id']" position="replace">
                <field name="partner_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_task_form_inherit_custom" model="ir.ui.view">
        <field name="name">project.task.form.inherit.custom</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="dms_folder_id" readonly="1"/>
                <field name="billable_type" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- The task workflow buttons. They used to live in
         my_project_stage_automation; that module was uninstalled and the
         header went with it, leaving the state_additional badge below with no
         way to move it. Each button is visible only in the state it can act
         on, so the header reads as the step the task is actually at. -->
    <record id="view_task_form_workflow_buttons" model="ir.ui.view">
        <field name="name">project.task.form.workflow.buttons</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_in_progress"
                        string="In Progress"
                        type="object"
                        class="oe_highlight"
                        invisible="state_additional not in ('new', 'on_hold')"/>
                <button name="action_on_hold"
                        string="On Hold"
                        type="object"
                        class="btn-warning"
                        invisible="state_additional != 'in_progress'"/>
                <button name="action_send_for_approval"
                        string="Send for Approval"
                        type="object"
                        class="oe_highlight"
                        invisible="state_additional != 'in_progress'"/>
                <button name="action_approve"
                        string="Approve"
                        type="object"
                        class="oe_highlight"
                        invisible="state_additional != 'waiting_for_approval'"/>
                <button name="action_retrieve"
                        string="Retrieve"
                        type="object"
                        class="btn-danger"
                        invisible="state_additional != 'waiting_for_approval'"/>
            </xpath>
        </field>
    </record>

    <record id="view_task_search_inherit_custom" model="ir.ui.view">
        <field name="name">project.task.search.inherit.custom</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="state_additional_new" string="New" domain="[('state_additional','=','new')]" />
                <filter name="state_additional_in_progress" string="In Progress" domain="[('state_additional','=','in_progress')]" />
                <filter name="state_additional_on_hold" string="On Hold" domain="[('state_additional','=','on_hold')]" />
                <filter name="state_additional_waiting" string="Waiting for Approval" domain="[('state_additional','=','waiting_for_approval')]" />
                <filter name="state_additional_completed" string="Completed" domain="[('state_additional','=','completed')]" />

                <separator string="On Hold"/>
                <filter name="filter_hide_on_hold"
                        string="Hide On Hold"
                        domain="[('is_on_hold','=',False)]"/>
                <filter name="filter_on_hold"
                        string="On Hold"
                        domain="[('is_on_hold','=',True)]"/>

                <separator string="Billable Type"/>
                <filter name="filter_billable"
                        string="Billable"
                        domain="[('billable_type','=','billable')]"/>
                <filter name="filter_non_billable"
                        string="Non-Billable"
                        domain="[('billable_type','=','non_billable')]"/>

                <group string="Completed Date" expand="0">
                    <filter name="completed_this_week" string="Completed This Week" domain="[('completed_this_week', '=', True)]"/>
                    <filter name="completed_this_month" string="Completed This Month" domain="[('completed_this_month', '=', True)]"/>
                    <filter name="completed_this_year" string="Completed This Year" domain="[('completed_this_year', '=', True)]"/>
                </group>

            </xpath>
        </field>
    </record>

    <record id="project_project_search_view_inherit" model="ir.ui.view">
        <field name="name">project.project.search.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                
                <separator string="Billable Type"/>

                <filter name="filter_project_billable"
                        string="Billable"
                        domain="[('billable_type','=','billable')]"/>

                <filter name="filter_project_non_billable"
                        string="Non-Billable"
                        domain="[('billable_type','=','non_billable')]"/>

            </xpath>
        </field>
    </record>

    <record id="view_timesheet_search_billable_filter" model="ir.ui.view">
        <field name="name">account.analytic.line.search.billable</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="custom_filter_billable"
                        string="Billable"
                        domain="[('project_id.billable_type', '=', 'billable')]"/>
                <filter name="custom_filter_non_billable"
                        string="Non-Billable"
                        domain="[('project_id.billable_type', '=', 'non_billable')]"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_sale_line" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sale.line</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Sale order Line">
                    <field name="sale_order_line_id" widget="many2one"/>
                    <field name="advance_invoice"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- PM workload views: on-hold tasks are hidden by default.
         The filter is a normal search facet, so a PM can clear it to see them. -->
    <record id="project.action_view_all_task" model="ir.actions.act_window">
        <field name="context">{'search_default_open_tasks': 1, 'search_default_filter_hide_on_hold': 1, 'default_user_ids': [(4, uid)], 'sale_show_partner_name': True}</field>
    </record>

    <record id="project.action_view_my_task" model="ir.actions.act_window">
        <field name="context">{'search_default_open_tasks': 1, 'search_default_filter_hide_on_hold': 1, 'all_task': 0, 'default_user_ids': [(4, uid)], 'sale_show_partner_name': True}</field>
    </record>

    <record id="project.action_view_task" model="ir.actions.act_window">
        <field name="context">{'sale_show_partner_name': True, 'search_default_my_tasks': 1, 'search_default_filter_hide_on_hold': 1}</field>
    </record>
</odoo>
