<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Project Team Form View -->
    <record id="view_project_team_form" model="ir.ui.view">
        <field name="name">project.team.form</field>
        <field name="model">project.team</field>
        <field name="arch" type="xml">
            <form string="Project Team">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="member_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Project Team Tree View -->
    <record id="view_project_team_tree" model="ir.ui.view">
        <field name="name">project.team.list</field>
        <field name="model">project.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="member_ids"/>
            </list>
        </field>
    </record>

    <!-- Inherited Task Form View to Replace Assignees -->
    <record id="view_task_form_custom" model="ir.ui.view">
        <field name="name">project.task.form.team</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="project_team_id"/>
                <field name="team_member_ids" widget="many2many_tags"/>
            </xpath>
            <!-- <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath> -->
        </field>
    </record>

    <!-- Team Menu in Project Configuration -->
    <menuitem id="menu_project_team_config"
              name="Teams"
              parent="project.menu_project_config"
              sequence="15"/>

    <!-- Action Window to Open Teams -->
    <record id="action_project_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">project.team</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Attach Action to Menu -->
    <menuitem id="menu_action_project_team"
              parent="menu_project_team_config"
              action="action_project_team"/>
</odoo>
