<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         FORM VIEW
    ================================================================ -->
    <record id="view_kgrn_recurring_contract_form" model="ir.ui.view">
        <field name="name">kgrn.recurring.contract.form</field>
        <field name="model">kgrn.recurring.contract</field>
        <field name="arch" type="xml">
            <form string="Recurring Payment Contract">
                <header>
                    <!-- Action buttons -->
                    <button name="action_send_portal_link"
                            string="Send Portal Link"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('draft',)"
                            help="Send the secure card registration link to the customer."/>

                    <button name="action_activate"
                            string="Activate Contract"
                            type="object"
                            class="btn-success"
                            invisible="state != 'draft' or not stripe_payment_method_id"
                            help="Activate this contract. Customer must have added a card first."/>

                    <button name="action_remove_card"
                            string="Remove Card"
                            type="object"
                            class="btn-warning"
                            invisible="not stripe_payment_method_id"
                            groups="kgrn_recurring_payment.group_kgrn_recurring_manager"
                            help="Detach the customer's payment card from Stripe."/>

                    <button name="action_manual_deduct"
                            string="Manual Deduction"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'running'"
                            confirm="This will immediately charge the customer's card for the current period. Continue?"
                            help="Manually trigger payment deduction for the current billing period."/>

                    <button name="action_mark_expired"
                            string="Mark as Expired"
                            type="object"
                            invisible="state != 'running'"
                            groups="kgrn_recurring_payment.group_kgrn_recurring_manager"/>

                    <button name="action_deduct_advance"
                            string="Deduct Advance"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'running' or advance_amount &lt;= 0 or kgrn_advance_paid"
                            confirm="This will immediately charge the advance amount from the customer's card. Continue?"
                            help="Collect the one-time advance payment from the customer's registered card."/>

                    <button name="action_cancel"
                            string="Cancel Contract"
                            type="object"
                            class="btn-danger"
                            invisible="state in ('expired', 'cancelled')"
                            groups="kgrn_recurring_payment.group_kgrn_recurring_manager"
                            confirm="Are you sure you want to cancel this contract? This action cannot be undone."/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,expired,cancelled"/>
                </header>

                <!-- Card removal alert banner -->
                <div class="alert alert-warning o_form_no_constraints mb-0"
                     invisible="not card_removal_requested" role="alert">
                    <strong>&#9888; Card Removal Requested</strong> — Customer
                    <field name="customer_id" readonly="1" nolabel="1" class="d-inline"/> has requested
                    card removal on
                    <field name="card_removal_request_date" readonly="1" nolabel="1" class="d-inline" widget="datetime"/>.
                    <em><field name="card_removal_reason" readonly="1" nolabel="1" class="d-inline"/></em>
                    — Please review and use <strong>Remove Card</strong> button above to action.
                </div>

                <!-- Portal link sent info bar — hidden once card is registered -->
                <div class="alert alert-info o_form_no_constraints mb-0"
                     invisible="not portal_link_sent or card_removal_requested or stripe_payment_method_id"
                     role="alert">
                    &#10003; Portal link was sent on
                    <field name="portal_link_sent_date" readonly="1" nolabel="1" class="d-inline" widget="datetime"/>.
                    Waiting for customer to register their card.
                </div>

                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-credit-card">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Contract Details">
                            <field name="customer_id" readonly="state != 'draft'"/>
                            <field name="customer_email" readonly="1"/>
                            <field name="customer_phone" readonly="1"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sale_order_id" readonly="1" invisible="not sale_order_id"/>
                        </group>
                        <group string="Billing Configuration">
                            <field name="stripe_provider_id"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="frequency" readonly="state != 'draft'"/>
                            <field name="journal_id"/>
                            <field name="tax_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <group>
                        <group string="Schedule">
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date" readonly="state != 'draft'"/>
                            <field name="next_payment_date" readonly="1"/>
                            <field name="next_auto_debit" readonly="1"
                                   string="Next Auto-Debit (09:45 UAE)"
                                   widget="datetime"
                                   help="The cron runs at 08:10 AM UAE time (04:10 UTC) daily. Your profile timezone determines how this is displayed."/>
                        </group>
                        <group string="Portal Access">
                            <field name="portal_url" readonly="1" widget="url"/>
                            <field name="portal_link_sent" readonly="1"/>
                            <field name="portal_link_sent_date" readonly="1"/>
                        </group>
                    </group>

                    <group invisible="advance_amount &lt;= 0 and not kgrn_advance_paid">
                        <group string="Advance Payment">
                            <field name="advance_amount"/>
                            <field name="kgrn_advance_paid" readonly="1" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- ── Tab 1: Card Information ── -->
                        <page string="Payment Card" name="card_info">
                            <group invisible="not stripe_payment_method_id">
                                <group string="Registered Card">
                                    <field name="card_holder_name" readonly="1"/>
                                    <field name="card_brand" readonly="1"/>
                                    <field name="card_last4" readonly="1"/>
                                    <field name="card_exp_month" readonly="1"/>
                                    <field name="card_exp_year" readonly="1"/>
                                    <field name="card_added_date" readonly="1"/>
                                </group>
                                <group string="Stripe References">
                                    <field name="stripe_customer_id" readonly="1"/>
                                    <field name="stripe_payment_method_id" readonly="1"/>
                                </group>
                            </group>
                            <div class="alert alert-secondary text-center"
                                 invisible="stripe_payment_method_id" role="status">
                                <p class="mb-0">
                                    <i class="fa fa-credit-card fa-2x text-muted mb-2 d-block"/>
                                    No payment card registered yet.<br/>
                                    <strong>Send the portal link</strong> to the customer so they
                                    can securely add their card.
                                </p>
                            </div>

                            <!-- Card removal request section -->
                            <group string="Card Removal Request"
                                   invisible="not card_removal_requested">
                                <field name="card_removal_requested" readonly="1"/>
                                <field name="card_removal_request_date" readonly="1"/>
                                <field name="card_removal_reason" readonly="1"/>
                            </group>
                        </page>

                        <!-- ── Tab 2: Payment History ── -->
                        <page string="Payment History" name="payment_history">
                            <field name="payment_line_ids" readonly="1">
                                <list string="Payment Lines" decoration-success="state == 'success'"
                                      decoration-danger="state == 'failed'"
                                      decoration-warning="state == 'pending'">
                                    <field name="name"/>
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="payment_date"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'success'"
                                           decoration-danger="state == 'failed'"
                                           decoration-warning="state == 'pending'"
                                           decoration-info="state == 'refunded'"/>
                                    <field name="stripe_payment_intent_id"/>
                                    <field name="account_payment_id"/>
                                    <field name="failure_reason" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <!-- ── Tab 3: Notes ── -->
                        <page string="Internal Notes" name="notes">
                            <field name="notes" placeholder="Add internal notes about this contract…"/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================
         LIST VIEW
    ================================================================ -->
    <record id="view_kgrn_recurring_contract_list" model="ir.ui.view">
        <field name="name">kgrn.recurring.contract.list</field>
        <field name="model">kgrn.recurring.contract</field>
        <field name="arch" type="xml">
            <list string="Recurring Contracts"
                  decoration-success="state == 'running'"
                  decoration-muted="state in ('expired', 'cancelled')"
                  decoration-warning="card_removal_requested">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="frequency"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="next_payment_date"/>
                <field name="card_last4"/>
                <field name="user_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'running'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state in ('expired', 'cancelled')"/>
                <field name="card_removal_requested" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         SEARCH VIEW
    ================================================================ -->
    <record id="view_kgrn_recurring_contract_search" model="ir.ui.view">
        <field name="name">kgrn.recurring.contract.search</field>
        <field name="model">kgrn.recurring.contract</field>
        <field name="arch" type="xml">
            <search string="Search Recurring Contracts">
                <field name="name" string="Contract Ref"/>
                <field name="customer_id"/>
                <field name="user_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Running" name="running" domain="[('state','=','running')]"/>
                <filter string="Expired" name="expired" domain="[('state','=','expired')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Card Removal Requested" name="removal_requested"
                        domain="[('card_removal_requested','=',True)]"/>
                <filter string="No Card Yet" name="no_card"
                        domain="[('stripe_payment_method_id','=',False)]"/>
                <separator/>
                <filter string="My Contracts" name="my_contracts"
                        domain="[('user_id','=',uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Frequency" name="group_frequency" context="{'group_by': 'frequency'}"/>
                    <filter string="Responsible" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Main action -->
    <record id="action_kgrn_recurring_contract" model="ir.actions.act_window">
        <field name="name">Recurring Contracts</field>
        <field name="res_model">kgrn.recurring.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_running': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first recurring payment contract
            </p>
            <p>
                Manage subscription-based billing with automated Stripe card charging.
            </p>
        </field>
    </record>

    <!-- Card removal alert action (for menu) -->
    <record id="action_kgrn_recurring_removal_requests" model="ir.actions.act_window">
        <field name="name">Card Removal Requests</field>
        <field name="res_model">kgrn.recurring.contract</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('card_removal_requested', '=', True)]</field>
        <field name="context">{}</field>
    </record>

    <!-- User Manual action -->
    <record id="action_kgrn_user_manual" model="ir.actions.act_window">
        <field name="name">User Manual</field>
        <field name="res_model">kgrn.user.manual.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
