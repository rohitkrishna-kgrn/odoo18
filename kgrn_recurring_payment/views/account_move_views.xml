<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inject "Apply Existing Payment" button into customer invoice form header -->
    <record id="view_account_move_form_kgrn_payment" model="ir.ui.view">
        <field name="name">account.move.form.kgrn.apply.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_register_payment']" position="after">
                <button name="action_apply_existing_payment"
                        string="Apply Existing Payment"
                        type="object"
                        class="btn-secondary"
                        invisible="move_type not in ('out_invoice', 'out_refund') or payment_state == 'paid' or state != 'posted'"
                        help="Reconcile an already-collected payment against this invoice without creating a new one."/>
            </xpath>
        </field>
    </record>

</odoo>
