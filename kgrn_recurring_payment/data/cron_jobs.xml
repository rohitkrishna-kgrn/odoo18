<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="0" so times are re-applied every time the module is upgraded -->
    <data noupdate="0">

        <!--
            UAE Standard Time = UTC+4 (no DST)
            10:00 AM UAE = 06:00 UTC  → payment processing
            9:40 AM UAE  = 05:40 UTC  → auto-activate contracts
            9:30 AM UAE  = 05:30 UTC  → expire contracts

            nextcall formula: schedule for TODAY at the target UTC hour/minute if
            that time is still in the future; otherwise schedule for TOMORROW.
            This means upgrading at any time of day sets the next run correctly.
        -->

        <!-- Expire contracts past their end date (05:30 UTC = 09:30 UAE) -->
        <record id="cron_expire_contracts" model="ir.cron">
            <field name="name">KGRN: Expire Completed Contracts</field>
            <field name="model_id" ref="model_kgrn_recurring_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_contracts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(lambda n, t: t if t > n else t + timedelta(days=1))(datetime.now(), datetime.now().replace(hour=5, minute=30, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- Auto-activate contracts whose start_date has arrived (05:40 UTC = 09:40 UAE) -->
        <record id="cron_activate_scheduled_contracts" model="ir.cron">
            <field name="name">KGRN: Auto-Activate Scheduled Contracts</field>
            <field name="model_id" ref="model_kgrn_recurring_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_activate_scheduled_contracts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(lambda n, t: t if t > n else t + timedelta(days=1))(datetime.now(), datetime.now().replace(hour=5, minute=40, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- Process due recurring payments (06:00 UTC = 10:00 UAE) -->
        <record id="cron_process_recurring_payments" model="ir.cron">
            <field name="name">KGRN: Process Due Recurring Payments</field>
            <field name="model_id" ref="model_kgrn_recurring_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_recurring_payments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(lambda n, t: t if t > n else t + timedelta(days=1))(datetime.now(), datetime.now().replace(hour=6, minute=0, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>
