<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Process due recurring payments (daily at 08:00) -->
        <record id="cron_process_recurring_payments" model="ir.cron">
            <field name="name">KGRN: Process Due Recurring Payments</field>
            <field name="model_id" ref="model_kgrn_recurring_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_recurring_payments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=8, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- Auto-activate contracts whose start_date has arrived (daily at 07:30) -->
        <record id="cron_activate_scheduled_contracts" model="ir.cron">
            <field name="name">KGRN: Auto-Activate Scheduled Contracts</field>
            <field name="model_id" ref="model_kgrn_recurring_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_activate_scheduled_contracts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=7, minute=30, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- Expire contracts past their end date (daily at 07:00) -->
        <record id="cron_expire_contracts" model="ir.cron">
            <field name="name">KGRN: Expire Completed Contracts</field>
            <field name="model_id" ref="model_kgrn_recurring_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_contracts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=7, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>
