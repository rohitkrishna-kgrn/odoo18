<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="0" so times are re-applied every time the module is upgraded -->
    <data noupdate="0">

        <!--
            UAE Standard Time = UTC+4 (no DST)
            8:10 AM UAE  = 04:10 UTC  → payment processing
            7:50 AM UAE  = 03:50 UTC  → auto-activate contracts
            7:40 AM UAE  = 03:40 UTC  → expire contracts
        -->

        <!-- Expire contracts past their end date (03:40 UTC = 07:40 UAE) -->
        <record id="cron_expire_contracts" model="ir.cron">
            <field name="name">KGRN: Expire Completed Contracts</field>
            <field name="model_id" ref="model_kgrn_recurring_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_contracts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=3, minute=40, second=0, microsecond=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- Auto-activate contracts whose start_date has arrived (03:50 UTC = 07:50 UAE) -->
        <record id="cron_activate_scheduled_contracts" model="ir.cron">
            <field name="name">KGRN: Auto-Activate Scheduled Contracts</field>
            <field name="model_id" ref="model_kgrn_recurring_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_activate_scheduled_contracts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=3, minute=50, second=0, microsecond=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- Process due recurring payments (04:10 UTC = 08:10 UAE) -->
        <record id="cron_process_recurring_payments" model="ir.cron">
            <field name="name">KGRN: Process Due Recurring Payments</field>
            <field name="model_id" ref="model_kgrn_recurring_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_recurring_payments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=4, minute=10, second=0, microsecond=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>
