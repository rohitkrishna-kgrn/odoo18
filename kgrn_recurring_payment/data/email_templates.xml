<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================================
             PAYMENT RECEIPT  (to customer)
        ================================================================ -->
        <record id="email_template_payment_receipt" model="mail.template">
            <field name="name">KGRN Recurring: Payment Receipt</field>
            <field name="model_id" ref="model_kgrn_recurring_payment_line"/>
            <field name="subject">Payment Receipt – {{ object.contract_id.name }} – {{ object.name }}</field>
            <field name="email_to">{{ object.contract_id.customer_email }}</field>
            <field name="email_from">{{ (object.contract_id.company_id.email or user.email) }}</field>
            <field name="body_html"><![CDATA[
<table width="100%" border="0" cellpadding="0" cellspacing="0" style="background-color:#f0f2f5;margin:0;padding:0;">
  <tr>
    <td align="center" style="padding:24px 12px;">

      <!--[if mso]><table border="0" cellpadding="0" cellspacing="0" width="580"><tr><td><![endif]-->
      <table border="0" cellpadding="0" cellspacing="0" width="580" style="max-width:580px;width:100%;">

        <!-- HEADER -->
        <tr>
          <td bgcolor="#0d2b45" align="left" style="background-color:#0d2b45;padding:28px 36px;">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td>
                  <h1 style="color:#ffffff;margin:0 0 4px 0;font-size:20px;font-weight:bold;font-family:Arial,Helvetica,sans-serif;line-height:130%;">
                    KGRN Chartered Accountants LLC
                  </h1>
                  <p style="color:#a8c4d8;margin:0;font-size:12px;font-family:Arial,Helvetica,sans-serif;">
                    PAYMENT RECEIPT
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- BODY -->
        <tr>
          <td bgcolor="#ffffff" align="left" style="background-color:#ffffff;padding:32px 36px;border-left:1px solid #e5e7eb;border-right:1px solid #e5e7eb;">

            <p style="margin:0 0 16px 0;font-size:15px;color:#1f2937;font-family:Arial,Helvetica,sans-serif;">
              Dear <strong>{{ object.contract_id.customer_id.name }}</strong>,
            </p>
            <p style="color:#4b5563;line-height:160%;margin:0 0 24px 0;font-size:14px;font-family:Arial,Helvetica,sans-serif;">
              A payment of
              <strong>{{ object.currency_id.symbol or object.currency_id.name }} {{ '%.2f'|format(object.amount) }}</strong>
              has been successfully processed for your recurring payment contract.
            </p>

            <!-- Details table -->
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin:0 0 24px 0;">
              <tr>
                <td width="200" bgcolor="#f3f4f6" style="background-color:#f3f4f6;padding:10px 14px;font-weight:bold;color:#374151;font-size:13px;font-family:Arial,Helvetica,sans-serif;border:1px solid #e5e7eb;">
                  Contract Reference
                </td>
                <td bgcolor="#f3f4f6" style="background-color:#f3f4f6;padding:10px 14px;color:#1f2937;font-size:13px;font-family:Arial,Helvetica,sans-serif;border-top:1px solid #e5e7eb;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  {{ object.contract_id.name }}
                </td>
              </tr>
              <tr>
                <td width="200" bgcolor="#ffffff" style="background-color:#ffffff;padding:10px 14px;font-weight:bold;color:#374151;font-size:13px;font-family:Arial,Helvetica,sans-serif;border-left:1px solid #e5e7eb;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  Billing Period
                </td>
                <td bgcolor="#ffffff" style="background-color:#ffffff;padding:10px 14px;color:#1f2937;font-size:13px;font-family:Arial,Helvetica,sans-serif;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  {{ object.name }}
                </td>
              </tr>
              <tr>
                <td width="200" bgcolor="#f3f4f6" style="background-color:#f3f4f6;padding:10px 14px;font-weight:bold;color:#374151;font-size:13px;font-family:Arial,Helvetica,sans-serif;border-left:1px solid #e5e7eb;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  Payment Date
                </td>
                <td bgcolor="#f3f4f6" style="background-color:#f3f4f6;padding:10px 14px;color:#1f2937;font-size:13px;font-family:Arial,Helvetica,sans-serif;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  {{ object.payment_date.strftime('%d %b %Y') }}
                </td>
              </tr>
              <tr>
                <td width="200" bgcolor="#ffffff" style="background-color:#ffffff;padding:10px 14px;font-weight:bold;color:#374151;font-size:13px;font-family:Arial,Helvetica,sans-serif;border-left:1px solid #e5e7eb;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  Amount Charged
                </td>
                <td bgcolor="#ffffff" style="background-color:#ffffff;padding:10px 14px;color:#1f2937;font-size:14px;font-weight:bold;font-family:Arial,Helvetica,sans-serif;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  {{ object.currency_id.symbol or object.currency_id.name }} {{ '%.2f'|format(object.amount) }}
                </td>
              </tr>
              {% if object.stripe_payment_intent_id %}
              <tr>
                <td width="200" bgcolor="#f3f4f6" style="background-color:#f3f4f6;padding:10px 14px;font-weight:bold;color:#374151;font-size:13px;font-family:Arial,Helvetica,sans-serif;border-left:1px solid #e5e7eb;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  Transaction ID
                </td>
                <td bgcolor="#f3f4f6" style="background-color:#f3f4f6;padding:10px 14px;color:#6b7280;font-size:11px;font-family:'Courier New',Courier,monospace;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  {{ object.stripe_payment_intent_id }}
                </td>
              </tr>
              {% endif %}
            </table>

            <p style="font-size:13px;color:#6b7280;margin:0;font-family:Arial,Helvetica,sans-serif;">
              If you have any questions regarding this payment, please contact your KGRN account manager.
            </p>
          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td bgcolor="#f9fafb" align="center" style="background-color:#f9fafb;padding:16px 36px;border:1px solid #e5e7eb;border-top:none;">
            <p style="font-size:11px;color:#9ca3af;margin:0;font-family:Arial,Helvetica,sans-serif;">
              &#169; KGRN Chartered Accountants LLC. This is an automated receipt. Please do not reply to this email.
            </p>
          </td>
        </tr>

      </table>
      <!--[if mso]></td></tr></table><![endif]-->

    </td>
  </tr>
</table>
]]></field>
        </record>

        <!-- ================================================================
             PAYMENT FAILED  (internal – to responsible user)
        ================================================================ -->
        <record id="email_template_payment_failed" model="mail.template">
            <field name="name">KGRN Recurring: Payment Failed (Internal)</field>
            <field name="model_id" ref="model_kgrn_recurring_contract"/>
            <field name="subject">&#9888; URGENT: Recurring Payment Failed – {{ object.name }}</field>
            <field name="email_to">{{ object.user_id.email }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="body_html"><![CDATA[
<table width="100%" border="0" cellpadding="0" cellspacing="0" style="background-color:#fef2f2;margin:0;padding:0;">
  <tr>
    <td align="center" style="padding:24px 12px;">

      <!--[if mso]><table border="0" cellpadding="0" cellspacing="0" width="560"><tr><td><![endif]-->
      <table border="0" cellpadding="0" cellspacing="0" width="560" style="max-width:560px;width:100%;">

        <!-- RED HEADER -->
        <tr>
          <td bgcolor="#dc2626" align="left" style="background-color:#dc2626;padding:22px 32px;">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td>
                  <p style="color:#ffffff;margin:0 0 4px 0;font-size:11px;font-weight:bold;font-family:Arial,Helvetica,sans-serif;">
                    KGRN RECURRING PAYMENTS
                  </p>
                  <h1 style="color:#ffffff;margin:0;font-size:18px;font-weight:bold;font-family:Arial,Helvetica,sans-serif;line-height:130%;">
                    Payment Failed - Immediate Attention Required
                  </h1>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- BODY -->
        <tr>
          <td bgcolor="#ffffff" align="left" style="background-color:#ffffff;padding:28px 32px;border-left:1px solid #fecaca;border-right:1px solid #fecaca;">

            <p style="margin:0 0 16px 0;font-size:14px;color:#1f2937;font-family:Arial,Helvetica,sans-serif;">
              Hello <strong>{{ object.user_id.name }}</strong>,
            </p>
            <p style="color:#374151;line-height:160%;margin:0 0 20px 0;font-size:14px;font-family:Arial,Helvetica,sans-serif;">
              A recurring payment could not be processed. Please review the contract and take appropriate action.
            </p>

            <!-- Alert box -->
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 20px 0;">
              <tr>
                <td bgcolor="#fef2f2" style="background-color:#fef2f2;border:2px solid #fecaca;padding:14px 16px;">
                  <p style="margin:0;font-size:13px;font-weight:bold;color:#dc2626;font-family:Arial,Helvetica,sans-serif;">
                    PAYMENT DECLINED
                  </p>
                </td>
              </tr>
            </table>

            <!-- Contract details -->
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin:0 0 20px 0;">
              <tr>
                <td width="160" bgcolor="#f9fafb" style="background-color:#f9fafb;padding:10px 14px;font-weight:bold;color:#374151;font-size:13px;font-family:Arial,Helvetica,sans-serif;border:1px solid #e5e7eb;">
                  Contract
                </td>
                <td bgcolor="#f9fafb" style="background-color:#f9fafb;padding:10px 14px;color:#1f2937;font-size:13px;font-family:Arial,Helvetica,sans-serif;border-top:1px solid #e5e7eb;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  {{ object.name }}
                </td>
              </tr>
              <tr>
                <td width="160" bgcolor="#ffffff" style="background-color:#ffffff;padding:10px 14px;font-weight:bold;color:#374151;font-size:13px;font-family:Arial,Helvetica,sans-serif;border-left:1px solid #e5e7eb;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  Customer
                </td>
                <td bgcolor="#ffffff" style="background-color:#ffffff;padding:10px 14px;color:#1f2937;font-size:13px;font-family:Arial,Helvetica,sans-serif;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  {{ object.customer_id.name }}
                </td>
              </tr>
              <tr>
                <td width="160" bgcolor="#f9fafb" style="background-color:#f9fafb;padding:10px 14px;font-weight:bold;color:#374151;font-size:13px;font-family:Arial,Helvetica,sans-serif;border-left:1px solid #e5e7eb;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  Amount
                </td>
                <td bgcolor="#f9fafb" style="background-color:#f9fafb;padding:10px 14px;color:#1f2937;font-size:13px;font-weight:bold;font-family:Arial,Helvetica,sans-serif;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  {{ object.currency_id.symbol or object.currency_id.name }} {{ '%.2f'|format(object.amount) }}
                </td>
              </tr>
              <tr>
                <td width="160" bgcolor="#ffffff" style="background-color:#ffffff;padding:10px 14px;font-weight:bold;color:#374151;font-size:13px;font-family:Arial,Helvetica,sans-serif;border-left:1px solid #e5e7eb;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  Frequency
                </td>
                <td bgcolor="#ffffff" style="background-color:#ffffff;padding:10px 14px;color:#1f2937;font-size:13px;font-family:Arial,Helvetica,sans-serif;border-right:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
                  {{ object.frequency }}
                </td>
              </tr>
            </table>

            <p style="font-size:13px;color:#dc2626;font-weight:bold;margin:0 0 8px 0;font-family:Arial,Helvetica,sans-serif;">
              Recommended Actions:
            </p>
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
              <tr>
                <td style="padding:4px 0;font-size:13px;color:#374151;font-family:Arial,Helvetica,sans-serif;">
                  &#8226; Check the Payment History tab in the contract for the Stripe error message
                </td>
              </tr>
              <tr>
                <td style="padding:4px 0;font-size:13px;color:#374151;font-family:Arial,Helvetica,sans-serif;">
                  &#8226; Verify the customer's card has sufficient funds
                </td>
              </tr>
              <tr>
                <td style="padding:4px 0;font-size:13px;color:#374151;font-family:Arial,Helvetica,sans-serif;">
                  &#8226; Use Manual Deduction once the issue is resolved
                </td>
              </tr>
              <tr>
                <td style="padding:4px 0;font-size:13px;color:#374151;font-family:Arial,Helvetica,sans-serif;">
                  &#8226; Contact the customer if the card needs to be updated
                </td>
              </tr>
            </table>

          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td bgcolor="#f9fafb" align="center" style="background-color:#f9fafb;padding:14px 32px;border:1px solid #fecaca;border-top:none;">
            <p style="font-size:11px;color:#9ca3af;margin:0;font-family:Arial,Helvetica,sans-serif;">
              This is an automated internal alert from KGRN Recurring Payments. Do not forward this email.
            </p>
          </td>
        </tr>

      </table>
      <!--[if mso]></td></tr></table><![endif]-->

    </td>
  </tr>
</table>
]]></field>
        </record>

    </data>
</odoo>
