<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Payment receipt email to customer -->
        <record id="email_template_payment_receipt" model="mail.template">
            <field name="name">KGRN Recurring: Payment Receipt</field>
            <field name="model_id" ref="model_kgrn_recurring_payment_line"/>
            <field name="subject">Payment Receipt – {{ object.contract_id.name }} – {{ object.name }}</field>
            <field name="email_to">{{ object.contract_id.customer_email }}</field>
            <field name="email_from">{{ (object.contract_id.company_id.email or user.email) }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family:Segoe UI,Arial,sans-serif;max-width:580px;margin:0 auto;color:#1f2937;">
  <div style="background:linear-gradient(135deg,#0d2b45,#1a4f72);padding:28px 36px;border-radius:12px 12px 0 0;">
    <h1 style="color:#fff;margin:0;font-size:20px;font-weight:700;">KGRN Chartered Accountants LLC</h1>
    <p style="color:rgba(255,255,255,0.7);margin:4px 0 0;font-size:12px;letter-spacing:1px;text-transform:uppercase;">
      Payment Receipt
    </p>
  </div>
  <div style="background:#fff;padding:32px 36px;border:1px solid #e5e7eb;border-top:none;">
    <p style="margin:0 0 20px;font-size:15px;">Dear <strong>{{ object.contract_id.customer_id.name }}</strong>,</p>
    <p style="color:#4b5563;line-height:1.6;margin:0 0 24px;">
      A payment of <strong>{{ object.currency_id.symbol or object.currency_id.name }}{{ '%.2f'|format(object.amount) }}</strong>
      has been successfully processed for your recurring payment contract.
    </p>
    <table style="width:100%;border-collapse:collapse;font-size:14px;margin:0 0 24px;">
      <tr style="background:#f3f4f6;">
        <td style="padding:10px 14px;font-weight:600;color:#374151;">Contract Reference</td>
        <td style="padding:10px 14px;color:#1f2937;">{{ object.contract_id.name }}</td>
      </tr>
      <tr>
        <td style="padding:10px 14px;font-weight:600;color:#374151;">Billing Period</td>
        <td style="padding:10px 14px;color:#1f2937;">{{ object.name }}</td>
      </tr>
      <tr style="background:#f3f4f6;">
        <td style="padding:10px 14px;font-weight:600;color:#374151;">Payment Date</td>
        <td style="padding:10px 14px;color:#1f2937;">{{ object.payment_date.strftime('%d %b %Y') }}</td>
      </tr>
      <tr>
        <td style="padding:10px 14px;font-weight:600;color:#374151;">Amount Charged</td>
        <td style="padding:10px 14px;color:#1f2937;font-weight:700;">
          {{ object.currency_id.symbol or object.currency_id.name }}{{ '%.2f'|format(object.amount) }}
        </td>
      </tr>
      {% if object.stripe_payment_intent_id %}
      <tr style="background:#f3f4f6;">
        <td style="padding:10px 14px;font-weight:600;color:#374151;">Transaction ID</td>
        <td style="padding:10px 14px;color:#6b7280;font-size:12px;">{{ object.stripe_payment_intent_id }}</td>
      </tr>
      {% endif %}
    </table>
    <p style="font-size:13px;color:#6b7280;">
      If you have any questions regarding this payment, please contact your KGRN account manager.
    </p>
  </div>
  <div style="background:#f9fafb;padding:16px 36px;border:1px solid #e5e7eb;border-top:none;border-radius:0 0 12px 12px;text-align:center;">
    <p style="font-size:11px;color:#9ca3af;margin:0;">
      © KGRN Chartered Accountants LLC. This is an automated receipt.
    </p>
  </div>
</div>
]]></field>
        </record>

        <!-- Payment failure notification to internal responsible user -->
        <record id="email_template_payment_failed" model="mail.template">
            <field name="name">KGRN Recurring: Payment Failed (Internal)</field>
            <field name="model_id" ref="model_kgrn_recurring_contract"/>
            <field name="subject">URGENT: Recurring Payment Failed – {{ object.name }}</field>
            <field name="email_to">{{ object.user_id.email }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family:Segoe UI,Arial,sans-serif;max-width:580px;margin:0 auto;color:#1f2937;">
  <div style="background:#dc2626;padding:24px 36px;border-radius:12px 12px 0 0;">
    <h1 style="color:#fff;margin:0;font-size:18px;font-weight:700;">Payment Failed – Immediate Attention Required</h1>
  </div>
  <div style="background:#fff;padding:28px 36px;border:1px solid #e5e7eb;border-top:none;">
    <p style="margin:0 0 16px;">A recurring payment has failed for the following contract:</p>
    <table style="width:100%;border-collapse:collapse;font-size:14px;margin:0 0 20px;">
      <tr style="background:#fef2f2;">
        <td style="padding:8px 12px;font-weight:600;">Contract</td>
        <td style="padding:8px 12px;">{{ object.name }}</td>
      </tr>
      <tr>
        <td style="padding:8px 12px;font-weight:600;">Customer</td>
        <td style="padding:8px 12px;">{{ object.customer_id.name }}</td>
      </tr>
      <tr style="background:#fef2f2;">
        <td style="padding:8px 12px;font-weight:600;">Amount</td>
        <td style="padding:8px 12px;">{{ object.currency_id.symbol }}{{ '%.2f'|format(object.amount) }}</td>
      </tr>
    </table>
    <p style="color:#dc2626;font-weight:600;">Please review the contract and take appropriate action.</p>
  </div>
</div>
]]></field>
        </record>

    </data>
</odoo>
