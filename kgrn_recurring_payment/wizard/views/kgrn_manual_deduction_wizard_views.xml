<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kgrn_manual_deduction_wizard_form" model="ir.ui.view">
        <field name="name">kgrn.manual.deduction.wizard.form</field>
        <field name="model">kgrn.manual.deduction.wizard</field>
        <field name="arch" type="xml">
            <form string="Manual Payment Deduction">
                <sheet>

                    <!-- Info banner -->
                    <div class="alert alert-warning mb-3" role="alert">
                        <strong>&#9888; Manual Deduction</strong> — This will immediately charge the
                        customer's registered card via Stripe and post a payment entry in accounting.
                        Please review the details below before confirming.
                    </div>

                    <!-- Contract summary (read-only) -->
                    <group string="Contract Details">
                        <group>
                            <field name="contract_id" readonly="1"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="frequency_label" string="Frequency" readonly="1"/>
                        </group>
                        <group>
                            <field name="card_info" string="Card" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <!-- Period being charged -->
                    <group string="Billing Period to be Charged Now">
                        <group>
                            <field name="period_start" readonly="1"/>
                            <field name="period_end"   readonly="1"/>
                        </group>
                        <group>
                            <field name="period_label" string="Period Label" readonly="1"/>
                            <field name="next_payment_after" readonly="1"
                                   help="The next scheduled payment date after this deduction."/>
                        </group>
                    </group>

                    <!-- Journal (editable) -->
                    <group string="Accounting">
                        <field name="journal_id"
                               help="Journal to post the payment entry. Defaults to the contract's journal."/>
                    </group>

                    <!-- Future schedule info -->
                    <div class="alert alert-info mb-0" role="alert" style="font-size:0.88rem;">
                        After this deduction, the next scheduled payment will be on
                        <strong><field name="next_payment_after" readonly="1" nolabel="1"
                                       class="d-inline"/></strong>.
                        All subsequent payments will continue on the
                        <strong><field name="frequency_label" readonly="1" nolabel="1"
                                       class="d-inline"/></strong> schedule.
                    </div>

                </sheet>
                <footer>
                    <button name="action_confirm_deduction"
                            string="Confirm &amp; Deduct Now"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
