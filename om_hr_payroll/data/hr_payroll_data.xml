<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">

        <record id="hr_rule_basic" model="hr.salary.rule">
            <field name="name">Basic Salary</field>
            <field name="sequence" eval="1"/>
            <field name="code">BASIC</field>
            <field name="category_id" ref="om_hr_payroll.BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.wage * 0.60</field>
        </record>

        <record id="hr_rule_taxable" model="hr.salary.rule">
            <field name="name">Gross</field>
            <field name="sequence" eval="100"/>
            <field name="code">GROSS</field>
            <field name="category_id" ref="om_hr_payroll.GROSS"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = categories.BASIC + categories.ALW</field>
        </record>

        <record id="hr_rule_other_allowance" model="hr.salary.rule">
            <field name="name">Other Allowance</field>
            <field name="sequence" eval="100"/>
            <field name="code">ALLOWANCE</field>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.wage * 0.40</field>
        </record>

        <record id="hr_rule_deduction" model="hr.salary.rule">
            <field name="name">Deduction</field>
            <field name="sequence" eval="100"/>
            <field name="code">DEDUCTION</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = 0.00</field>
        </record>

        <record id="hr_rule_lossofpay" model="hr.salary.rule">
            <field name="name">Loss of Pay</field>
            <field name="sequence" eval="100"/>
            <field name="code">LOP</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">total_days = worked_days.WORK100.number_of_days if worked_days.WORK100 else 0.0; worked_days_count = worked_days.PRESENT.number_of_days if worked_days.PRESENT else 0.0; paid_leaves = worked_days.LEAVE.number_of_days if worked_days.LEAVE else 0.0; sundays = worked_days.SUNDAY.number_of_days if worked_days.SUNDAY else 0.0; public_holidays = worked_days.PH.number_of_days if worked_days.PH else 0.0; lop_days = total_days - (worked_days_count + paid_leaves + sundays + public_holidays); result = -(contract.wage / total_days) * lop_days if total_days else 0.0</field>
        </record>

        <record id="hr_rule_late_login_deduction" model="hr.salary.rule">
            <field name="name">Late Login Deduction</field>
            <field name="sequence" eval="101"/>
            <field name="code">LATE_LOGIN_DED</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">total_days = worked_days.WORK100.number_of_days if worked_days.WORK100 else 0.0; late_days = worked_days.LATE_DEDUCT.number_of_days if worked_days.LATE_DEDUCT else 0.0; result = -(contract.wage / total_days) * late_days if total_days else 0.0</field>
        </record>

<!--        <record id="hr_rule_unpaid" model="hr.salary.rule">-->
<!--            <field name="name">Unpaid Leave</field>-->
<!--            <field name="sequence" eval="100"/>-->
<!--            <field name="code">UNP</field>-->
