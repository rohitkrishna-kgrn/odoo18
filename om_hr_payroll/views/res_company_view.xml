<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_inherit_secondary_logo" model="ir.ui.view">
        <field name="name">res.company.form.secondary.logo</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='color']" position="after">
                <group string="Additional Images">
                    <field name="secondary_logo" filename="secondary_logo_filename" widget="image"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
