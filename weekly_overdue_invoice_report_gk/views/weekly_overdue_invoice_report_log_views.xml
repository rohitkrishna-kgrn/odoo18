<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_weekly_overdue_invoice_report_log_list" model="ir.ui.view">
        <field name="name">weekly.overdue.invoice.report.log.list</field>
        <field name="model">weekly.overdue.invoice.report.log</field>
        <field name="arch" type="xml">
            <list string="Weekly Overdue Invoice Reports" default_order="generated_date desc">
                <field name="name"/>
                <field name="generated_date"/>
                <field name="invoice_count"/>
                <field name="missing_reason_count"/>
                <field name="total_amount_due" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="email_sent"/>
            </list>
        </field>
    </record>

    <record id="view_weekly_overdue_invoice_report_log_form" model="ir.ui.view">
        <field name="name">weekly.overdue.invoice.report.log.form</field>
        <field name="model">weekly.overdue.invoice.report.log</field>
        <field name="arch" type="xml">
            <form string="Weekly Overdue Invoice Report">
                <sheet>
                    <group>
                        <group>
                            <field name="generated_date"/>
                            <field name="invoice_count"/>
                            <field name="missing_reason_count"/>
                        </group>
                        <group>
                            <field name="total_amount_due"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="email_sent"/>
                            <field name="recipient_ids" widget="many2many_tags"/>
                            <field name="pm_report_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="report_file" filename="report_filename" readonly="1"/>
                        <field name="report_filename" invisible="1"/>
                        <field name="report_pdf" filename="report_pdf_filename" readonly="1"/>
                        <field name="report_pdf_filename" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Invoices">
                            <field name="line_ids" readonly="1">
                                <list decoration-danger="not why_not_collected">
                                    <field name="invoice_number"/>
                                    <field name="partner_name"/>
                                    <field name="team_name"/>
                                    <field name="pm_name"/>
                                    <field name="ar_responsible_name"/>
                                    <field name="days_overdue"/>
                                    <field name="amount_due" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="last_followup_date"/>
                                    <field name="why_not_collected"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_weekly_overdue_invoice_report_log" model="ir.actions.act_window">
        <field name="name">Weekly Overdue Invoice Reports</field>
        <field name="res_model">weekly.overdue.invoice.report.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Reporting, not Customers: this is the archive of generated reports,
         read after the fact, not a worklist anyone acts on from the Customers
         menu. Sequence 45 puts it after core's Management group. -->
    <menuitem id="menu_weekly_overdue_invoice_report_log"
              name="Weekly Overdue Invoice Reports"
              parent="account.menu_finance_reports"
              action="action_weekly_overdue_invoice_report_log"
              sequence="45"/>
</odoo>
