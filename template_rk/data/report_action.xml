<odoo>

  <!--
    Point the standard customer-invoice PDF actions at the KGRN UAE tax-invoice
    layout. Two core actions matter:

      * account.account_invoices               -> used by "Send & Print" and by
                                                  every programmatic render
                                                  (e.g. eInvoicing attachment)
      * account.account_invoices_without_payment -> the entry in the Print menu

    Both must keep is_invoice_report = True, otherwise
    account.move.send._check_invoice_report() blocks sending with
    "The sending of invoices is not set up properly".
  -->

  <record id="account.account_invoices" model="ir.actions.report">
      <field name="name">Invoice</field>
      <field name="model">account.move</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">template_rk.report_invoice_template_rk</field>
      <field name="report_file">template_rk.report_invoice_template_rk</field>
      <field name="is_invoice_report" eval="True"/>
      <field name="print_report_name">(object._get_report_base_filename())</field>
      <!-- keep this one off the Print menu (core default) so it is not duplicated -->
      <field name="binding_model_id" eval="False"/>
  </record>

  <record id="account.account_invoices_without_payment" model="ir.actions.report">
      <field name="name">Invoice</field>
      <field name="model">account.move</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">template_rk.report_invoice_template_rk</field>
      <field name="report_file">template_rk.report_invoice_template_rk</field>
      <field name="is_invoice_report" eval="True"/>
      <field name="print_report_name">(object._get_report_base_filename())</field>
      <field name="binding_model_id" ref="account.model_account_move"/>
      <field name="binding_type">report</field>
      <field name="domain" eval="[('move_type', '!=', 'entry')]"/>
  </record>

</odoo>
