<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="helpdesk_rk.TicketChat">
        <div class="o_helpdesk_ticket_chat">
            <div class="o_helpdesk_chat_header" t-if="state.otherParty and state.otherParty.user_id">
                <div class="o_helpdesk_chat_header_avatar">
                    <img t-att-src="otherPartyAvatarUrl" alt="Avatar"/>
                    <span t-attf-class="o_helpdesk_chat_presence_dot {{ isOtherPartyPresent ? 'o_present' : 'o_absent' }}"
                          t-att-title="presenceLabel"/>
                </div>
                <div class="o_helpdesk_chat_header_info">
                    <div class="o_helpdesk_chat_header_name" t-esc="state.otherParty.name"/>
                    <div class="o_helpdesk_chat_header_sub">
                        <span t-esc="state.otherParty.role"/>
                        <span class="o_helpdesk_chat_header_dot">&#8226;</span>
                        <span t-attf-class="o_helpdesk_chat_presence_label {{ isOtherPartyPresent ? 'o_present' : 'o_absent' }}"
                              t-esc="presenceLabel"/>
                    </div>
                </div>
                <button type="button" class="btn o_helpdesk_chat_call_btn"
                        t-on-click="onCallClick" t-att-disabled="state.calling"
                        title="Start a call">
                    <i class="fa fa-phone"/>
                </button>
            </div>
            <div class="o_helpdesk_chat_header o_helpdesk_chat_header_unassigned"
                 t-elif="state.otherParty and !state.otherParty.user_id and !state.isUnsaved">
                <div class="o_helpdesk_chat_header_info">
                    <div class="o_helpdesk_chat_header_name text-muted">Not yet assigned</div>
                </div>
            </div>
            <div class="o_helpdesk_chat_messages" t-ref="messages">
                <t t-if="state.loading">
                    <div class="text-muted p-3">Loading conversation...</div>
                </t>
                <t t-elif="!state.messages.length">
                    <div class="text-muted p-3">No messages yet. Start the conversation below.</div>
                </t>
                <t t-foreach="state.messages" t-as="message" t-key="message.id">
                    <div t-attf-class="o_helpdesk_chat_bubble_row {{ message.is_own ? 'o_own' : 'o_other' }}">
                        <div class="o_helpdesk_chat_bubble">
                            <div class="o_helpdesk_chat_meta">
                                <span class="o_helpdesk_chat_author" t-esc="message.author_name"/>
                                <span class="o_helpdesk_chat_role" t-esc="message.author_role"/>
                            </div>
                            <div class="o_helpdesk_chat_body" t-esc="message.body"/>
                            <div class="o_helpdesk_chat_attachments" t-if="message.attachments.length">
                                <a t-foreach="message.attachments" t-as="attachment" t-key="attachment.id"
                                   t-att-href="attachment.url" target="_blank" class="o_helpdesk_chat_attachment">
                                    <i class="fa fa-paperclip"/><t t-esc="attachment.name"/>
                                </a>
                            </div>
                            <div class="o_helpdesk_chat_date" t-esc="message.date"/>
                        </div>
                    </div>
                </t>
            </div>

            <div class="o_helpdesk_chat_readonly_banner" t-if="state.isUnsaved">
                Save the ticket to start the conversation.
            </div>
            <div class="o_helpdesk_chat_closed_banner" t-elif="state.isClosed">
                This ticket has been closed. Conversation is now read-only.
            </div>
            <div class="o_helpdesk_chat_readonly_banner" t-elif="!state.canPost">
                You can view this conversation. Only the ticket creator and the Helpdesk Support Team can send messages.
            </div>
            <div class="o_helpdesk_chat_composer" t-else="">
                <div class="o_helpdesk_chat_pending_attachments" t-if="state.pendingAttachments.length">
                    <span t-foreach="state.pendingAttachments" t-as="attachment" t-key="attachment.id"
                          class="o_helpdesk_chat_pending_chip">
                        <i class="fa fa-paperclip"/><t t-esc="attachment.name"/>
                        <i class="fa fa-times o_helpdesk_chat_remove_pending"
                           t-on-click="() => this.removePendingAttachment(attachment.id)"/>
                    </span>
                </div>
                <div class="o_helpdesk_chat_composer_row">
                    <button class="btn btn-link o_helpdesk_chat_attach_btn" type="button"
                            t-on-click="onFileButtonClick" t-att-disabled="state.sending">
                        <i class="fa fa-paperclip"/>
                    </button>
                    <input type="file" t-ref="fileInput" class="d-none" t-on-change="onFileChange" multiple="multiple"/>
                    <textarea class="o_helpdesk_chat_input" placeholder="Type a message..."
                              t-model="state.draft" t-on-keydown="onKeydown" t-att-disabled="state.sending"/>
                    <button class="btn btn-primary o_helpdesk_chat_send_btn" type="button"
                            t-on-click="onSend" t-att-disabled="state.sending">
                        <i class="fa fa-paper-plane"/>
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>
