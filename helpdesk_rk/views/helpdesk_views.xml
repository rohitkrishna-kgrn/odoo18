<odoo>
  <!-- Ticket search view -->
  <record id="view_helpdesk_ticket_search" model="ir.ui.view">
    <field name="name">helpdesk.ticket.search</field>
    <field name="model">helpdesk_rk.ticket</field>
    <field name="arch" type="xml">
      <search string="Helpdesk Tickets">
        <field name="name" string="Subject"/>
        <field name="ticket_number"/>
        <field name="user_id"/>
        <field name="create_date" string="Ticket Creation Date"/>
        <filter name="filter_favorites" string="My Favorites" domain="[('is_favorite','=',True)]"/>
        <filter name="filter_overdue" string="Overdue" domain="[('is_overdue','=',True)]"/>
        <separator/>
        <filter name="filter_draft" string="Draft" domain="[('stage_id','=','draft')]"/>
        <filter name="filter_new" string="New" domain="[('stage_id','=','new')]"/>
        <filter name="filter_in_progress" string="In Progress" domain="[('stage_id','=','in_progress')]"/>
        <filter name="filter_done" string="Done" domain="[('stage_id','=','done')]"/>
        <filter name="filter_rejected" string="Rejected" domain="[('stage_id','=','rejected')]"/>
        <separator/>
        <filter name="filter_creation_date" string="Ticket Creation Date" date="create_date"/>
        <group expand="0" string="Group By">
          <filter name="groupby_stage" string="Stage" context="{'group_by':'stage_id'}"/>
          <filter name="groupby_user" string="Created By" context="{'group_by':'user_id'}"/>
          <filter name="groupby_create_month" string="Creation Month" context="{'group_by':'create_date:month'}"/>
          <filter name="groupby_create_quarter" string="Creation Quarter" context="{'group_by':'create_date:quarter'}"/>
          <filter name="groupby_create_year" string="Creation Year" context="{'group_by':'create_date:year'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Ticket kanban view -->
  <record id="view_helpdesk_ticket_kanban" model="ir.ui.view">
    <field name="name">helpdesk.ticket.kanban</field>
    <field name="model">helpdesk_rk.ticket</field>
    <field name="arch" type="xml">
      <kanban default_group_by="stage_id" records_draggable="false" quick_create="false" class="o_helpdesk_kanban_modern" js_class="helpdesk_ticket_kanban">
        <field name="name"/>
        <field name="stage_id"/>
        <field name="ticket_number"/>
        <field name="user_id"/>
        <field name="create_date"/>
        <field name="deadline_date"/>
        <field name="is_favorite"/>
        <field name="is_overdue"/>
        <field name="unread_count"/>

        <!-- Force all stage groups to appear even if empty -->
        <groups>
          <group name="new" string="New" sequence="10"/>
          <group name="in_progress" string="In Progress" sequence="20"/>
          <group name="done" string="Done" sequence="30"/>
          <group name="rejected" string="Rejected" sequence="40"/>
        </groups>

        <templates>
          <t t-name="kanban-box">
            <div t-attf-class="oe_kanban_card #{record.stage_id.raw_value == 'draft' ? 'oe_kanban_card_draft' : ''}">
              <div class="o_helpdesk_kanban_header">
                <div class="o_helpdesk_kanban_header_left">
                  <span class="o_helpdesk_kanban_ticket_no" t-esc="record.ticket_number.value or 'DRAFT'"/>
                  <span class="o_helpdesk_kanban_stage_label" t-esc="record.stage_id.value"/>
                </div>
                <div class="o_helpdesk_kanban_header_right">
                  <field name="unread_count" widget="helpdesk_ticket_bell" nolabel="1"/>
                  <field name="is_favorite" widget="helpdesk_ticket_favorite" nolabel="1"/>
                </div>
              </div>
              <div class="o_helpdesk_kanban_title" t-att-title="record.name.value">
                <field name="name"/>
              </div>
              <div class="o_helpdesk_kanban_footer">
                <span class="o_helpdesk_kanban_chip">
                  <i class="fa fa-user-o" title="Created By"/>
                  <field name="user_id"/>
                </span>
                <span class="o_helpdesk_kanban_chip">
                  <i class="fa fa-calendar" title="Ticket Creation Date"/>
                  <field name="create_date" widget="date"/>
                </span>
              </div>
              <div class="o_helpdesk_kanban_deadline" t-if="record.deadline_date.raw_value and record.stage_id.raw_value != 'done' and record.stage_id.raw_value != 'rejected'">
                <i t-attf-class="fa #{record.is_overdue.raw_value ? 'fa-exclamation-triangle' : 'fa-clock-o'}"/>
                <t t-if="record.is_overdue.raw_value">Overdue since <field name="deadline_date"/></t>
                <t t-else="">Deadline: <field name="deadline_date"/></t>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- Ticket kanban view for All Tickets menu: excludes draft-stage tickets -->
  <record id="view_helpdesk_ticket_kanban_all_tickets" model="ir.ui.view">
    <field name="name">helpdesk.ticket.kanban.all.tickets</field>
    <field name="model">helpdesk_rk.ticket</field>
    <field name="inherit_id" ref="view_helpdesk_ticket_kanban"/>
    <field name="arch" type="xml">
      <xpath expr="//kanban" position="attributes">
        <attribute name="js_class">helpdesk_ticket_kanban_all</attribute>
      </xpath>
    </field>
  </record>

  <!-- Ticket list view -->
  <record id="view_helpdesk_ticket_list" model="ir.ui.view">
    <field name="name">helpdesk.ticket.list</field>
    <field name="model">helpdesk_rk.ticket</field>
    <field name="arch" type="xml">
      <list default_order="id desc" decoration-warning="is_favorite" decoration-danger="is_overdue" class="o_helpdesk_list_modern" js_class="helpdesk_ticket_list">
        <field name="is_favorite" widget="helpdesk_ticket_favorite" nolabel="1"/>
        <field name="unread_count" widget="helpdesk_ticket_bell" nolabel="1" string=" "/>
        <field name="is_overdue" invisible="1"/>
        <field name="ticket_number"/>
        <field name="name"/>
        <field name="stage_id" widget="badge"
               decoration-muted="stage_id == 'draft'"
               decoration-info="stage_id == 'new'"
               decoration-primary="stage_id == 'in_progress'"
               decoration-success="stage_id == 'done'"
               decoration-danger="stage_id == 'rejected'"/>
        <field name="create_date" string="Ticket Creation Date"/>
        <field name="deadline_date"/>
        <field name="user_id" string="Created By"/>
      </list>
    </field>
  </record>

  <!-- Ticket form view -->
  <record id="view_helpdesk_ticket_form" model="ir.ui.view">
    <field name="name">helpdesk.ticket.form</field>
    <field name="model">helpdesk_rk.ticket</field>
    <field name="arch" type="xml">
      <form string="Helpdesk Ticket" class="o_helpdesk_ticket_form" js_class="helpdesk_ticket_form">
        <header>
            <button name="action_submit_ticket" string="Submit" invisible="stage_id != 'draft'" type="object" class="btn-primary o_helpdesk_submit_btn"/>
            <button name="action_set_in_progress" string="Set In Progress" invisible="stage_id != 'new' or not id" type="object" class="btn-primary" groups="helpdesk_rk.group_helpdesk_support,base.group_system"/>
            <button name="action_set_done" string="Set Done" type="object" invisible="stage_id != 'in_progress'" class="btn-success" groups="helpdesk_rk.group_helpdesk_support,base.group_system"/>
            <button name="action_open_reject_wizard" string="Set Rejected" invisible="stage_id != 'in_progress'" type="object" class="btn-danger" groups="helpdesk_rk.group_helpdesk_support,base.group_system"/>
            <button name="action_open_deadline_wizard" string="Change Deadline" invisible="not is_overdue or stage_id not in ('new', 'in_progress')" type="object" class="btn-warning" groups="helpdesk_rk.group_helpdesk_support,base.group_system"/>
            <field name="stage_id" widget="statusbar" readonly="1"/>
          </header>
        <sheet class="position-relative">
          <widget name="web_ribbon" title="Draft" bg_color="text-bg-secondary" invisible="stage_id != 'draft'"/>
          <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
          <div class="o_helpdesk_favorite_corner">
            <field name="is_favorite" widget="helpdesk_ticket_favorite" nolabel="1"/>
          </div>
          <div class="oe_title">
            <h1>
              <field name="name" placeholder="Subject"/>
            </h1>
          </div>
          <group>
            <field name="is_support_team" invisible="1"/>
            <field name="is_overdue" invisible="1"/>
            <field name="attachment_is_image" invisible="1"/>
            <field name="attachment_is_pdf" invisible="1"/>
            <field name="ticket_number" placeholder="Generated after submission"/>
            <field name="create_date" string="Ticket Creation Date" readonly="1"/>
            <field name="deadline_date"
                   invisible="stage_id == 'draft' or (not is_support_team and stage_id in ('new', 'in_progress') and not deadline_date)"
                   readonly="not is_support_team or stage_id not in ('new', 'in_progress') or is_overdue"
                   options="{'min_date': 'today'}"/>
            <field name="assigned_user_id"
                   invisible="stage_id == 'draft'"
                   readonly="not is_support_team"
                   options="{'no_create': True, 'no_open': True}"/>
            <field name="description"/>
            <field name="user_id" readonly="1"/>
            <field name="attachment" string="Ticket Attachment" filename="attachment_filename" widget="binary_file" readonly="id"/>
          </group>
          <widget name="attachment_preview" invisible="not attachment_is_image and not attachment_is_pdf"/>
          <separator string="Conversation (Discuss-style Ticket Chat)"/>
          <widget name="ticket_chat"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <!-- Stage tree and form views -->
  <record id="view_helpdesk_stage_tree" model="ir.ui.view">
    <field name="name">helpdesk.stage.list</field>
    <field name="model">helpdesk_rk.stage</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
      </list>
    </field>
  </record>

  <record id="view_helpdesk_stage_form" model="ir.ui.view">
    <field name="name">helpdesk.stage.form</field>
    <field name="model">helpdesk_rk.stage</field>
    <field name="arch" type="xml">
      <form string="Stage">
        <sheet>
          <group>
            <field name="name"/>
            <field name="sequence"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
