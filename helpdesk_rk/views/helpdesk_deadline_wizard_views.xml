<odoo>
  <record id="view_helpdesk_ticket_deadline_wizard_form" model="ir.ui.view">
    <field name="name">helpdesk.ticket.deadline.wizard.form</field>
    <field name="model">helpdesk_rk.ticket.deadline.wizard</field>
    <field name="arch" type="xml">
      <form string="Change Overdue Deadline">
        <field name="ticket_id" invisible="1"/>
        <div class="alert alert-warning" role="alert">
          This ticket's deadline has already passed. Please provide a reason for changing it.
        </div>
        <group>
          <field name="old_deadline_date"/>
          <field name="new_deadline_date" options="{'min_date': 'today'}"/>
          <field name="reason" placeholder="Please enter the reason for changing the overdue deadline."/>
        </group>
        <footer>
          <button name="action_confirm" string="Update Deadline" type="object" class="btn-warning"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
