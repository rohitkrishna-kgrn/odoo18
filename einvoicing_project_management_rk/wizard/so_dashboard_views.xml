<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_so_dashboard_form" model="ir.ui.view">
        <field name="name">einvoicing.so.dashboard.form</field>
        <field name="model">einvoicing.so.dashboard</field>
        <field name="arch" type="xml">
            <form string="E-Invoicing">
                <field name="sale_order_id" invisible="1"/>
                <field name="pending_count" invisible="1"/>
                <field name="dashboard_html" nolabel="1" readonly="1" class="o_epm_sod_field"/>
                <footer>
                    <button name="action_refresh_quotas" type="object" string="Refresh quotas"
                            icon="fa-refresh" class="btn-primary"/>
                    <button name="action_open_trns" type="object" string="Open TRNs" class="btn-secondary"/>
                    <button name="action_add_trn" type="object" string="Add Phase 1 Project"
                            class="btn-secondary" invisible="not pending_count"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
