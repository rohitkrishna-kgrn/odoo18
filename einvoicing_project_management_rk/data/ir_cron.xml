<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every 10 minutes: fetch and store the UAT and LIVE quota of every
         Phase 1 and Unidentified row (see _cron_refresh_all_quotas for the
         rate-limit pacing). -->
    <record id="cron_refresh_quota_phase1" model="ir.cron">
        <field name="name">E-Invoicing Projects: refresh invoice quotas (UAT + LIVE)</field>
        <field name="model_id" ref="model_einvoicing_phase1_project"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_all_quotas()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
