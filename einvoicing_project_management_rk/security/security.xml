<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_einvoicing_pm" model="ir.module.category">
            <field name="name">E-Invoicing Project Management</field>
            <field name="sequence">60</field>
        </record>

        <record id="group_einvoicing_pm_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_einvoicing_pm"/>
            <field name="comment">Sees the app; creates and edits Phase 1 Projects.</field>
        </record>

        <record id="group_einvoicing_pm_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_einvoicing_pm"/>
            <field name="implied_ids" eval="[(4, ref('group_einvoicing_pm_user'))]"/>
            <field name="comment">Everything a User can do, plus deleting Phase 1 Projects.</field>
        </record>

        <!-- A User sees and edits only the Phase 1 rows they created. Group
             rules are OR'ed, so the Administrator rule (all rows) wins for
             administrators, who also carry the User group. Pending is not
             restricted: it is a list of SEs and counts, not anyone's rows. -->
        <record id="rule_phase1_project_user_own" model="ir.rule">
            <field name="name">Phase 1 Project: User sees own rows</field>
            <field name="model_id" ref="model_einvoicing_phase1_project"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_einvoicing_pm_user'))]"/>
        </record>

        <record id="rule_unidentified_user_own" model="ir.rule">
            <field name="name">Unidentified: User sees own rows</field>
            <field name="model_id" ref="model_einvoicing_unidentified"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_einvoicing_pm_user'))]"/>
        </record>

        <record id="rule_unidentified_manager_all" model="ir.rule">
            <field name="name">Unidentified: Administrator sees all rows</field>
            <field name="model_id" ref="model_einvoicing_unidentified"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_einvoicing_pm_manager'))]"/>
        </record>

        <record id="rule_unidentified_company" model="ir.rule">
            <field name="name">Unidentified: multi-company</field>
            <field name="model_id" ref="model_einvoicing_unidentified"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_phase1_project_manager_all" model="ir.rule">
            <field name="name">Phase 1 Project: Administrator sees all rows</field>
            <field name="model_id" ref="model_einvoicing_phase1_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_einvoicing_pm_manager'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="rule_phase1_project_company" model="ir.rule">
            <field name="name">Phase 1 Project: multi-company</field>
            <field name="model_id" ref="model_einvoicing_phase1_project"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_phase1_pending_company" model="ir.rule">
            <field name="name">Phase 1 Pending: multi-company</field>
            <field name="model_id" ref="model_einvoicing_phase1_pending"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
