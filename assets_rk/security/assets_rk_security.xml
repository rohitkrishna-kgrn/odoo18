<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Group for managing IT assets -->
  <record id="group_assets_rk_manager" model="res.groups">
    <field name="name">IT Assets Manager</field>
    <field name="category_id" ref="base.module_category_hidden"/>
  </record>

  <!-- Menu and view access control -->
  <record id="assets_rk_assets_device_rule" model="ir.rule">
    <field name="name">Assets Device: allowed for IT Assets Manager</field>
    <field name="model_id" ref="model_assets_device_rk"/>
    <field name="groups" eval="[(4, ref('group_assets_rk_manager'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="True"/>
  </record>

  <record id="assets_rk_location_rule" model="ir.rule">
    <field name="name">Assets Location: allowed for IT Assets Manager</field>
    <field name="model_id" ref="model_assets_location_rk"/>
    <field name="groups" eval="[(4, ref('group_assets_rk_manager'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="True"/>
  </record>
</odoo>
