<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_assets_location_tree" model="ir.ui.view">
    <field name="name">assets.location.rk.tree</field>
    <field name="model">assets.location.rk</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="code"/>
      </list>
    </field>
  </record>

  <record id="view_assets_location_form" model="ir.ui.view">
    <field name="name">assets.location.rk.form</field>
    <field name="model">assets.location.rk</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="code"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>


  <record id="action_assets_location" model="ir.actions.act_window">
    <field name="name">Locations</field>
    <field name="res_model">assets.location.rk</field>
    <field name="view_mode">list,form</field>
    <field name="context">{}</field>
  </record>

  <menuitem id="menu_assets_rk_root" name="IT Assets" sequence="10" web_icon="assets_rk,static/description/icon.png"/>
  <menuitem id="menu_assets_location" name="Locations" parent="menu_assets_rk_root" sequence="10" action="action_assets_location"/>
  
</odoo>
