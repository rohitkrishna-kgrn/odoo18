<odoo>

  <!-- Network Device Type Config View -->
  <record id="view_network_device_type_tree" model="ir.ui.view">
    <field name="name">network.device.type.rk.tree</field>
    <field name="model">network.device.type.rk</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="description"/>
      </list>
    </field>
  </record>

  <record id="view_network_device_type_form" model="ir.ui.view">
    <field name="name">network.device.type.rk.form</field>
    <field name="model">network.device.type.rk</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <field name="name"/>
          <field name="description"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_network_device_type" model="ir.actions.act_window">
    <field name="name">Network Device Types</field>
    <field name="res_model">network.device.type.rk</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Network Device Views -->
  <record id="view_network_device_tree" model="ir.ui.view">
    <field name="name">network.device.rk.tree</field>
    <field name="model">network.device.rk</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="device_type_id"/>
        <field name="ip_address"/>
        <field name="serial_number"/>
        <field name="location_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_network_device_form" model="ir.ui.view">
    <field name="name">network.device.rk.form</field>
    <field name="model">network.device.rk</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="device_type_id"/>
            <field name="ip_address"/>
            <field name="serial_number"/>
            <field name="location_id"/>
          </group>
          <group>
            <field name="purchase_date"/>
            <field name="warranty_until"/>
            <field name="active"/>
          </group>
          <notebook>
            <page string="Notes">
              <field name="notes"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_network_devices" model="ir.actions.act_window">
    <field name="name">Network Devices</field>
    <field name="res_model">network.device.rk</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Menus -->
  <menuitem id="menu_network_devices_root" name="Network Devices" parent="menu_assets_rk_root" sequence="20"/>
  <menuitem id="menu_network_devices" name="All Devices" parent="menu_network_devices_root" action="action_network_devices" sequence="10"/>
  <menuitem id="menu_network_device_types" name="Device Types" parent="menu_network_devices_root" action="action_network_device_type" sequence="20"/>

</odoo>
