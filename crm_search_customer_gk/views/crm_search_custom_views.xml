<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_search_custom_wizard_view_form" model="ir.ui.view">
        <field name="name">crm.search.custom.wizard.form</field>
        <field name="model">crm.search.custom.wizard</field>
        <field name="arch" type="xml">
            <form string="Search Existing Customer" create="0" delete="0" duplicate="0">
                <group>
                    <field name="partner_id"
                           widget="crm_customer_search"
                           placeholder="Type customer name..."
                           options="{'no_open': True, 'no_create': True}"/>
                </group>
                <field name="result_count" invisible="1"/>
                <div class="text-muted" invisible="partner_id">
                    Type at least 3 characters of the customer name, then pick the customer from the list.
                </div>
                <div class="alert alert-info mb-0" role="status" invisible="not partner_id or result_count">
                    No Sale Orders or Service Engagements found for this customer.
                </div>
                <field name="line_ids" nolabel="1" readonly="1" invisible="not result_count">
                    <list create="0" edit="0" delete="0" no_open="1" limit="100"
                          decoration-muted="is_cancelled">
                        <field name="customer_name"/>
                        <field name="record_type"/>
                        <field name="order_name"/>
                        <field name="salesperson_name"/>
                        <field name="is_cancelled" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crm_search_custom" model="ir.actions.act_window">
        <field name="name">Search Existing Customer</field>
        <field name="res_model">crm.search.custom.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="crm_search_custom_wizard_view_form"/>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>

    <!-- Sales is sequence 1 and Leads 5 in the CRM bar: 2 puts this right after Sales. -->
    <menuitem id="menu_crm_search_custom"
              name="Search Existing Customer"
              parent="crm.crm_menu_root"
              action="action_crm_search_custom"
              sequence="2"
              groups="sales_team.group_sale_salesman"/>

</odoo>
