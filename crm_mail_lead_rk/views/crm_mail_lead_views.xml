<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_mail_lead_view_list" model="ir.ui.view">
        <field name="name">crm.mail.lead.list</field>
        <field name="model">crm.mail.lead</field>
        <field name="arch" type="xml">
            <list string="Mail Leads" create="false" edit="false"
                  decoration-bf="state == 'new'" decoration-muted="state == 'assigned'">
                <header>
                    <!-- display="always" keeps it in the control panel next to
                         the "Mail Leads" title even with no row selected. -->
                    <button name="action_fetch_now" type="object"
                            string="Fetch Now" display="always"
                            class="btn-secondary" icon="fa-download"/>
                    <button name="action_open_assign_wizard" type="object"
                            string="Assign To" class="btn-primary"/>
                </header>
                <field name="date_received"/>
                <field name="tag_id" widget="badge" decoration-info="state == 'new'"/>
                <field name="name" string="Subject"/>
                <field name="email_from"/>
                <field name="contact_name" optional="show"/>
                <field name="server_id" optional="hide"/>
                <field name="attachment_count" string="Files" optional="hide"/>
                <field name="user_id" string="Assigned To" optional="show" widget="many2one_avatar_user"/>
                <field name="lead_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-success="state == 'assigned'"/>
                <!-- Per-row action, as asked: one click straight to the salesperson picker. -->
                <button name="action_open_assign_wizard" type="object"
                        string="Assign To" class="btn-link"
                        invisible="state == 'assigned'"/>
                <button name="action_view_lead" type="object"
                        string="Open Pipeline" class="btn-link"
                        invisible="state != 'assigned'"/>
                <field name="company_id" column_invisible="True" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="crm_mail_lead_view_form" model="ir.ui.view">
        <field name="name">crm.mail.lead.form</field>
        <field name="model">crm.mail.lead</field>
        <field name="arch" type="xml">
            <form string="Mail Lead" create="false" edit="false">
                <header>
                    <button name="action_open_assign_wizard" type="object"
                            string="Assign To" class="btn-primary"
                            invisible="state == 'assigned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,assigned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lead" type="object" class="oe_stat_button"
                                icon="fa-star" invisible="not lead_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Pipeline</span>
                                <span class="o_stat_text">Record</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Subject"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="tag_id" widget="badge"/>
                            <field name="server_id"/>
                            <field name="date_received"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="email_from"/>
                            <field name="contact_name"/>
                            <field name="email_to"/>
                            <field name="email_cc" invisible="not email_cc"/>
                        </group>
                    </group>
                    <group string="Assignment" invisible="state != 'assigned'">
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="lead_id"/>
                        </group>
                        <group>
                            <field name="assigned_by_id"/>
                            <field name="assigned_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message" name="message">
                            <field name="body" readonly="1"/>
                        </page>
                        <page string="Attachments" name="attachments"
                              invisible="attachment_count == 0">
                            <field name="attachment_count" invisible="1"/>
                            <field name="attachment_ids" widget="many2many_binary" readonly="1"/>
                        </page>
                        <page string="Technical" name="technical" groups="base.group_no_one">
                            <group>
                                <field name="message_id"/>
                                <field name="email_from_raw"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_mail_lead_view_search" model="ir.ui.view">
        <field name="name">crm.mail.lead.search</field>
        <field name="model">crm.mail.lead</field>
        <field name="arch" type="xml">
            <search string="Mail Leads">
                <field name="name" string="Subject"/>
                <field name="email_from" string="From"
                       filter_domain="['|', ('email_from', 'ilike', self), ('contact_name', 'ilike', self)]"/>
                <field name="tag_id"/>
                <field name="server_id"/>
                <field name="user_id"/>
                <filter name="filter_new" string="To Assign" domain="[('state', '=', 'new')]"/>
                <filter name="filter_assigned" string="Assigned" domain="[('state', '=', 'assigned')]"/>
                <separator/>
                <filter name="filter_mine" string="Assigned to Me"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_today" string="Today"
                        domain="[('date_received', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter name="filter_with_attachments" string="With Attachments"
                        domain="[('attachment_ids', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_tag" string="Tag" context="{'group_by': 'tag_id'}"/>
                    <filter name="group_server" string="Mailbox" context="{'group_by': 'server_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Assigned To" context="{'group_by': 'user_id'}"/>
                    <filter name="group_date" string="Received On" context="{'group_by': 'date_received:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="crm_mail_lead_action" model="ir.actions.act_window">
        <field name="name">Mail Leads</field>
        <field name="res_model">crm.mail.lead</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="crm_mail_lead_view_search"/>
        <field name="context">{'search_default_filter_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No mail leads yet
            </p>
            <p>
                Mail sent to the configured CRM mailboxes shows up here within
                2 minutes, tagged with the inbox it arrived in — or press
                <b>Fetch Now</b> to pull it immediately. Use
                <b>Assign To</b> on a row to pick a salesperson — that creates
                the CRM pipeline record.
            </p>
        </field>
    </record>

</odoo>
