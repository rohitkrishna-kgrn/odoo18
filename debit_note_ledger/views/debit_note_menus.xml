<odoo>

    <!-- Customer Debit Notes -->
    <record id="action_customer_debit_note_ledger" model="ir.actions.act_window">
        <field name="name">Debit Notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['&amp;', ('move_type', '=', 'out_invoice'), '|', ('debit_origin_id', '!=', False), ('is_debit_note', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'default_is_debit_note': True}</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
    </record>

    <menuitem id="menu_customer_debit_note_ledger"
              name="Debit Notes"
              parent="account.menu_finance_receivables"
              action="action_customer_debit_note_ledger"
              sequence="12"/>

    <!-- Vendor Debit Notes -->
    <record id="action_vendor_debit_note_ledger" model="ir.actions.act_window">
        <field name="name">Debit Notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['&amp;', ('move_type', '=', 'in_invoice'), '|', ('debit_origin_id', '!=', False), ('is_debit_note', '=', True)]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'default_is_debit_note': True, 'debit_note_positive_amount': True}</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
    </record>

    <menuitem id="menu_vendor_debit_note_ledger"
              name="Debit Notes"
              parent="account.menu_finance_payables"
              action="action_vendor_debit_note_ledger"
              sequence="12"/>

</odoo>
