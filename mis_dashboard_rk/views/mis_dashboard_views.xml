<odoo>
    <!-- Project Tasks MIS List View -->
    <record id="view_mis_dashboard_project_task_list" model="ir.ui.view">
        <field name="name">mis.dashboard.project.task.list</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <list string="Project Tasks MIS">
                <field name="name"/>
                <field name="team_member_ids" widget="many2many_tags"/>
                <field name="stage_id"/>
                <field name="calculated_task_budget"/>
                <field name="task_budget"/>
                <field name="allocated_hours"/>
                <field name="effective_hours"/>
                <field name="timesheet_total"/>
                <field name="completed_date"/>
            </list>
        </field>
    </record>

    <record id="view_mis_dashboard_project_task_list_labels" model="ir.ui.view">
        <field name="name">mis.dashboard.project.task.list.labels</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="mis_dashboard_rk.view_mis_dashboard_project_task_list"/>
        <field name="arch" type="xml">
            <field name="customer_id" position="attributes">
                <attribute name="string">Customer (Custom)</attribute>
            </field>
        </field>
    </record>

    <record id="view_mis_dashboard_project_task_form" model="ir.ui.view">
        <field name="name">mis.dashboard.project.task.form</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <form string="Project Task MIS">
                <sheet>

                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                            <field name="stage_id" readonly="1"/>
                            <field name="team_member_ids" widget="many2many_tags" readonly="1"/>
                            <!-- <field name="project_manager" readonly="1"/>
                            <field name="manager_department_id" readonly="1"/> -->
                        </group>

                        <group string="Financials">
                            <field name="task_budget" readonly="1"/>
                            <field name="calculated_task_budget" readonly="1"/>
                        </group>

                        <group string="Timesheet / Work">
                            <field name="allocated_hours" readonly="1"/>
                            <field name="effective_hours" readonly="1"/>
                        </group>

                        <group string="Timesheet Rate After W">
                            <field name="timesheet_total" readonly="1"/>
                            <field name="timesheet_rate" readonly="1"/>
                            <field name="timesheet_user_total" readonly="1"/>
                        </group>
                    </group>

                    <!-- Summary table -->
                    <group string="Timesheet Summary">
                        <field name="timesheet_summary_ids" readonly="1">
                            <list>
                                <field name="user_id"/>
                                <field name="hours_spent"/>
                                <field name="weightage_number"/>
                                <field name="total"/>
                                <field name="user_w_rate"/>
                            </list>
                        </field>
                    </group>
                    <group string="P/L Status">
                        <field name="profit_loss_status" widget="html"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action -->
    <record id="action_mis_dashboard_project_task" model="ir.actions.act_window">
        <field name="name">Project-wise Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <!-- Set initial view to your custom list -->
        <field name="view_id" ref="view_mis_dashboard_project_task_list"/>
        <!-- Explicitly define both custom views -->
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_mis_dashboard_project_task_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_mis_dashboard_project_task_form')})
        ]"/>
        <field name="domain">[('stage_id.name', '=', 'Done')]</field>
        <field name="context">{'group_by': ['project_id'], 'group_by_no_leaf': False}</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_mis_dashboard_rk_root" name="MIS Dashboard" sequence="10" web_icon="mis_dashboard_rk,static/description/icon.png" groups="mis_dashboard_rk.group_task_timesheet_summary_access"/>
    <menuitem id="menu_mis_dashboard_project" 
              name="Project-wise" 
              parent="menu_mis_dashboard_rk_root" 
              action="action_mis_dashboard_project_task" 
              sequence="10"/>
</odoo>
