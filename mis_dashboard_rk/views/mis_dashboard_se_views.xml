<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mis_dashboard_sale_order_line_list" model="ir.ui.view">
        <field name="name">mis.dashboard.sale.order.line.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="manager_id"/>
                <field name="product_uom_qty" readonly="1"/>
                <field name="qty_delivered" readonly="1"/>
                <field name="advance_per_line" readonly="1"/>
                <field name="price_unit"/>
                <field name="tax_id"/>
                <field name="price_subtotal" sum="Total"/>
                <field name="outstanding_amount" readonly="1" sum="Total"/>
                <field name="invoice_status_custom"/>
            </list>
        </field>
    </record>

    <record id="view_mis_dashboard_sale_order_line_list_labels" model="ir.ui.view">
        <field name="name">mis.dashboard.sale.order.line.list.labels</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="mis_dashboard_rk.view_mis_dashboard_sale_order_line_list"/>
        <field name="arch" type="xml">
            <field name="invoice_status_custom" position="attributes">
                <attribute name="string">Invoice Status (Custom)</attribute>
            </field>
        </field>
    </record>

    <record id="view_mis_dashboard_sale_order_line_form" model="ir.ui.view">
        <field name="name">mis.dashboard.sale.order.line.form</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="order_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_uom_qty" readonly="1"/>
                            <field name="qty_delivered" readonly="1"/>
                            <field name="qty_invoiced" readonly="1"/>
                        </group>
                        <group>
                            <field name="price_unit" readonly="1"/>
                            <field name="manager_id" readonly="1"/>
                            <field name="advance_per_line" readonly="1"/>
                            <field name="price_subtotal" readonly="1"/>
                            <field name="task_value" readonly="1"/>
                            <field name="outstanding_amount" readonly="1"/>
                            <field name="deadline" readonly="1"/>
                        </group>
                    </group>
                    <group string="Invoices">
                        <field name="invoice_ids">
                            <list>
                                <field name="name"/>
                                <field name="move_type"/>
                                <field name="invoice_date"/>
                                <field name="sale_line_price_unit"/>
                                <field name="status_in_payment"/>
                                <field name="advance_invoice_status"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mis_dashboard_sale_order_line_search" model="ir.ui.view">
        <field name="name">mis.dashboard.sale.order.line.search</field>
        <field name="model">sale.order.line</field>
        <!-- <field name="inherit_id" ref="mis_dashboard_rk.view_mis_dashboard_sale_order_line_list"/> -->
        <field name="arch" type="xml">
            <search string="Filters">
                <!-- Order Line Creation Date -->
                <filter name="filter_order_date" string="Order Date" date="order_date"/>
                
                <!-- Invoice Creation Date -->
                <filter name="filter_invoice_date" string="Invoice Date"
                    date="invoice_date_min"/>
        
            </search>
        </field>
    </record>

    <!-- Action for MIS Dashboard -->
    <record id="action_mis_dashboard_sale_order_line" model="ir.actions.act_window">
        <field name="name">SE Dashboard</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_mis_dashboard_sale_order_line_list"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_mis_dashboard_sale_order_line_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_mis_dashboard_sale_order_line_form')})
        ]"/>
        <field name="search_view_id" ref="view_mis_dashboard_sale_order_line_search"/>
        <field name="domain">[('order_id.state', '=', 'sale'), ('is_fully_delivered', '=', True)]</field>
        <field name="context">{'group_by':['department_id','manager_id']}</field>
    </record>

    <!-- Menu item -->
    <!-- <menuitem id="menu_mis_dashboard_sale_order" 
              name="SE Dashboard" 
              parent="menu_mis_dashboard_rk_root" 
              action="action_mis_dashboard_sale_order_line" 
              sequence="1"/> -->
</odoo>
