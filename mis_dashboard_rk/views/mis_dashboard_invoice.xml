    <record id="action_custom_posted_invoices" model="ir.actions.act_window">
        <field name="name">Posted Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_custom_posted_invoice_tree"/>
        <!-- <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_custom_posted_invoice_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_custom_posted_invoice_form')})
        ]"/> -->
        <field name="domain">[('move_type', 'in', ('out_invoice','in_invoice')), ('state','=','posted')]</field>
        <field name="context">
            {
                'group_by': [
                    'manager_department_id',
                    'manager_id_from_sol',
                ]
            }
        </field>
    </record>

    <menuitem id="menu_mis_dashboard_invoice" 
              name="Invoice Dashboard" 
              parent="menu_mis_dashboard_rk_root" 
              action="action_custom_posted_invoices" 
              sequence="2"
              />

</odoo>