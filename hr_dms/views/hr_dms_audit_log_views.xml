<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_dms_audit_list" model="ir.ui.view">
        <field name="name">hr.dms.audit.log.list</field>
        <field name="model">hr.dms.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/><field name="user_id"/><field name="action"/>
                <field name="employee_name"/><field name="category_name"/><field name="document_name"/>
                <field name="details" optional="show"/><field name="ip_address" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_hr_dms_audit_form" model="ir.ui.view">
        <field name="name">hr.dms.audit.log.form</field>
        <field name="model">hr.dms.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet><group>
                    <group><field name="date"/><field name="user_id"/><field name="action"/><field name="ip_address"/></group>
                    <group><field name="employee_name"/><field name="category_name"/><field name="document_name"/></group>
                </group><field name="details"/></sheet>
            </form>
        </field>
    </record>
    <record id="view_hr_dms_audit_search" model="ir.ui.view">
        <field name="name">hr.dms.audit.log.search</field>
        <field name="model">hr.dms.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/><field name="employee_name"/><field name="document_name"/><field name="details"/>
                <filter name="f_upload" string="Uploads" domain="[('action', '=', 'upload')]"/>
                <filter name="f_modify" string="Modifications" domain="[('action', '=', 'modify')]"/>
                <filter name="f_delete" string="Deletions" domain="[('action', '=', 'delete')]"/>
                <filter name="f_download" string="Downloads" domain="[('action', '=', 'download')]"/>
                <filter name="f_access" string="Access Changes" domain="[('action', '=', 'access_change')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="g_action" string="Action" context="{'group_by': 'action'}"/>
                    <filter name="g_date" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_hr_dms_audit" model="ir.actions.act_window">
        <field name="name">Audit Trail</field>
        <field name="res_model">hr.dms.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_g_date': 1}</field>
    </record>
</odoo>
