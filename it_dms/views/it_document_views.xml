<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== LIST VIEW ==================== -->
    <record id="view_it_document_list" model="ir.ui.view">
        <field name="name">it.document.list</field>
        <field name="model">it.document</field>
        <field name="arch" type="xml">
            <list string="IT Documents" default_order="create_date desc"
                decoration-success="status == 'active'"
                decoration-muted="status == 'archived'"
                decoration-warning="status == 'draft'">
                <field name="document_code" string="Code" optional="show"/>
                <field name="name" string="Document Name"/>
                <field name="document_type" string="Type"/>
                <field name="folder_id" string="Folder"/>
                <field name="category_id" string="Category" optional="show"/>
                <field name="owner_id" string="Owner" widget="many2one_avatar_user"/>
                <field name="version" string="Ver." optional="show"/>
                <field name="create_date" string="Uploaded On" optional="show"/>
                <field name="write_date" string="Last Modified" optional="show"/>
                <field name="status" string="Status"
                    decoration-success="status == 'active'"
                    decoration-warning="status == 'draft'"
                    decoration-muted="status == 'archived'"/>
                <field name="attachment_file" column_invisible="1"/>
                <button name="action_download_file"
                    type="object"
                    icon="fa-download"
                    title="Download File"
                    invisible="not attachment_file"/>
            </list>
        </field>
    </record>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="view_it_document_form" model="ir.ui.view">
        <field name="name">it.document.form</field>
        <field name="model">it.document</field>
        <field name="arch" type="xml">
            <form string="IT Document">
                <header>
                    <button name="action_activate"
                        string="Activate" type="object" class="btn-primary"
                        invisible="status != 'draft'"/>
                    <button name="action_archive_doc"
                        string="Archive" type="object"
                        invisible="status == 'archived'"/>
                    <button name="action_set_draft"
                        string="Reset to Draft" type="object"
                        invisible="status != 'archived'"/>
                    <button name="action_download_file"
                        string="Download File" type="object"
                        class="btn-secondary"
                        invisible="not attachment_file"/>
                    <button name="action_print_document"
                        string="Print" type="object" class="btn-secondary"/>
                    <field name="status" widget="statusbar"
                        statusbar_visible="draft,active,archived"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_versions"
                            type="object" class="oe_stat_button" icon="fa-history">
                            <field name="version_count" widget="statinfo" string="Versions"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="document_code" string="Document Code"/>
                        <h2 class="text-muted">
                            <field name="document_code" readonly="1"/>
                        </h2>
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Document Name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Classification">
                            <field name="document_type"/>
                            <field name="category_id" options="{'no_open': True}"/>
                            <field name="folder_id"/>
                            <field name="tag_ids" widget="many2many_tags"
                                options="{'color_field': 'color', 'no_create': True}"/>
                        </group>
                        <group string="Ownership">
                            <field name="owner_id" widget="many2one_avatar_user"/>
                            <field name="create_uid" string="Created By" readonly="1"/>
                            <field name="create_date" string="Created On" readonly="1"/>
                            <field name="write_date" string="Last Modified" readonly="1"/>
                            <field name="version"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- Tab 1: Description -->
                        <page string="Description" name="description">
                            <field name="description"
                                placeholder="Enter a brief description of this document..."/>
                        </page>

                        <!-- Tab 2: Files (Engineer / Admin: add, edit, delete; Viewer: read + download) -->
                        <page string="Files" name="files">
                            <field name="line_ids" nolabel="1">
                                <list string="Files" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description"
                                        string="Description"
                                        placeholder="Enter description..."/>
                                    <field name="file"
                                        widget="binary"
                                        filename="filename"
                                        string="File Upload"/>
                                    <field name="filename" string="File Name"/>
                                    <field name="uploaded_by"
                                        string="Uploaded By"
                                        widget="many2one_avatar_user"
                                        readonly="1"/>
                                    <field name="uploaded_date"
                                        string="Uploaded Date"
                                        readonly="1"/>
                                    <button name="action_download_file"
                                        type="object"
                                        icon="fa-download"
                                        title="Download File"
                                        invisible="not file"/>
                                </list>
                            </field>

                            <!-- Hidden — used by the header Download File button -->
                            <field name="attachment_file" invisible="1"
                                filename="attachment_filename" widget="binary"/>
                            <field name="attachment_filename" invisible="1"/>
                        </page>

                        <!-- Tab 3: Notes -->
                        <page string="Notes" name="notes">
                            <field name="notes" widget="html"
                                placeholder="Additional notes, instructions, or comments..."/>
                        </page>

                        <!-- Tab 4: Version History -->
                        <page string="Version History" name="versions">
                            <div class="mb-3">
                                <button name="action_upload_version"
                                    string="Upload New Version"
                                    type="object"
                                    class="btn btn-secondary"/>
                            </div>
                            <field name="version_ids" readonly="1">
                                <list string="Version History"
                                    default_order="upload_date desc">
                                    <field name="version_number" string="Version"/>
                                    <field name="uploaded_by" string="Uploaded By"
                                        widget="many2one_avatar_user"/>
                                    <field name="upload_date" string="Upload Date"/>
                                    <field name="attachment_filename" string="File"/>
                                    <field name="comments" string="Comments"/>
                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== KANBAN VIEW ==================== -->
    <record id="view_it_document_kanban" model="ir.ui.view">
        <field name="name">it.document.kanban</field>
        <field name="model">it.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="folder_id" class="o_kanban_small_column"
                quick_create="false">
                <field name="name"/>
                <field name="document_code"/>
                <field name="status"/>
                <field name="document_type"/>
                <field name="folder_id"/>
                <field name="owner_id"/>
                <field name="tag_ids"/>
                <field name="write_date"/>
                <field name="attachment_file"/>
                <templates>
                    <t t-name="card" class="oe_kanban_card oe_kanban_global_click">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings flex-grow-1">
                                    <strong class="o_kanban_record_title">
                                        <t t-esc="record.name.value"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted d-block">
                                        <t t-esc="record.document_code.value"/>
                                    </small>
                                </div>
                                <div class="o_dropdown_kanban dropdown ms-2">
                                    <a role="button"
                                        class="dropdown-toggle o-no-caret btn"
                                        data-bs-toggle="dropdown"
                                        href="#"
                                        aria-label="Menu"
                                        tabindex="-1">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a role="menuitem" type="edit"
                                            class="dropdown-item">Edit</a>
                                        <a role="menuitem" type="object"
                                            name="action_download_file"
                                            class="dropdown-item">Download</a>
                                        <a role="menuitem" type="delete"
                                            class="dropdown-item text-danger">Delete</a>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="badge rounded-pill text-bg-info me-1">
                                    <t t-esc="record.document_type.value"/>
                                </span>
                                <span t-if="record.status.raw_value == 'active'"
                                    class="badge rounded-pill text-bg-success">Active</span>
                                <span t-if="record.status.raw_value == 'draft'"
                                    class="badge rounded-pill text-bg-warning">Draft</span>
                                <span t-if="record.status.raw_value == 'archived'"
                                    class="badge rounded-pill text-bg-secondary">Archived</span>
                                <div t-if="record.folder_id.value"
                                    class="text-muted small mt-1">
                                    <i class="fa fa-folder me-1"/>
                                    <t t-esc="record.folder_id.value"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="tag_ids" widget="many2many_tags"
                                        options="{'color_field': 'color'}"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="owner_id"
                                        widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== SEARCH VIEW ==================== -->
    <record id="view_it_document_search" model="ir.ui.view">
        <field name="name">it.document.search</field>
        <field name="model">it.document</field>
        <field name="arch" type="xml">
            <search string="Search IT Documents">
                <field name="name" string="Document Name"
                    filter_domain="[('name', 'ilike', self)]"/>
                <field name="document_code" string="Code"/>
                <field name="category_id" string="Category"/>
                <field name="folder_id" string="Folder"/>
                <field name="tag_ids" string="Tags"/>
                <field name="owner_id" string="Owner"/>
                <field name="document_type" string="Type"/>
                <separator/>
                <filter string="My Documents" name="my_documents"
                    domain="[('owner_id', '=', uid)]"/>
                <filter string="Active" name="active_docs"
                    domain="[('status', '=', 'active')]"/>
                <filter string="Draft" name="draft_docs"
                    domain="[('status', '=', 'draft')]"/>
                <filter string="Archived" name="archived_docs"
                    domain="[('status', '=', 'archived')]"/>
                <separator/>
                <filter string="Has File" name="has_file"
                    domain="[('attachment_file', '!=', False)]"/>
                <filter string="Recently Uploaded" name="recently_uploaded"
                    domain="[('create_date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Folder" name="group_folder"
                        context="{'group_by': 'folder_id'}"/>
                    <filter string="Category" name="group_category"
                        context="{'group_by': 'category_id'}"/>
                    <filter string="Owner" name="group_owner"
                        context="{'group_by': 'owner_id'}"/>
                    <filter string="Document Type" name="group_type"
                        context="{'group_by': 'document_type'}"/>
                    <filter string="Status" name="group_status"
                        context="{'group_by': 'status'}"/>
                    <filter string="Upload Month" name="group_month"
                        context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== GRAPH VIEW ==================== -->
    <record id="view_it_document_graph" model="ir.ui.view">
        <field name="name">it.document.graph</field>
        <field name="model">it.document</field>
        <field name="arch" type="xml">
            <graph string="Document Analysis" type="bar">
                <field name="folder_id" type="row"/>
                <field name="document_type" type="col"/>
            </graph>
        </field>
    </record>

    <!-- ==================== PIVOT VIEW ==================== -->
    <record id="view_it_document_pivot" model="ir.ui.view">
        <field name="name">it.document.pivot</field>
        <field name="model">it.document</field>
        <field name="arch" type="xml">
            <pivot string="Document Analysis">
                <field name="folder_id" type="row"/>
                <field name="document_type" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- ==================== ACTIONS ==================== -->
    <record id="action_it_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">it.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_it_document_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload your first IT document!
            </p>
            <p>
                Store SOPs, technical guides, server documentation, network diagrams,
                software licences, and more in a centralised repository.
            </p>
        </field>
    </record>

    <record id="action_it_document_report" model="ir.actions.act_window">
        <field name="name">Document Analysis</field>
        <field name="res_model">it.document</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_it_document_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No documents found for analysis.
            </p>
        </field>
    </record>

</odoo>
