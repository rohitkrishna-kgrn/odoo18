<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_it_category_list" model="ir.ui.view">
        <field name="name">it.category.list</field>
        <field name="model">it.category</field>
        <field name="arch" type="xml">
            <list string="IT Document Categories" editable="top">
                <field name="name"/>
                <field name="description"/>
                <field name="color" widget="color_picker"/>
                <field name="document_count" string="Documents" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_it_category_form" model="ir.ui.view">
        <field name="name">it.category.form</field>
        <field name="model">it.category</field>
        <field name="arch" type="xml">
            <form string="IT Document Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Network, Server, Security..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Category description..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_it_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">it.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first document category!
            </p>
            <p>
                Categories help you organize IT documents into logical groups
                such as Network, Server, Security, Application, etc.
            </p>
        </field>
    </record>

</odoo>
