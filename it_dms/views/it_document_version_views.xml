<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_it_document_version_list" model="ir.ui.view">
        <field name="name">it.document.version.list</field>
        <field name="model">it.document.version</field>
        <field name="arch" type="xml">
            <list string="Document Version History" default_order="upload_date desc">
                <field name="document_id"/>
                <field name="version_number"/>
                <field name="uploaded_by"/>
                <field name="upload_date"/>
                <field name="attachment_filename" string="File"/>
                <field name="comments"/>
            </list>
        </field>
    </record>

    <record id="view_it_document_version_form" model="ir.ui.view">
        <field name="name">it.document.version.form</field>
        <field name="model">it.document.version</field>
        <field name="arch" type="xml">
            <form string="Upload Document Version">
                <sheet>
                    <div class="oe_title">
                        <label for="version_number"/>
                        <h1>
                            <field name="version_number" placeholder="e.g. 1.1, 2.0"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_id" readonly="1"/>
                            <field name="uploaded_by" readonly="1"/>
                            <field name="upload_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="attachment" filename="attachment_filename" widget="binary"/>
                            <field name="attachment_filename"/>
                        </group>
                    </group>
                    <group string="Version Comments">
                        <field name="comments" nolabel="1"
                            placeholder="Describe what changed in this version..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
