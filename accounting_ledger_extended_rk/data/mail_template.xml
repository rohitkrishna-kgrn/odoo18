<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_outstanding" model="mail.template">
        <field name="name">Outstanding Statement</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="subject">Outstanding Statement - {{ object.company_id.name or object.env.company.name }}</field>
        <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="lang">{{ object.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="margin:0;padding:0;background:#f4f6f9;font-family:Arial,Helvetica,sans-serif;">
    <table align="center" width="650" style="background:#ffffff;border-collapse:collapse;margin:20px auto;border:1px solid #e0e0e0;">
        <tr>
            <td style="background:#1f3864;padding:20px 24px;" valign="middle">
                <table width="100%"><tr>
                    <td valign="middle">
                        <t t-set="company" t-value="object.company_id or object.env.company"/>
                        <t t-if="company.logo">
                            <img t-att-src="'/web/image/res.company/%s/logo' % company.id"
                                 style="max-height:48px;background:#ffffff;padding:4px;border-radius:4px;"/>
                        </t>
                    </td>
                    <td valign="middle" align="right" style="color:#ffffff;font-size:20px;font-weight:bold;">
                        Outstanding Statement
                    </td>
                </tr></table>
            </td>
        </tr>
        <tr><td style="padding:24px;color:#333333;font-size:14px;">
            <p>Dear <t t-out="object.name or ''"/>,</p>
            <p>Please find below your outstanding statement as of today. The
               related invoices are attached to this email as PDF.</p>
            <table width="100%" style="border-collapse:collapse;margin-top:12px;font-size:13px;">
                <thead>
                    <tr style="background:#1f3864;color:#ffffff;">
                        <th style="border:1px solid #d0d0d0;padding:8px;text-align:left;">Date</th>
                        <th style="border:1px solid #d0d0d0;padding:8px;text-align:left;">Invoice</th>
                        <th style="border:1px solid #d0d0d0;padding:8px;text-align:left;">Due Date</th>
                        <th style="border:1px solid #d0d0d0;padding:8px;text-align:right;">Outstanding</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="object._get_outstanding_moves()" t-as="mv">
                        <t t-set="sign" t-value="-1 if mv.move_type == 'out_refund' else 1"/>
                        <tr>
                            <td style="border:1px solid #e0e0e0;padding:8px;"><t t-out="mv.invoice_date"/></td>
                            <td style="border:1px solid #e0e0e0;padding:8px;"><t t-out="mv.name"/></td>
                            <td style="border:1px solid #e0e0e0;padding:8px;"><t t-out="mv.invoice_date_due"/></td>
                            <td style="border:1px solid #e0e0e0;padding:8px;text-align:right;">
                                <span t-out="mv.amount_residual * sign"
                                      t-options="{'widget': 'monetary', 'display_currency': mv.currency_id}"/>
                            </td>
                        </tr>
                    </t>
                    <tr style="background:#d9e1f2;font-weight:bold;">
                        <td colspan="3" style="border:1px solid #d0d0d0;padding:8px;text-align:right;">Total Outstanding</td>
                        <td style="border:1px solid #d0d0d0;padding:8px;text-align:right;">
                            <span t-out="object._ledger_total_outstanding()"
                                  t-options="{'widget': 'monetary', 'display_currency': (object.company_id or object.env.company).currency_id}"/>
                        </td>
                    </tr>
                </tbody>
            </table>
            <p style="margin-top:20px;">We kindly request you to arrange the
               payment at the earliest. Please ignore this email if payment has
               already been made.</p>
            <p>Regards,<br/>
               <t t-out="(object.company_id or object.env.company).name"/></p>
        </td></tr>
        <tr><td style="background:#f4f6f9;padding:14px 24px;color:#888888;font-size:11px;text-align:center;">
            This is an automated statement from
            <t t-out="(object.company_id or object.env.company).name"/>.
        </td></tr>
    </table>
</div>
        </field>
    </record>
</odoo>
