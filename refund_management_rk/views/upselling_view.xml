<odoo>
    <record id="view_form_upselling" model="ir.ui.view">
        <field name="name">Upselling Form</field>
        <field name="model">upselling</field>
        <field name="arch" type="xml">
            <form string="Upselling">
                <header>
                    <button name="action_submit_review" string="Submit for Review" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_submit_approval" string="Submit for Approval" type="object"
                            invisible="state != 'review'" class="btn-primary"
                            groups="refund_management_rk.group_reimbursement_reviewer"/>
                    <button name="action_approve" string="Approve" type="object"
                            invisible="state != 'approval'" class="btn-success"
                            groups="refund_management_rk.group_reimbursement_approver"/>
                    <button name="action_submit_review" string="Reset to Review" type="object"
                            invisible="state not in ('approval',)" class="btn-secondary"
                            groups="refund_management_rk.group_reimbursement_reviewer"/>
                    <button name="action_resubmit" string="Resubmission" type="object"
                            invisible="state != 'review'" class="btn-warning"
                            groups="refund_management_rk.group_reimbursement_reviewer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,approval,approved"/>
                </header>
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="sequence" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Basic Info -->
                    <group string="General Information">
                        <group>
                            <field name="user_id"/>
                            <field name="sale_order_id" no_create="1" no_create_edit="1"/>
                            <field name="customer_id"/>
                            <field name="create_date" string="Created Date" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Describe the upselling opportunity..."/>
                    </group>

                    <!-- Documents -->
                    <group string="Documents">
                        <group>
                            <field name="proposal_file" filename="proposal_filename" widget="binary"/>
                            <field name="proposal_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="engagement_file" filename="engagement_filename" widget="binary"/>
                            <field name="engagement_filename" invisible="1"/>
                        </group>
                    </group>

                    <!-- Payment Info -->
                    <group string="Payment Details">
                        <group>
                            <field name="payment_received_datetime"/>
                        </group>
                        <group>
                            <field name="payment_reference"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Invoices" name="invoice_details">
                            <field name="invoice_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_untaxed" string="Subtotal"/>
                                    <field name="amount_total"/>
                                    <field name="payment_state"/>
                                    <field name="state" string="Status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tree_upselling" model="ir.ui.view">
        <field name="name">Upselling Tree</field>
        <field name="model">upselling</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="user_id"/>
                <field name="sale_order_id"/>
                <field name="customer_id"/>
                <field name="payment_received_datetime"/>
                <field name="payment_reference"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'review'"
                       decoration-warning="state == 'approval'"
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="action_upselling" model="ir.actions.act_window">
        <field name="name">Upselling</field>
        <field name="res_model">upselling</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id','=',uid)]</field>
    </record>

    <record id="action_upselling_reviewer" model="ir.actions.act_window">
        <field name="name">All Upselling</field>
        <field name="res_model">upselling</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_upselling_user"
              name="My Upselling"
              parent="menu_reimbursement_root"
              action="refund_management_rk.action_upselling"
              sequence="40"/>

    <menuitem id="menu_upselling_reviewer"
              name="All Upselling"
              parent="menu_reimbursement_root"
              action="refund_management_rk.action_upselling_reviewer"
              groups="refund_management_rk.group_reimbursement_reviewer"
              sequence="50"/>
</odoo>
