<odoo>
    <record id="view_attach_bills_wizard" model="ir.ui.view">
        <field name="name">attach.bills.wizard.form</field>
        <field name="model">attach.bills.wizard</field>
        <field name="arch" type="xml">
            <form string="Attach Reimbursement Bills">
                <field name="line_ids" mode="list,form">
                    <list editable="bottom">
                        <field name="bill_date"/>
                        <field name="purpose"/>
                        <field name="bill_type"/>
                        <field name="bill_submitted"/>
                        <field name="bill_amount"/>
                        <field name="attachment" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button string="Submit" type="object" name="action_submit" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

