<odoo>
    <record id="view_upselling_resubmit_wizard_form" model="ir.ui.view">
        <field name="name">upselling.resubmit.wizard.form</field>
        <field name="model">upselling.resubmit.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Resubmission">
                <group>
                    <field name="upselling_id" invisible="1"/>
                    <field name="remark" placeholder="Enter remark for resubmission..." required="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_confirm_resubmit" string="Confirm Resubmission"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
