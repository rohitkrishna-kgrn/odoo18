<odoo>
    <record id="view_upload_excel_wizard" model="ir.ui.view">
        <field name="name">upload.excel.wizard.form</field>
        <field name="model">upload.excel.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Excel">
                <group>
                    <field name="excel_file" filename="file_name"/>
                    <field name="file_name"/>
                </group>
                <footer>
                    <button string="Next" type="object" name="action_process_excel" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="upload_excel_wizard_action" model="ir.actions.act_window">
        <field name="name">Upload Reimbursement Excel</field>
        <field name="res_model">upload.excel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
