<odoo>
    <record id="view_upselling_reject_wizard_form" model="ir.ui.view">
        <field name="name">upselling.reject.wizard.form</field>
        <field name="model">upselling.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Upselling">
                <div class="alert alert-danger" role="alert">
                    Rejecting this request stops it permanently. It will not proceed to the
                    next approval stage.
                </div>
                <group>
                    <field name="upselling_id" invisible="1"/>
                    <field name="rejection_reason" nolabel="1" required="1"
                           placeholder="Enter the reason for rejecting this upselling request (mandatory)..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Confirm Rejection"
                            type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
