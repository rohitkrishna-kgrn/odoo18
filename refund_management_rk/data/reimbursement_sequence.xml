<odoo>
    <data noupdate="1">
        <record id="seq_reimbursement" model="ir.sequence">
            <field name="name">Reimbursement Sequence</field>
            <field name="code">reimbursement.seq</field>
            <field name="prefix">RBM/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
        </record>

        <record id="seq_upselling" model="ir.sequence">
            <field name="name">Upselling Sequence</field>
            <field name="code">upselling.sequence</field>
            <field name="prefix">UPS/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
