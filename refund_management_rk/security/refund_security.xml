<odoo>
    <data>
        <!-- Reimbursement Reviewer group -->
        <record id="group_reimbursement_reviewer" model="res.groups">
            <field name="name">Reimbursement Reviewer</field>
        </record>

        <!-- Reimbursement Approver group -->
        <record id="group_reimbursement_approver" model="res.groups">
            <field name="name">Reimbursement Approver</field>
        </record>

        <!-- Allow base users to read all sale orders (needed for upselling sale_order_id field) -->
        <record id="sale_order_read_all_base_users" model="ir.rule">
            <field name="name">Upselling: Base users can read all sale orders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
