<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════
         Email All Wizard
    ══════════════════════════════════════════════════════════ -->

    <record id="view_contact_email_all_wizard_form" model="ir.ui.view">
        <field name="name">contact.email.all.wizard.form</field>
        <field name="model">contact.email.all.wizard</field>
        <field name="arch" type="xml">
            <form string="Email All Contacts">
                <div class="alert alert-info" role="alert" style="margin:12px 0;">
                    <strong>Public Customer Form URL (this database)</strong><br/>
                    <field name="public_form_url" readonly="1" widget="url" nolabel="1"
                           style="font-weight:600;font-size:13px;"/>
                    <br/><small>Share this link so customers can fill in their information directly without needing an email.</small>
                </div>
                <div class="alert alert-warning" role="alert" style="margin:12px 0;">
                    <strong>Send Customer Information Form to All Contacts</strong><br/>
                    This will create a new form token and send the Customer Information Form
                    email to every contact that has a valid email address.
                </div>
                <group>
                    <field name="contact_count" string="Contacts with Email" readonly="1"/>
                </group>
                <footer>
                    <button name="action_send_all" type="object"
                            string="Send Emails to All" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Dedicated wizard just to display the public form URL -->
    <record id="view_contact_public_form_url_form" model="ir.ui.view">
        <field name="name">contact.email.all.wizard.url.form</field>
        <field name="model">contact.email.all.wizard</field>
        <field name="arch" type="xml">
            <form string="Public Customer Form Link">
                <div class="alert alert-success" role="alert" style="margin:12px 0;">
                    <strong>Public Customer Form URL</strong><br/>
                    <field name="public_form_url" readonly="1" widget="url" nolabel="1"
                           style="font-weight:700;font-size:14px;"/>
                    <br/><br/>
                    <small>
                        This URL is automatically generated from this database's
                        <strong>web.base.url</strong> system parameter.<br/>
                        On the live server it will show <strong>odoo.dubaiaudit.com</strong>;
                        on local it will show the local IP — no code changes needed.
                    </small>
                </div>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_contact_email_all_wizard" model="ir.actions.act_window">
        <field name="name">Email All Contacts</field>
        <field name="res_model">contact.email.all.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_contact_email_all_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="action_contact_public_form_url" model="ir.actions.act_window">
        <field name="name">Public Form Link</field>
        <field name="res_model">contact.email.all.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_contact_public_form_url_form"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_contact_email_all_rk"
        name="Email All"
        parent="contacts.res_partner_menu_config"
        action="action_contact_email_all_wizard"
        groups="base.group_system"
        sequence="50"/>

    <menuitem
        id="menu_contact_public_form_url_rk"
        name="Public Form Link"
        parent="contacts.res_partner_menu_config"
        action="action_contact_public_form_url"
        groups="base.group_system"
        sequence="51"/>

    <!-- ══════════════════════════════════════════════════════════
         No Email Address filter on Contacts list/search view
    ══════════════════════════════════════════════════════════ -->

    <record id="view_partner_filter_no_email_rk" model="ir.ui.view">
        <field name="name">res.partner.filter.no.email.rk</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter
                    string="No Email Address"
                    name="filter_no_email"
                    domain="['|', ('email', '=', False), ('email', '=', '')]"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         Contact form extensions
    ══════════════════════════════════════════════════════════ -->

    <record id="view_partner_form_inherit_rk" model="ir.ui.view">
        <field name="name">res.partner.form.extended.rk</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- ── Send form button in header ── -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_send_customer_form"
                            string="Send Customer Information Form"
                            type="object"
                            class="btn-primary"
                            icon="fa-paper-plane"/>
                </header>
            </xpath>

            <!-- ── Stat button: Forms Sent count ── -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_form_tokens"
                        icon="fa-file-text-o"
                        invisible="form_submission_count == 0">
                    <field name="form_submission_count" widget="statinfo" string="Forms Sent"/>
                </button>
            </xpath>

            <!-- ── Submission status banners ── -->
            <xpath expr="//div[@name='button_box']" position="after">

                <!-- GREEN: submitted + Download button -->
                <div invisible="form_submission_state != 'submitted'"
                     style="background:#d4edda;border:1px solid #b8dacc;border-radius:6px;padding:12px 18px;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;">
                    <span style="font-family:Arial,sans-serif;font-size:13px;color:#155724;">
                        <strong>&#10003; Customer Information Form Submitted</strong>
                        &#160;&#8212;&#160;
                        <field name="form_submitted_date" widget="datetime" readonly="1" nolabel="1"
                               style="display:inline;color:#155724;font-weight:600;"/>
                    </span>
                    <button name="action_download_form_submission"
                            type="object"
                            string=" Download PDF"
                            icon="fa-download"
                            class="btn btn-success btn-sm"
                            style="margin-left:16px;"/>
                </div>

                <!-- BLUE: sent, awaiting submission -->
                <div invisible="form_submission_state != 'pending'"
                     style="background:#cce5ff;border:1px solid #b8d4f5;border-radius:6px;padding:12px 18px;margin-bottom:12px;">
                    <span style="font-family:Arial,sans-serif;font-size:13px;color:#004085;">
                        <strong>&#128231; Customer Information Form Sent</strong>
                        &#160;&#8212;&#160; Awaiting customer submission.
                    </span>
                </div>

            </xpath>

            <!-- ── Identification Details fields ── -->
            <xpath expr="//sheet" position="inside">
                <group string="Identification Details" colspan="4">
                    <field name="emirates_id" string="Emirates ID"/>
                    <field name="passport_number" string="Passport Number"/>
                    <field name="company_license_no" string="Company License Number"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
