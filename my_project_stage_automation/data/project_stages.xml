<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Project-level Cancelled stage -->
        <record id="project_stage_cancelled" model="project.project.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">100</field>
            <field name="fold">True</field>
        </record>

        <!-- Task-level Cancelled stage (linked to projects at runtime) -->
        <record id="task_type_cancelled" model="project.task.type">
            <field name="name">Cancelled</field>
            <field name="sequence">100</field>
            <field name="fold">True</field>
        </record>

    </data>
</odoo>
