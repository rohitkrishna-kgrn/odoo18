<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Server action: contains the Python code to run -->
        <record id="action_server_cancel_so_projects" model="ir.actions.server">
            <field name="name">Cancel Projects/Tasks on SO Cancel</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">records.sudo()._cancel_linked_projects()</field>
        </record>

        <!-- Automation rule: watches for state → 'cancel' transition -->
        <record id="automation_cancel_projects_on_so_cancel" model="base.automation">
            <field name="name">Cancel Projects/Tasks when Sale Order is Cancelled</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="trigger">on_write</field>
            <field name="filter_pre_domain">[('state', '!=', 'cancel')]</field>
            <field name="filter_domain">[('state', '=', 'cancel')]</field>
            <field name="action_server_ids" eval="[(4, ref('action_server_cancel_so_projects'))]"/>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
