<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Daily cron: auto-syncs all cancelled SOs every day -->
    <record id="ir_cron_sync_cancelled_so_projects" model="ir.cron">
        <field name="name">Sync Cancelled SO Projects/Tasks</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model.action_sync_all_cancelled()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>
