<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <menuitem id="menu_employee_weightage_root"
              name="Weightage"
              parent="hr.menu_human_resources_configuration"
              sequence="50"/>

    <record id="view_employee_weightage_tree" model="ir.ui.view">
        <field name="name">employee.weightage.tree</field>
        <field name="model">employee.weightage</field>
        <field name="arch" type="xml">
            <list string="Employee Weightage">
                <field name="name"/>
                <field name="number"/>
            </list>
        </field>
    </record>

    <record id="view_employee_weightage_form" model="ir.ui.view">
        <field name="name">employee.weightage.form</field>
        <field name="model">employee.weightage</field>
        <field name="arch" type="xml">
            <form string="Employee Weightage">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="number"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_weightage" model="ir.actions.act_window">
        <field name="name">Weightage</field>
        <field name="res_model">employee.weightage</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_employee_weightage"
              name="Weightage"
              parent="menu_employee_weightage_root"
              action="action_employee_weightage"
              sequence="1"/>
</odoo>
