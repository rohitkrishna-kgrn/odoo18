<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mail_activity_type_form_ar_followup" model="ir.ui.view">
        <field name="name">mail.activity.type.form.ar.followup</field>
        <field name="model">mail.activity.type</field>
        <field name="inherit_id" ref="mail.mail_activity_type_view_form"/>
        <field name="arch" type="xml">
            <field name="category" position="after">
                <field name="ar_followup_method"/>
            </field>
        </field>
    </record>

    <record id="view_mail_activity_type_list_ar_followup" model="ir.ui.view">
        <field name="name">mail.activity.type.list.ar.followup</field>
        <field name="model">mail.activity.type</field>
        <field name="inherit_id" ref="mail.mail_activity_type_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="ar_followup_method" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
