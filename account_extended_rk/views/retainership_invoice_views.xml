<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_move_form_retainership" model="ir.ui.view">
            <field name="name">account.move.form.retainership</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="invoice_user_id" position="after">
                    <field name="is_retainership_auto" invisible="1"/>
                    <field name="retainership_contract_id"
                           invisible="not retainership_contract_id"/>
                    <label for="retainership_period_start" string="Retainership Period"
                           invisible="not retainership_contract_id"/>
                    <div class="o_row" invisible="not retainership_contract_id">
                        <field name="retainership_period_start" nolabel="1"/>
                        <span class="mx-2">to</span>
                        <field name="retainership_period_end" nolabel="1"/>
                    </div>
                </field>
            </field>
        </record>

        <record id="view_move_form_retainership_banner" model="ir.ui.view">
            <field name="name">account.move.form.retainership.banner</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="before">
                    <div class="alert alert-info" role="status"
                         invisible="not is_retainership_auto or state != 'draft'">
                        This draft was raised automatically from a retainership contract.
                        Check the client, period, fee and taxes, then
                        <strong>post it</strong> - posting is the finance approval, and only
                        then can it be sent to the client.
                    </div>
                </div>
            </field>
        </record>

        <record id="view_account_invoice_filter_retainership" model="ir.ui.view">
            <field name="name">account.move.select.retainership</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <separator/>
                    <filter string="Retainership (Auto-Generated)" name="filter_retainership_auto"
                            domain="[('is_retainership_auto', '=', True)]"/>
                    <filter string="Retainership Drafts to Review" name="filter_retainership_to_review"
                            domain="[('is_retainership_auto', '=', True), ('state', '=', 'draft')]"/>
                    <filter string="Retainership Contract" name="group_retainership_contract"
                            context="{'group_by': 'retainership_contract_id'}"/>
                </xpath>
            </field>
        </record>

        <record id="view_retainership_draft_list" model="ir.ui.view">
            <field name="name">account.move.retainership.draft.list</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <list string="Retainership Drafts to Review" create="false"
                      default_order="invoice_date asc">
                    <field name="name" string="Draft"/>
                    <field name="partner_id" string="Client"/>
                    <field name="retainership_contract_id"/>
                    <field name="invoice_date"/>
                    <field name="retainership_period_start" string="Period From"/>
                    <field name="retainership_period_end" string="Period To"/>
                    <field name="sale_order_line_id" optional="show"/>
                    <field name="ar_responsible_id" optional="show"/>
                    <field name="activity_ids" widget="list_activity" optional="show"/>
                    <field name="amount_untaxed" string="Untaxed" optional="hide"/>
                    <field name="amount_total" sum="Total"/>
                    <field name="currency_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="action_retainership_drafts_to_review" model="ir.actions.act_window">
            <field name="name">Retainership Drafts to Review</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_retainership_auto', '=', True), ('state', '=', 'draft'), ('move_type', '=', 'out_invoice')]</field>
            <field name="context">{'create': False, 'default_move_type': 'out_invoice'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Nothing waiting for review</p>
                <p>
                    Draft invoices raised by the retainership scheduler land here.
                    Review one, then post it - posting approves it for sending to the client.
                </p>
            </field>
        </record>

        <record id="action_retainership_drafts_view_list" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_retainership_draft_list"/>
            <field name="act_window_id" ref="action_retainership_drafts_to_review"/>
        </record>

        <record id="action_retainership_drafts_view_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="account.view_move_form"/>
            <field name="act_window_id" ref="action_retainership_drafts_to_review"/>
        </record>

        <menuitem id="menu_retainership_drafts_to_review"
                  name="Retainership Drafts to Review"
                  parent="account.menu_finance_receivables"
                  action="action_retainership_drafts_to_review"
                  sequence="7"/>

    </data>
</odoo>
