<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Daily sweep of unapproved draft customer invoices: warns the
             creator two days out, archives on day seven. Scheduled after the
             AR aging refresh (05:55) so both passes see the same day's data. -->
        <record id="cron_archive_stale_draft_invoices" model="ir.cron">
            <field name="name">Account Extended: Archive Unapproved Draft Invoices</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_archive_stale_draft_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(lambda n, t: t if t > n else t + timedelta(days=1))(datetime.now(), datetime.now().replace(hour=6, minute=15, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>
