<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Daily sweep of running retainership contracts. Billing is a pure
             date-clock event - nothing a user does triggers the next period -
             so a scheduled action is the only thing that can raise it.
             02:30 UTC = 06:30 Gulf Standard Time, so the drafts are already
             waiting when finance opens the invoice list. -->
        <record id="cron_generate_retainership_invoices" model="ir.cron">
            <field name="name">Retainership: Generate Draft Invoices</field>
            <field name="model_id" ref="model_retainership_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_retainership_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall"
                   eval="(lambda n, t: t if t &gt; n else t + timedelta(days=1))(datetime.now(), datetime.now().replace(hour=2, minute=30, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>
