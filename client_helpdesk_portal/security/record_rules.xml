<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            TICKET RECORD RULES
            Manager: sees all tickets (no domain restriction)
            Agent:   sees only tickets assigned to them
        -->

        <!-- Managers: unrestricted access to all tickets -->
        <record id="rule_ticket_manager_all" model="ir.rule">
            <field name="name">Helpdesk Ticket: Manager sees all</field>
            <field name="model_id" ref="model_client_helpdesk_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('client_helpdesk_portal.group_helpdesk_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Agents: see only tickets assigned to them -->
        <record id="rule_ticket_agent_assigned" model="ir.rule">
            <field name="name">Helpdesk Ticket: Agent sees assigned</field>
            <field name="model_id" ref="model_client_helpdesk_ticket"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('client_helpdesk_portal.group_helpdesk_agent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!--
            STAGE RECORD RULES
            Both Agent and Manager can read stages.
            Only Manager can create/write/unlink stages.
        -->

        <record id="rule_stage_manager_all" model="ir.rule">
            <field name="name">Helpdesk Stage: Manager full access</field>
            <field name="model_id" ref="model_client_helpdesk_stage"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('client_helpdesk_portal.group_helpdesk_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_stage_agent_read" model="ir.rule">
            <field name="name">Helpdesk Stage: Agent read only</field>
            <field name="model_id" ref="model_client_helpdesk_stage"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('client_helpdesk_portal.group_helpdesk_agent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>


    </data>
</odoo>
