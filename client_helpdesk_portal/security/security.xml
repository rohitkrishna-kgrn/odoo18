<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Category: noupdate=0 so visible=False is applied on every upgrade -->
    <data noupdate="0">
        <record id="module_category_helpdesk_portal" model="ir.module.category">
            <field name="name">Client Helpdesk</field>
            <field name="description">Manage client support tickets</field>
            <field name="sequence">50</field>
            <field name="visible" eval="False"/>
        </record>
    </data>

    <!-- Groups: noupdate=1 so user assignments are not reset on upgrade -->
    <data noupdate="1">

        <!-- Helpdesk User group (formerly "Helpdesk Agent" — id/comments below
             still say agent internally, only the displayed name changed) -->
        <record id="group_helpdesk_agent" model="res.groups">
            <field name="name">Helpdesk User</field>
            <field name="category_id" ref="module_category_helpdesk_portal"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view and manage assigned tickets, update stages, add notes.</field>
        </record>

        <!-- Helpdesk Manager group (implies Helpdesk User, which implies base.group_user) -->
        <record id="group_helpdesk_manager" model="res.groups">
            <field name="name">Helpdesk Manager</field>
            <field name="category_id" ref="module_category_helpdesk_portal"/>
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_agent'))]"/>
            <field name="comment">Access to tickets within their reporting hierarchy and reporting. Can reassign tickets only to their own team members with Select Access enabled. Cannot configure stages or change the Helpdesk Admin.</field>
        </record>

        <!-- Helpdesk Admin group (implies Manager, which implies Helpdesk User, which implies base.group_user).
             Membership is kept to a single user, synced from the Helpdesk Admin
             setting (see models/res_config_settings.py). -->
        <record id="group_helpdesk_admin" model="res.groups">
            <field name="name">Helpdesk Admin</field>
            <field name="category_id" ref="module_category_helpdesk_portal"/>
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_manager'))]"/>
            <field name="comment">Unrestricted access to all tickets. Can reassign tickets to any user with Select Access enabled, configure stages, and configure who the Helpdesk Admin is.</field>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
