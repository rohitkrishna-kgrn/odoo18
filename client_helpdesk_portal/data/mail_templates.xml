<div style="margin:0;padding:0;background:#f4f6f9;font-family:Arial,Helvetica,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f9;">
<tr><td align="center" style="padding:24px 12px;">
<table width="620" cellpadding="0" cellspacing="0"
       style="background:#ffffff;border:1px solid #dde2e8;border-radius:10px;overflow:hidden;">

  <tr>
    <td style="background:#003366;padding:28px 30px;text-align:center;">
      <img src="https://kompanyservices.com/wp-content/uploads/logo-kgrn.png"
           alt="KGRN" width="90" height="90" style="display:block;margin:0 auto 12px;"/>
      <p style="margin:0;color:#ffffff;font-size:13px;letter-spacing:1px;text-transform:uppercase;opacity:.8;">
        Ticket Assignment Update
      </p>
    </td>
  </tr>

  <tr>
    <td style="padding:32px 36px 24px;">
      <h2 style="margin:0 0 8px;color:#003366;font-size:20px;font-weight:700;">
        Ticket Assigned to <t t-out="object.user_id.name"/>
      </h2>
      <p style="margin:0 0 24px;color:#555555;font-size:14px;line-height:1.6;">
        Ticket <strong>#<t t-out="object.ticket_number"/></strong> has been
        assigned to <strong><t t-out="object.user_id.name"/></strong>.
        Please find the ticket details below.
      </p>

      <table width="100%" cellpadding="0" cellspacing="0"
             style="background:#f0f6ff;border-left:5px solid #0057b8;border-radius:6px;margin-bottom:24px;">
        <tr>
          <td style="padding:12px 18px;font-size:14px;border-bottom:1px solid #dde8f7;">
            <span style="display:inline-block;min-width:160px;font-weight:600;color:#004080;">Ticket #:</span>
            <strong style="color:#003366;"><t t-out="object.ticket_number"/></strong>
          </td>
        </tr>
        <tr>
          <td style="padding:12px 18px;font-size:14px;border-bottom:1px solid #dde8f7;">
            <span style="display:inline-block;min-width:160px;font-weight:600;color:#004080;">Subject:</span>
            <t t-out="object.subject"/>
          </td>
        </tr>
        <tr>
          <td style="padding:12px 18px;font-size:14px;border-bottom:1px solid #dde8f7;">
            <span style="display:inline-block;min-width:160px;font-weight:600;color:#004080;">Client:</span>
            <t t-out="object.client_name"/>
          </td>
        </tr>
        <tr>
          <td style="padding:12px 18px;font-size:14px;border-bottom:1px solid #dde8f7;">
            <span style="display:inline-block;min-width:160px;font-weight:600;color:#004080;">Assigned To:</span>
            <strong><t t-out="object.user_id.name"/></strong>
            (<t t-out="object.user_id.email or '—'"/>)
          </td>
        </tr>
        <tr>
          <td style="padding:12px 18px;font-size:14px;border-bottom:1px solid #dde8f7;">
            <span style="display:inline-block;min-width:160px;font-weight:600;color:#004080;">Request Type:</span>
            <t t-out="object.request_type_label"/>
          </td>
        </tr>
        <tr>
          <td style="padding:12px 18px;font-size:14px;border-bottom:1px solid #dde8f7;">
            <span style="display:inline-block;min-width:160px;font-weight:600;color:#004080;">Priority:</span>
            <t t-out="object.priority_label"/>
          </td>
        </tr>
        <tr>
          <td style="padding:12px 18px;font-size:14px;">
            <span style="display:inline-block;min-width:160px;font-weight:600;color:#004080;">Current Stage:</span>
            <t t-out="object.stage_id.name or '—'"/>
          </td>
        </tr>
      </table>

      <p style="margin:0;color:#666666;font-size:13px;">
        Please ensure the ticket is progressed in a timely manner.
      </p>
    </td>
  </tr>

  <tr>
    <td style="background:#f5f7fa;padding:16px 36px;text-align:center;border-top:1px solid #e8ecf0;">
      <p style="margin:0;font-size:12px;color:#999999;">
        &copy; <t t-out="object.company_id.name"/> &nbsp;|&nbsp;
        <a t-att-href="'mailto:' + (object.company_id.email or 'support@kgrnaudit.com')"
           style="color:#0057b8;text-decoration:none;">
          <t t-out="object.company_id.email or 'support@kgrnaudit.com'"/>
        </a>
      </p>
    </td>
  </tr>

</table>
</td></tr>
</table>
</div>
    ]]></field>
    <field name="auto_delete" eval="True"/>
</record>

</data>
</odoo>
