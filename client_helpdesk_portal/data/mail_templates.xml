<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

<!-- ══════════════════════════════════════════════════════════
     NOTE: In Odoo 18, mail.template body_html uses QWeb rendering
     (render_engine='qweb' on the field definition).
     Use <t t-out="..."/> for values and <t t-if="..."> for conditionals.
     subject / email_from / email_to are fields.Char and still use Jinja2.
══════════════════════════════════════════════════════════ -->

<!-- ══════════════════════════════════════════════════════════
     1. CLIENT ACKNOWLEDGEMENT — sent when ticket is created
══════════════════════════════════════════════════════════ -->
<record id="mail_template_ticket_acknowledgement" model="mail.template">
    <field name="name">Helpdesk: Ticket Acknowledgement to Client</field>
    <field name="model_id" ref="model_client_helpdesk_ticket"/>
    <field name="subject">[#{{ object.ticket_number }}] Support Request Received – {{ object.subject }}</field>
    <field name="email_from">{{ object.company_id.email or 'noreply@kgrnaudit.com' }}</field>
    <field name="email_to">{{ object.email }}</field>
    <field name="body_html"><![CDATA[
<div style="margin:0;padding:0;background:#f4f6f9;font-family:Arial,Helvetica,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f9;">
<tr><td align="center" style="padding:24px 12px;">
<table width="620" cellpadding="0" cellspacing="0"
       style="background:#ffffff;border:1px solid #dde2e8;border-radius:10px;overflow:hidden;">

  <tr>
    <td style="background:#003366;padding:28px 30px;text-align:center;">
      <img src="https://kompanyservices.com/wp-content/uploads/logo-kgrn.png"
           alt="KGRN Chartered Accountants" width="90" height="90"
           style="display:block;margin:0 auto 12px;"/>
      <p style="margin:0;color:#ffffff;font-size:13px;letter-spacing:1px;text-transform:uppercase;opacity:.8;">
        Support Center
      </p>
    </td>
  </tr>

  <tr>
    <td style="padding:32px 36px 24px;">
      <h2 style="margin:0 0 8px;color:#003366;font-size:22px;font-weight:700;">
        Thank you, <t t-out="object.client_name"/>!
      </h2>
      <p style="margin:0 0 24px;color:#555555;font-size:14px;line-height:1.6;">
        We have received your support request and our team will review it shortly.
        Your ticket reference is shown below — please keep it for any follow-up.
      </p>

      <table width="100%" cellpadding="0" cellspacing="0"
             style="background:#f0f6ff;border-left:5px solid #0057b8;border-radius:6px;margin-bottom:24px;">
        <tr>
          <td style="padding:14px 18px;font-size:14px;color:#333333;border-bottom:1px solid #dde8f7;">
            <span style="display:inline-block;min-width:160px;font-weight:600;color:#004080;">Ticket Number:</span>
            <strong style="color:#003366;"><t t-out="object.ticket_number"/></strong>
          </td>
        </tr>
        <tr>
          <td style="padding:14px 18px;font-size:14px;color:#333333;border-bottom:1px solid #dde8f7;">
            <span style="display:inline-block;min-width:160px;font-weight:600;color:#004080;">Subject:</span>
            <t t-out="object.subject"/>
          </td>
        </tr>
        <tr>
          <td style="padding:14px 18px;font-size:14px;color:#333333;border-bottom:1px solid #dde8f7;">
            <span style="display:inline-block;min-width:160px;font-weight:600;color:#004080;">Request Type:</span>
            <t t-out="object.request_type_label"/>
          </td>
        </tr>
        <tr>
          <td style="padding:14px 18px;font-size:14px;color:#333333;border-bottom:1px solid #dde8f7;">
            <span style="display:inline-block;min-width:160px;font-weight:600;color:#004080;">Priority:</span>
            <t t-out="object.priority_label"/>
          </td>
        </tr>
        <tr>
          <td style="padding:14px 18px;font-size:14px;color:#333333;">
            <span style="display:inline-block;min-width:160px;font-weight:600;color:#004080;">Submitted On:</span>
            <t t-out="object.created_date.strftime('%d %b %Y at %H:%M') if object.created_date else ''"/> UTC
          </td>
        </tr>
      </table>

      <p style="margin:0;color:#666666;font-size:13px;line-height:1.6;">
        Our support team typically responds within <strong>1&#8211;2 business days</strong>.
        If you need to follow up, please quote your ticket number
        <strong style="color:#003366;"><t t-out="object.ticket_number"/></strong>.
      </p>
    </td>
  </tr>

  <tr>
    <td style="background:#f5f7fa;padding:16px 36px;text-align:center;border-top:1px solid #e8ecf0;">
      <p style="margin:0;font-size:12px;color:#999999;">
        &copy; <t t-out="object.company_id.name"/> &nbsp;|&nbsp;
        <a t-att-href="'mailto:' + (object.company_id.email or 'support@kgrnaudit.com')"
           style="color:#0057b8;text-decoration:none;">
          <t t-out="object.company_id.email or 'support@kgrnaudit.com'"/>
        </a>
        <t t-if="object.company_id.phone">&nbsp;|&nbsp;<t t-out="object.company_id.phone"/></t>
      </p>
    </td>
  </tr>

</table>
</td></tr>
</table>
</div>
    ]]></field>
    <field name="auto_delete" eval="True"/>
</record>


