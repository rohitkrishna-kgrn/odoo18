<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Runs daily at 09:00 GST (05:00 UTC) — nextcall below is just
             the initial placeholder Odoo requires on record creation;
             the real 09:00 GST scheduling is set programmatically (see
             __init__.py's post_init_hook and migrations/18.0.2.37.0),
             since ir.cron.nextcall is a plain absolute datetime with no
             "time of day" pattern to express in XML.
             Reminds the Assigned User while a ticket sits in New (since
             created_date) or Reopened (since reopened_date), every 2
             days. See client.helpdesk.ticket._cron_send_stage_reminders(). -->
        <record id="cron_helpdesk_stage_reminders" model="ir.cron">
            <field name="name">Helpdesk: New/Reopened Stage Reminders</field>
            <field name="model_id" ref="model_client_helpdesk_ticket"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_stage_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
