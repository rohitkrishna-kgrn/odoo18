<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Stage list view -->
    <record id="view_helpdesk_stage_list" model="ir.ui.view">
        <field name="name">client.helpdesk.stage.list</field>
        <field name="model">client.helpdesk.stage</field>
        <field name="arch" type="xml">
            <list string="Helpdesk Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="is_closed"/>
                <field name="ticket_count" string="Tickets"/>
            </list>
        </field>
    </record>

    <!-- Stage form view -->
    <record id="view_helpdesk_stage_form" model="ir.ui.view">
        <field name="name">client.helpdesk.stage.form</field>
        <field name="model">client.helpdesk.stage</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="fold"/>
                            <field name="is_closed"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Stage action -->
    <record id="action_helpdesk_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">client.helpdesk.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stages defined yet.</p>
            <p>Create stages to define your helpdesk ticket pipeline.</p>
        </field>
    </record>

</odoo>
