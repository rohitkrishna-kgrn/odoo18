<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         PIVOT VIEW
    ════════════════════════════════════════════════════════════════════ -->
    <record id="view_helpdesk_ticket_pivot" model="ir.ui.view">
        <field name="name">client.helpdesk.ticket.pivot</field>
        <field name="model">client.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <pivot string="Ticket Analysis" disable_linking="false">
                <field name="stage_id" type="row"/>
                <field name="manager_id" type="row"/>
                <field name="user_id" type="row"/>
                <field name="request_type" type="col"/>
                <field name="priority" type="col"/>
                <field name="ticket_number" type="measure" string="Count"/>
            </pivot>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         GRAPH VIEW
    ════════════════════════════════════════════════════════════════════ -->
    <record id="view_helpdesk_ticket_graph" model="ir.ui.view">
        <field name="name">client.helpdesk.ticket.graph</field>
        <field name="model">client.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <graph string="Ticket Analysis" type="bar" stacked="1">
                <field name="stage_id" type="row"/>
                <field name="user_id" type="row"/>
                <field name="request_type" type="col"/>
            </graph>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         REPORTING ACTION
    ════════════════════════════════════════════════════════════════════ -->
    <record id="action_helpdesk_report" model="ir.actions.act_window">
        <field name="name">Ticket Analysis</field>
        <field name="res_model">client.helpdesk.ticket</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_helpdesk_ticket_search"/>
        <field name="context">{}</field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         DASHBOARD ACTION (reuses kanban/list with KPI counts via context)
    ════════════════════════════════════════════════════════════════════ -->
    <record id="action_helpdesk_dashboard" model="ir.actions.act_window">
        <field name="name">Helpdesk Overview</field>
        <field name="res_model">client.helpdesk.ticket</field>
        <field name="view_mode">list,kanban,graph,pivot</field>
        <field name="search_view_id" ref="view_helpdesk_ticket_search"/>
        <field name="context">{'search_default_group_stage': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No data yet.</p>
        </field>
    </record>

</odoo>
