<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_inherit_closure_invoice" model="ir.ui.view">
        <field name="name">project.project.form.inherit.closure.invoice</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Invoice Confirmation" name="closure_invoice">
                    <group>
                        <field name="closure_invoice_confirmed" widget="boolean_toggle" readonly="1"/>
                        <group>
                            <field name="closure_invoice_type" readonly="not is_closure_pm"/>
                            <!-- default_move_type drives the Invoice Type column, which
                                 account_extended_rk adds to the invoice list globally and
                                 hides unless the context marks this an out_invoice / out_refund
                                 list. This module used to ship its own inherited list view for
                                 that column, but inheriting account.view_invoice_tree leaked a
                                 duplicate Invoice Type column into the whole Accounting list. -->
                            <field name="closure_invoice_move_id"
                                   readonly="not is_closure_pm"
                                   invisible="closure_invoice_type != 'odoo'"
                                   domain="[('move_type', '=', 'out_invoice'), ('partner_id', '=', partner_id), ('state', '=', 'posted'), '|', ('sale_order_line_id.project_id', '=', id), ('service_engagement_id', '=', id)]"
                                   context="{'default_move_type': 'out_invoice'}"/>
                            <field name="partner_id" invisible="1"/>
                            <field name="closure_group_invoice_number"
                                   readonly="not is_closure_pm"
                                   invisible="closure_invoice_type != 'group_company'"/>
                            <field name="closure_group_invoice_date"
                                   readonly="not is_closure_pm"
                                   invisible="closure_invoice_type != 'group_company'"/>
                            <field name="closure_group_invoice_value"
                                   readonly="not is_closure_pm"
                                   invisible="closure_invoice_type != 'group_company'"/>
                            <field name="closure_group_invoice_document"
                                   filename="closure_group_invoice_document_name"
                                   readonly="not is_closure_pm"
                                   invisible="closure_invoice_type != 'group_company'"/>
                            <field name="closure_group_invoice_document_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="closure_invoice_confirmed_by"/>
                            <field name="closure_invoice_confirmed_date"/>
                        </group>
                        <field name="is_closure_pm" invisible="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
