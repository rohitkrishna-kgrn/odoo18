<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="age_r_pm_template" owl="1">
        <div class="container">
            <div class="fin_report">

                <!-- ════════════════════════════════════════════
                     FILTER / TOOLBAR BAR
                ════════════════════════════════════════════ -->
                <div class="filter_view_gl pt-3 pb-5">
                    <div>
                        <h1 class="text-uppercase" style="padding:10px;">
                            <t t-esc="props.action.name"/>
                        </h1>
                    </div>

                    <div style="margin:0 10px 15px;display:flex;align-items:center;flex-wrap:wrap;gap:8px;">

                        <!-- Print / Export buttons -->
                        <div style="flex:1;min-width:200px;">
                            <button type="button" class="btn btn-primary btn-report-print"
                                    style="margin-right:8px;" t-on-click="printPdf">
                                Print (PDF)
                            </button>
                            <button type="button" class="btn btn-primary btn-report-print"
                                    t-on-click="print_xlsx">
                                Export (XLSX)
                            </button>
                        </div>

                        <!-- ── Date Range ── -->
                        <div class="time_range">
                            <a type="button" class="dropdown-toggle" data-bs-toggle="dropdown">
                                <span class="fa fa-calendar" role="img" aria-label="Dates"/>
                                Date Range
                            </a>
                            <div class="dropdown-menu" role="menu">
                                <div class="list-group">
                                    <button class="report-filter-button" data-value="today"
                                            type="button" t-on-click="applyDateFilter">Today</button>
                                    <button class="report-filter-button" data-value="last-month-end"
                                            type="button" t-on-click="applyDateFilter">End of Last Month</button>
                                    <button class="report-filter-button" data-value="last-quarter-end"
                                            type="button" t-on-click="applyDateFilter">End of Last Quarter</button>
                                    <button class="report-filter-button" data-value="last-year-end"
                                            type="button" t-on-click="applyDateFilter">End of Last Year</button>
                                    <div role="separator" class="dropdown-divider"/>
                                    <label for="pm_start_date" style="font-weight:600;margin-bottom:2px;">From:</label>
                                    <input type="date" id="pm_start_date" t-ref="date_from"
                                           t-on-input="onDateInput"
                                           style="border:none;border-bottom:1px solid #000;padding:5px;outline:none;width:100%;"/>
                                    <label for="pm_end_date" style="font-weight:600;margin-top:6px;margin-bottom:2px;">To:</label>
                                    <input type="date" id="pm_end_date" t-ref="date_to"
                                           t-on-input="onDateInput"
                                           style="border:none;border-bottom:1px solid #000;padding:5px;outline:none;width:100%;"/>
                                </div>
                            </div>
                        </div>

                        <!-- ── Project Manager Filter ── -->
                        <div style="position:relative;">
                            <a type="button" class="dropdown-toggle" data-bs-toggle="dropdown">
                                <span class="fa fa-user" role="img" aria-label="Project Manager"/>
                                Project Manager
                            </a>
                            <div class="dropdown-menu" role="menu" style="min-width:220px;">
                                <div class="list-group" style="max-height:220px;overflow-y:auto;">
                                    <t t-if="state.pm_options.length">
                                        <t t-foreach="state.pm_options" t-as="pm"
                                           t-key="pm.id">
                                            <button type="button"
                                                    t-attf-class="report-filter-button #{state.selected_pm.includes(pm.id) ? 'selected-filter' : ''}"
                                                    t-on-click="() => selectPm(pm)">
                                                <t t-esc="pm.name"/>
                                                <t t-if="state.selected_pm.includes(pm.id)">
                                                    <span class="fa fa-check" style="margin-left:6px;"/>
                                                </t>
                                            </button>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <span style="padding:8px;color:#888;">No project managers found</span>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- ── Group By ── -->
                        <div class="option">
                            <a type="button" class="dropdown-toggle" data-bs-toggle="dropdown">
                                <span class="fa fa-th-list" role="img" aria-label="Group By"/>
                                Group By
                            </a>
                            <div class="dropdown-menu" role="menu">
                                <div class="list-group">
                                    <button type="button"
                                            t-attf-class="report-filter-button #{state.group_by_pm ? 'selected-filter' : ''}"
                                            t-on-click="toggleGroupByPm">
                                        Project Manager
                                        <t t-if="state.group_by_pm">
                                            <span class="fa fa-check" style="margin-left:6px;"/>
                                        </t>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- ── Options ── -->
                        <div class="option">
                            <a type="button" class="dropdown-toggle" data-bs-toggle="dropdown">
                                <span class="fa fa-glass" role="img" aria-label="Options"/>
                                Options
                            </a>
                            <div class="dropdown-menu" role="menu">
                                <div class="list-group">
                                    <button class="report-filter-button" type="button"
                                            t-on-click="unfoldAll">Unfold All</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Active PM filter tags -->
                    <t t-if="state.selected_pm_rec.length">
                        <div style="margin:0 10px 10px;display:flex;flex-wrap:wrap;gap:6px;align-items:center;">
                            <span style="font-weight:600;font-size:12px;">Project Manager:</span>
                            <t t-foreach="state.selected_pm_rec" t-as="pm" t-key="pm.id">
                                <span class="badge bg-primary" style="font-size:12px;padding:4px 8px;">
                                    <t t-esc="pm.name"/>
                                    <button type="button"
                                            style="background:none;border:none;color:#fff;margin-left:6px;cursor:pointer;font-size:14px;line-height:1;"
                                            t-on-click="() => removePm(pm)">×</button>
                                </span>
                            </t>
                        </div>
                    </t>

                    <!-- Group-by indicator -->
                    <t t-if="state.group_by_pm">
                        <div style="margin:0 10px 10px;">
                            <span class="badge bg-info text-dark" style="font-size:12px;padding:4px 8px;">
                                Grouped by: Project Manager
                            </span>
                        </div>
                    </t>
                </div>
            </div>

            <br/>

            <!-- ════════════════════════════════════════════
                 REPORT TABLE
            ════════════════════════════════════════════ -->
            <div class="table_style"
                 style="max-height:calc(100vh - 300px);overflow-y:auto;overflow-x:auto;">
                <div class="table_view_gl" style="width:100%;">
                    <div class="table_main_view">
                        <table cellspacing="0" width="100%">

                            <!-- Common table header -->
                            <thead>
                                <tr class="o_heading">
                                    <th colspan="6"/>
                                    <th>Invoice Date</th>
                                    <th>Amount Currency</th>
                                    <th>Currency</th>
                                    <th>Account</th>
                                    <th>Expected Date</th>
                                    <th>At Date</th>
                                    <th>1-30</th>
                                    <th>31-60</th>
                                    <th>61-90</th>
                                    <th>91-120</th>
                                    <th>Older</th>
                                    <th>Total</th>
                                </tr>
                            </thead>

                            <tbody t-ref="tbody">

                                <!-- ══════════════════════════════
                                     PM-GROUPED MODE
                                ══════════════════════════════ -->
                                <t t-if="state.grouped and state.pm_list and state.pm_list.length">
                                    <t t-set="pm_idx" t-value="0"/>
                                    <t t-foreach="state.pm_list" t-as="pm_name"
                                       t-key="pm_name_index">
                                        <t t-set="pm_idx" t-value="pm_idx + 1"/>

                                        <!-- PM header -->
                                        <tr style="background:#4472C4;color:#fff;">
                                            <th colspan="18" style="padding:8px;">
                                                <span class="fa fa-briefcase" style="margin-right:6px;"/>
                                                Project Manager:
                                                <strong><t t-esc="pm_name"/></strong>
                                            </th>
                                        </tr>

                                        <!-- Partners under this PM -->
                                        <t t-if="state.pm_data[pm_name]">
                                            <t t-set="pi" t-value="0"/>
                                            <t t-foreach="state.pm_data[pm_name].partner_list"
                                               t-as="partner_name"
                                               t-key="partner_name_index">
                                                <t t-set="pi" t-value="pi + 1"/>
                                                <t t-set="collapse_id"
                                                   t-value="`pm${pm_idx}_p${pi}`"/>

                                                <!-- Partner row (always visible, collapsible children) -->
                                                <tr class="border-bottom border-dark">
                                                    <th>
                                                        <div data-bs-toggle="collapse"
                                                             t-attf-href="#{{collapse_id}}"
                                                             aria-expanded="false"
                                                             t-attf-aria-controls="{{collapse_id}}"
                                                             class="ms-3 collapsed">
                                                            <a class="btn header o_heading">
                                                                <span class="toggle-icon">
                                                                    <i class="fa fa-caret-down"/>
                                                                </span>
                                                                <t t-esc="partner_name"/>
                                                            </a>
                                                        </div>
                                                    </th>
                                                    <th colspan="5">
                                                        <button
                                                            t-att-data-id="state.pm_data[pm_name].partner_totals[partner_name]['partner_id']"
                                                            class="btn bg-secondary"
                                                            style="margin-left:3px;"
                                                            t-on-click="openPartner">
                                                            <i class="fa fa-arrow-right"/> Open
                                                        </button>
                                                        <button
                                                            t-att-data-id="state.pm_data[pm_name].partner_totals[partner_name]['partner_id']"
                                                            class="btn bg-secondary"
                                                            style="margin-left:3px;"
                                                            t-on-click="gotoJournalItem">
                                                            <i class="fa fa-arrow-right"/> Journal Items
                                                        </button>
                                                    </th>
                                                    <th/><th/><th/><th/><th/>
                                                    <!-- Partner aging totals -->
                                                    <t t-set="pt"
                                                       t-value="state.pm_data[pm_name].partner_totals[partner_name]"/>
                                                    <th><t t-if="pt.diff0_sum" t-esc="pt.currency_id"/><t t-if="pt.diff0_sum" t-esc="pt.diff0_sum_display"/></th>
                                                    <th><t t-if="pt.diff1_sum" t-esc="pt.currency_id"/><t t-if="pt.diff1_sum" t-esc="pt.diff1_sum_display"/></th>
                                                    <th><t t-if="pt.diff2_sum" t-esc="pt.currency_id"/><t t-if="pt.diff2_sum" t-esc="pt.diff2_sum_display"/></th>
                                                    <th><t t-if="pt.diff3_sum" t-esc="pt.currency_id"/><t t-if="pt.diff3_sum" t-esc="pt.diff3_sum_display"/></th>
                                                    <th><t t-if="pt.diff4_sum" t-esc="pt.currency_id"/><t t-if="pt.diff4_sum" t-esc="pt.diff4_sum_display"/></th>
                                                    <th><t t-if="pt.diff5_sum" t-esc="pt.currency_id"/><t t-if="pt.diff5_sum" t-esc="pt.diff5_sum_display"/></th>
                                                    <th><t t-if="pt.debit_sum" t-esc="pt.currency_id"/><t t-if="pt.debit_sum" t-esc="pt.debit_sum_display"/></th>
                                                </tr>

                                                <!-- Move lines (collapsed) -->
                                                <t t-foreach="state.pm_data[pm_name].partner_data[partner_name]"
                                                   t-as="vl"
                                                   t-key="vl_index">
                                                    <tr class="border-bottom border-gainsboro collapse"
                                                        t-att-id="collapse_id">
                                                        <th colspan="6">
                                                            <span style="gap:12px;display:flex;">
                                                                <t t-if="vl['move_name']">
                                                                    <t t-esc="vl['move_name']"/>
                                                                </t>
                                                                <a type="button" class="dropdown-toggle"
                                                                   data-bs-toggle="dropdown"/>
                                                                <div class="dropdown-menu journals">
                                                                    <button t-att-data-id="vl['move_id'][0]"
                                                                            type="button"
                                                                            t-on-click="gotoJournalEntry"
                                                                            style="border:none;background:inherit;padding:4px 8px;font-size:16px;cursor:pointer;display:inline-block;">
                                                                        View Journal Entry
                                                                    </button>
                                                                </div>
                                                            </span>
                                                        </th>
                                                        <th><t t-esc="vl['date']"/></th>
                                                        <th><t t-esc="vl['amount_currency']"/></th>
                                                        <th><t t-esc="vl['currency_id'][1]"/></th>
                                                        <th><t t-esc="vl['account_id'][1]"/></th>
                                                        <th><t t-if="vl['date_maturity']" t-esc="vl['date_maturity']"/></th>
                                                        <th><t t-if="vl['diff0']" t-esc="state.pm_data[pm_name].partner_totals[partner_name]['currency_id']"/><t t-if="vl['diff0']" t-esc="vl['diff0']"/></th>
                                                        <th><t t-if="vl['diff1']" t-esc="state.pm_data[pm_name].partner_totals[partner_name]['currency_id']"/><t t-if="vl['diff1']" t-esc="vl['diff1']"/></th>
                                                        <th><t t-if="vl['diff2']" t-esc="state.pm_data[pm_name].partner_totals[partner_name]['currency_id']"/><t t-if="vl['diff2']" t-esc="vl['diff2']"/></th>
                                                        <th><t t-if="vl['diff3']" t-esc="state.pm_data[pm_name].partner_totals[partner_name]['currency_id']"/><t t-if="vl['diff3']" t-esc="vl['diff3']"/></th>
                                                        <th><t t-if="vl['diff4']" t-esc="state.pm_data[pm_name].partner_totals[partner_name]['currency_id']"/><t t-if="vl['diff4']" t-esc="vl['diff4']"/></th>
                                                        <th><t t-if="vl['diff5']" t-esc="state.pm_data[pm_name].partner_totals[partner_name]['currency_id']"/><t t-if="vl['diff5']" t-esc="vl['diff5']"/></th>
                                                        <th/>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>

                                        <!-- PM subtotal row -->
                                        <t t-set="pmt" t-value="state.pm_totals[pm_name]"/>
                                        <tr class="o_heading" style="background:#cce5ff;border-top:2px solid #4472C4;">
                                            <th colspan="11" class="o_heading" style="padding:6px 12px;">
                                                Subtotal – <t t-esc="pm_name"/>
                                            </th>
                                            <th class="o_heading"><t t-esc="pmt.currency_id"/><t t-esc="pmt.diff0_sum_display"/></th>
                                            <th class="o_heading"><t t-esc="pmt.currency_id"/><t t-esc="pmt.diff1_sum_display"/></th>
                                            <th class="o_heading"><t t-esc="pmt.currency_id"/><t t-esc="pmt.diff2_sum_display"/></th>
                                            <th class="o_heading"><t t-esc="pmt.currency_id"/><t t-esc="pmt.diff3_sum_display"/></th>
                                            <th class="o_heading"><t t-esc="pmt.currency_id"/><t t-esc="pmt.diff4_sum_display"/></th>
                                            <th class="o_heading"><t t-esc="pmt.currency_id"/><t t-esc="pmt.diff5_sum_display"/></th>
                                            <th class="o_heading"><t t-esc="pmt.currency_id"/><t t-esc="pmt.debit_sum_display"/></th>
                                        </tr>
                                    </t>
                                </t>

                                <!-- ══════════════════════════════
                                     FLAT PARTNER MODE
                                ══════════════════════════════ -->
                                <t t-if="!state.grouped and state.move_line">
                                    <t t-set="i" t-value="0"/>
                                    <t t-foreach="state.move_line" t-as="move_line"
                                       t-key="move_line_index">
                                        <t t-set="i" t-value="i + 1"/>
                                        <tr class="border-bottom border-dark border-gainsboro">
                                            <th>
                                                <div data-bs-toggle="collapse"
                                                     t-attf-href="#move_line-{{i}}"
                                                     aria-expanded="false"
                                                     t-attf-aria-controls="move_line-{{i}}"
                                                     class="ms-3 collapsed">
                                                    <a class="btn header o_heading">
                                                        <span class="toggle-icon"><i class="fa fa-caret-down"/></span>
                                                        <t t-esc="move_line"/>
                                                    </a>
                                                </div>
                                            </th>
                                            <th colspan="5">
                                                <button t-att-data-id="state.total[move_line]['partner_id']"
                                                        class="btn bg-secondary" style="margin-left:3px;"
                                                        t-on-click="openPartner">
                                                    <i class="fa fa-arrow-right"/> Open
                                                </button>
                                                <button t-att-data-id="state.total[move_line]['partner_id']"
                                                        class="btn bg-secondary" style="margin-left:3px;"
                                                        t-on-click="gotoJournalItem">
                                                    <i class="fa fa-arrow-right"/> Journal Items
                                                </button>
                                            </th>
                                            <th/><th/><th/><th/><th/>
                                            <th><t t-if="state.total[move_line]['diff0_sum']" t-esc="state.total[move_line]['currency_id']"/><t t-if="state.total[move_line]['diff0_sum']" t-esc="state.total[move_line]['diff0_sum_display']"/></th>
                                            <th><t t-if="state.total[move_line]['diff1_sum']" t-esc="state.total[move_line]['currency_id']"/><t t-if="state.total[move_line]['diff1_sum']" t-esc="state.total[move_line]['diff1_sum_display']"/></th>
                                            <th><t t-if="state.total[move_line]['diff2_sum']" t-esc="state.total[move_line]['currency_id']"/><t t-if="state.total[move_line]['diff2_sum']" t-esc="state.total[move_line]['diff2_sum_display']"/></th>
                                            <th><t t-if="state.total[move_line]['diff3_sum']" t-esc="state.total[move_line]['currency_id']"/><t t-if="state.total[move_line]['diff3_sum']" t-esc="state.total[move_line]['diff3_sum_display']"/></th>
                                            <th><t t-if="state.total[move_line]['diff4_sum']" t-esc="state.total[move_line]['currency_id']"/><t t-if="state.total[move_line]['diff4_sum']" t-esc="state.total[move_line]['diff4_sum_display']"/></th>
                                            <th><t t-if="state.total[move_line]['diff5_sum']" t-esc="state.total[move_line]['currency_id']"/><t t-if="state.total[move_line]['diff5_sum']" t-esc="state.total[move_line]['diff5_sum_display']"/></th>
                                            <th><t t-if="state.total[move_line]['debit_sum']" t-esc="state.total[move_line]['currency_id']"/><t t-if="state.total[move_line]['debit_sum']" t-esc="state.total[move_line]['debit_sum_display']"/></th>
                                        </tr>

                                        <!-- Move lines under partner -->
                                        <t t-foreach="state.data[move_line]" t-as="valuelist"
                                           t-key="valuelist_index">
                                            <tr class="border-bottom border-gainsboro collapse"
                                                t-attf-id="move_line-{{i}}">
                                                <th colspan="6">
                                                    <span style="gap:12px;display:flex;">
                                                        <t t-if="valuelist['move_name']">
                                                            <t t-esc="valuelist['move_name']"/>
                                                        </t>
                                                        <a type="button" class="dropdown-toggle"
                                                           data-bs-toggle="dropdown"/>
                                                        <div class="dropdown-menu journals">
                                                            <button t-att-data-id="valuelist['move_id'][0]"
                                                                    type="button"
                                                                    t-on-click="gotoJournalEntry"
                                                                    style="border:none;background:inherit;padding:4px 8px;font-size:16px;cursor:pointer;display:inline-block;">
                                                                View Journal Entry
                                                            </button>
                                                        </div>
                                                    </span>
                                                </th>
                                                <th><t t-esc="valuelist['date']"/></th>
                                                <th><t t-esc="valuelist['amount_currency']"/></th>
                                                <th><t t-esc="valuelist['currency_id'][1]"/></th>
                                                <th><t t-esc="valuelist['account_id'][1]"/></th>
                                                <th><t t-if="valuelist['date_maturity']" t-esc="valuelist['date_maturity']"/></th>
                                                <th><t t-if="valuelist['diff0']" t-esc="state.total[move_line]['currency_id']"/><t t-if="valuelist['diff0']" t-esc="valuelist['diff0']"/></th>
                                                <th><t t-if="valuelist['diff1']" t-esc="state.total[move_line]['currency_id']"/><t t-if="valuelist['diff1']" t-esc="valuelist['diff1']"/></th>
                                                <th><t t-if="valuelist['diff2']" t-esc="state.total[move_line]['currency_id']"/><t t-if="valuelist['diff2']" t-esc="valuelist['diff2']"/></th>
                                                <th><t t-if="valuelist['diff3']" t-esc="state.total[move_line]['currency_id']"/><t t-if="valuelist['diff3']" t-esc="valuelist['diff3']"/></th>
                                                <th><t t-if="valuelist['diff4']" t-esc="state.total[move_line]['currency_id']"/><t t-if="valuelist['diff4']" t-esc="valuelist['diff4']"/></th>
                                                <th><t t-if="valuelist['diff5']" t-esc="state.total[move_line]['currency_id']"/><t t-if="valuelist['diff5']" t-esc="valuelist['diff5']"/></th>
                                                <th/>
                                            </tr>
                                        </t>
                                    </t>
                                </t>

                                <!-- Grand Total row (both modes) -->
                                <tr>
                                    <th/>
                                    <th colspan="10" class="o_heading">Total</th>
                                    <th class="o_heading"><t t-esc="state.currency"/><t t-out="state.diff0_sum_display"/></th>
                                    <th class="o_heading"><t t-esc="state.currency"/><t t-out="state.diff1_sum_display"/></th>
                                    <th class="o_heading"><t t-esc="state.currency"/><t t-out="state.diff2_sum_display"/></th>
                                    <th class="o_heading"><t t-esc="state.currency"/><t t-out="state.diff3_sum_display"/></th>
                                    <th class="o_heading"><t t-esc="state.currency"/><t t-out="state.diff4_sum_display"/></th>
                                    <th class="o_heading"><t t-esc="state.currency"/><t t-out="state.diff5_sum_display"/></th>
                                    <th class="o_heading"><t t-esc="state.currency"/><t t-out="state.total_debit_display"/></th>
                                </tr>

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
