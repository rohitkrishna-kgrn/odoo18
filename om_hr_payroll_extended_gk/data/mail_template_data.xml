<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="mail_template_payroll_submitted" model="mail.template">
            <field name="name">Country Payroll: approval request (Payroll Admins)</field>
            <field name="model_id" ref="model_payroll_country_batch"/>
            <field name="email_from">{{ (object.sudo().company_id.email_formatted or user.email_formatted) }}</field>
            <field name="subject">Payroll approval required: {{ object.name }} - {{ object.country_id.name }} {{ object.get_month_label() }} {{ object.year }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#222;">
    <p>Dear <t t-out="ctx.get('payroll_recipient_name') or 'Payroll Admin'"/>,</p>
    <p>The <strong><t t-out="object.country_id.name or ''"/></strong> payroll for
        <strong><t t-out="object.get_month_label()"/> <t t-out="object.year or ''"/></strong>
        was submitted by <t t-out="object.submitted_by.name or ''"/> and is waiting for your approval.</p>
    <t t-out="object.get_mail_table()"/>
    <p style="margin:20px 0;">
        <a t-att-href="object.get_record_url()" style="background:#F25D23;color:#fff;padding:10px 18px;text-decoration:none;border-radius:4px;">Open Payroll <t t-out="object.name or ''"/></a>
    </p>
    <p>Regards,<br/>Payroll Team</p>
</div>
            </field>
        </record>

        <record id="mail_template_payroll_approved_officer" model="mail.template">
            <field name="name">Country Payroll: approved (Payroll Officers and Managers)</field>
            <field name="model_id" ref="model_payroll_country_batch"/>
            <field name="email_from">{{ (object.sudo().company_id.email_formatted or user.email_formatted) }}</field>
            <field name="subject">Payroll approved: {{ object.name }} - {{ object.country_id.name }} {{ object.get_month_label() }} {{ object.year }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#222;">
    <p>Dear <t t-out="ctx.get('payroll_recipient_name') or 'Payroll Team'"/>,</p>
    <p>The <strong><t t-out="object.country_id.name or ''"/></strong> payroll
        <strong><t t-out="object.name or ''"/></strong> for <t t-out="object.get_month_label()"/> <t t-out="object.year or ''"/>
        has been <strong>approved</strong> by <t t-out="object.approved_by.name or ''"/>.</p>
    <t t-out="object.get_mail_table()"/>
    <p>The payslips are ready to send: open the batch and use <strong>Send Selected</strong> or <strong>Send All</strong>.</p>
    <p style="margin:20px 0;">
        <a t-att-href="object.get_record_url()" style="background:#F25D23;color:#fff;padding:10px 18px;text-decoration:none;border-radius:4px;">Open Payroll <t t-out="object.name or ''"/></a>
    </p>
    <p>Regards,<br/>Payroll Team</p>
</div>
            </field>
        </record>

        <record id="mail_template_payroll_rejected" model="mail.template">
            <field name="name">Country Payroll: rejected (Payroll Officers and Managers)</field>
            <field name="model_id" ref="model_payroll_country_batch"/>
            <field name="email_from">{{ (object.sudo().company_id.email_formatted or user.email_formatted) }}</field>
            <field name="subject">Payroll rejected: {{ object.name }} - {{ object.country_id.name }} {{ object.get_month_label() }} {{ object.year }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#222;">
    <p>Dear <t t-out="ctx.get('payroll_recipient_name') or 'Payroll Team'"/>,</p>
    <p>The <strong><t t-out="object.country_id.name or ''"/></strong> payroll <strong><t t-out="object.name or ''"/></strong>
        for <t t-out="object.get_month_label()"/> <t t-out="object.year or ''"/> was <strong>rejected</strong> by
        <t t-out="object.rejected_by.name or ''"/>.</p>
    <p><strong>Reason:</strong> <t t-out="object.rejection_reason or ''"/></p>
    <t t-out="object.get_mail_table()"/>
    <p>Correct the payroll, recalculate and submit it again.</p>
    <p style="margin:20px 0;">
        <a t-att-href="object.get_record_url()" style="background:#F25D23;color:#fff;padding:10px 18px;text-decoration:none;border-radius:4px;">Open Payroll <t t-out="object.name or ''"/></a>
    </p>
    <p>Regards,<br/>Payroll Team</p>
</div>
            </field>
        </record>

        <record id="mail_template_payroll_resubmit" model="mail.template">
            <field name="name">Country Payroll: resubmission requested (preparer)</field>
            <field name="model_id" ref="model_payroll_country_batch"/>
            <field name="email_from">{{ (object.sudo().company_id.email_formatted or user.email_formatted) }}</field>
            <field name="subject">Payroll sent back for resubmission: {{ object.name }} - {{ object.country_id.name }} {{ object.get_month_label() }} {{ object.year }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#222;">
    <p>Dear <t t-out="ctx.get('payroll_recipient_name') or 'Payroll Officer'"/>,</p>
    <p>The <strong><t t-out="object.country_id.name or ''"/></strong> payroll <strong><t t-out="object.name or ''"/></strong>
        for <t t-out="object.get_month_label()"/> <t t-out="object.year or ''"/>, which you prepared, was sent back
        for <strong>resubmission</strong> by <t t-out="object.resubmit_by.name or ''"/>.</p>
    <p><strong>Reason:</strong> <t t-out="object.resubmit_reason or ''"/></p>
    <t t-out="object.get_mail_table()"/>
    <p>Please check the batch, correct it if needed, press <strong>Recalculate</strong> and
        <strong>Submit for Approval</strong> again.</p>
    <p style="margin:20px 0;">
        <a t-att-href="object.get_record_url()" style="background:#F25D23;color:#fff;padding:10px 18px;text-decoration:none;border-radius:4px;">Open Payroll <t t-out="object.name or ''"/></a>
    </p>
    <p>Regards,<br/>Payroll Team</p>
</div>
            </field>
        </record>
        <record id="mail_template_payslip_employee" model="mail.template">
            <field name="name">Country Payroll: payslip to employee</field>
            <field name="model_id" ref="model_payroll_country_line"/>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="subject">Your Payslip for {{ object.batch_id.get_month_label() }} {{ object.year }} – {{ object.company_id.name }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#222;">
    <p>Dear <t t-out="object.employee_name or ''"/>,</p>
    <p>Your payslip for <t t-out="object.batch_id.get_month_label()"/> <t t-out="object.year or ''"/> has been approved and is now available.</p>
    <p>Please find your payslip attached to this email.</p>
    <p>Regards,<br/>Payroll Team<br/><t t-out="object.company_id.name or ''"/></p>
</div>
            </field>
        </record>
    </data>
</odoo>
