<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payroll_country_send_wizard" model="ir.ui.view">
        <field name="name">payroll.country.send.wizard.form</field>
        <field name="model">payroll.country.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Payslips">
                <div class="d-flex align-items-center mb-2">
                    <button name="action_select_unsent" type="object" string="Select All Unsent"
                            class="btn-secondary me-2" icon="fa-check-square-o"/>
                    <button name="action_clear" type="object" string="Clear Selection"
                            class="btn-secondary me-3" icon="fa-square-o"/>
                    <span class="text-muted"><field name="selected_count" class="oe_inline fw-bold"/> selected</span>
                </div>
                <field name="batch_id" invisible="1"/>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0"
                          decoration-success="email_status == 'sent'" decoration-info="email_status == 'queued'"
                          decoration-danger="email_status in ('failed', 'no_email')">
                        <field name="selected" widget="boolean" string="Select"/>
                        <field name="employee_name" readonly="1"/>
                        <field name="employee_code" readonly="1" optional="show"/>
                        <field name="company_name" readonly="1"/>
                        <field name="work_email" readonly="1"/>
                        <field name="payslip_ref" readonly="1" optional="show"/>
                        <field name="email_status" readonly="1" widget="badge"/>
                        <field name="email_sent_date" readonly="1" optional="show"/>
                        <field name="payroll_line_id" column_invisible="1"/>
                    </list>
                </field>
                <div class="text-muted mt-2">Tick the employees to email their approved payslip. An employee already
                    Sent / Queued is emailed again only if you tick them. Employees without a work email are recorded
                    as "No Employee Email".</div>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary" icon="fa-envelope"
                            confirm="Email the payslip to the selected employees?"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
