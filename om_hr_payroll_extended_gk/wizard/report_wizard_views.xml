<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payroll_country_report_wizard" model="ir.ui.view">
        <field name="name">payroll.country.report.wizard.form</field>
        <field name="model">payroll.country.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Payroll Report">
                <group>
                    <group>
                        <field name="payroll_country_id" options="{'no_create': True, 'no_open': True}" readonly="batch_id"/>
                        <field name="month" readonly="batch_id"/>
                        <field name="year" readonly="batch_id"/>
                        <field name="batch_id" readonly="1" invisible="not batch_id" options="{'no_open': True}"/>
                    </group>
                    <group>
                        <field name="allowed_company_ids" invisible="1"/>
                        <field name="company_ids" widget="many2many_tags" domain="[('id', 'in', allowed_company_ids)]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="include_draft"/>
                        <field name="output" widget="radio" options="{'horizontal': true}"/>
                    </group>
                </group>
                <div class="text-muted">The report shows the saved payroll lines you are allowed to see.</div>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payroll_country_report_wizard" model="ir.actions.act_window">
        <field name="name">Payroll Reports</field>
        <field name="res_model">payroll.country.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
