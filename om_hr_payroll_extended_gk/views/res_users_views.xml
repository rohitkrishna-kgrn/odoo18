<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payroll_officer_list" model="ir.ui.view">
        <field name="name">res.users.list.payroll.officers</field>
        <field name="model">res.users</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Payroll Officers" create="0" delete="0" edit="0">
                <field name="name" readonly="1"/>
                <field name="login" readonly="1"/>
                <field name="country" string="Leave Location (payroll country)" readonly="1"/>
                <field name="company_ids" widget="many2many_tags" readonly="1" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_payroll_officers" model="ir.actions.act_window">
        <field name="name">Payroll Officers</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_payroll_officer_list"/>
        <field name="domain" eval="[('groups_id', 'in', [ref('om_hr_payroll.group_hr_payroll_user')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Payroll Officer yet</p>
            <p>Give a user Payroll access Officer (Settings &gt; Users). Their Leave Location (India / Dubai)
                decides which country payroll and which employees they see.</p>
        </field>
    </record>
</odoo>
