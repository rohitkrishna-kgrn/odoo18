<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_my_payslip_list" model="ir.ui.view">
        <field name="name">hr.payslip.my.list</field>
        <field name="model">hr.payslip</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="My Payslips" create="0" edit="0" delete="0" default_order="date_to desc">
                <field name="number" string="Payslip Reference"/>
                <field name="payroll_month"/>
                <field name="payroll_year"/>
                <field name="payroll_company_name" string="Company"/>
                <field name="country_batch_state" string="Payslip Status" widget="badge" decoration-success="country_batch_state == 'approved'"/>
                <field name="payroll_currency_id" column_invisible="1"/>
                <field name="payroll_net"/>
                <button name="action_download_my_payslip" type="object" string="Download" icon="fa-download" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_my_payslip_form" model="ir.ui.view">
        <field name="name">hr.payslip.my.form</field>
        <field name="model">hr.payslip</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="My Payslip" create="0" edit="0" delete="0">
                <header>
                    <button name="action_download_my_payslip" type="object" string="Download Payslip (PDF)"
                            icon="fa-download" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="number" readonly="1"/></h1>
                        <h3 class="text-muted"><field name="name" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1" options="{'no_open': True}"/>
                            <field name="payroll_company_name" string="Company" readonly="1"/>
                            <field name="payroll_month" readonly="1"/>
                            <field name="payroll_year" readonly="1"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="country_batch_state" string="Payslip Status" readonly="1"/>
                            <field name="payroll_currency_id" invisible="1"/>
                            <field name="payroll_gross" readonly="1"/>
                            <field name="payroll_net" readonly="1" class="fw-bold"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_my_payslip_search" model="ir.ui.view">
        <field name="name">hr.payslip.my.search</field>
        <field name="model">hr.payslip</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="My Payslips">
                <field name="number"/>
                <field name="payroll_year"/>
                <field name="payroll_month"/>
                <group expand="0" string="Group By">
                    <filter name="group_year" string="Year" context="{'group_by': 'payroll_year'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'payroll_month'}"/>
                </group>
                <searchpanel>
                    <field name="payroll_year" string="Year" select="one" icon="fa-calendar"/>
                    <field name="payroll_month" string="Month" select="one" icon="fa-calendar-o"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_my_payslips" model="ir.actions.act_window">
        <field name="name">My Payslips</field>
        <field name="res_model">hr.payslip</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_my_payslip_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_my_payslip_form')})]"/>
        <field name="search_view_id" ref="view_my_payslip_search"/>
        <field name="domain">[('employee_id.user_id', '=', uid), ('country_batch_state', '=', 'approved'), ('state', '=', 'done')]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No approved payslip yet</p>
            <p>Your payslips appear here once the month's payroll is approved.</p>
        </field>
    </record>
</odoo>
