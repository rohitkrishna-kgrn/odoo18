<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access levels = Payroll dropdown on the user (om_hr_payroll category "Payroll"):
         Officer -> Manager -> Admin (this module). The Officer's country is the user's own
         Leave Location (Country For Leave Model): India -> India Payroll only, and only
         India employees / contracts in the Employees app. Manager: every country.
         Admin: Manager + the only payroll approvers (approval mails go to Admins only). -->
    <record id="group_payroll_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="base.module_category_payroll_localization"/>
        <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_manager'))]"/>
        <field name="comment">Payroll approver: approves, rejects or asks for resubmission of country
            payroll batches; receives the approval requests. Everything a Payroll Manager can do.</field>
    </record>

    <!-- Payroll companies come from contracts, not from the officer's Allowed Companies:
         officers must be able to read (only read) every company. OR-ed with core's rule. -->
    <record id="rule_company_read_payroll_officer" model="ir.rule">
        <field name="name">Company: read all (Payroll Officer)</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ===================== Employees app: Payroll Officer's Leave Location ===================== -->
    <!-- Global (AND-ed for everyone), but only bites for a pure Payroll Officer with a Leave
         Location (res.users.payroll_restricted_location); everyone else gets (1 = 1). -->
    <record id="rule_employee_payroll_officer_location" model="ir.rule">
        <field name="name">Employee: Payroll Officer sees own Leave Location only</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[('user_id.country', '=', user.payroll_restricted_location)] if user.payroll_restricted_location else [(1, '=', 1)]</field>
    </record>
    <record id="rule_contract_payroll_officer_location" model="ir.rule">
        <field name="name">Contract: Payroll Officer sees own Leave Location only</field>
        <field name="model_id" ref="hr_contract.model_hr_contract"/>
        <field name="domain_force">[('employee_id.user_id.country', '=', user.payroll_restricted_location)] if user.payroll_restricted_location else [(1, '=', 1)]</field>
    </record>

    <!-- Every model: internal users nothing (they only have read ACL, used by related
         fields), Officer = own Leave Location's payroll, Manager / Admin = all. Group rules
         are OR-ed, so the internal-user rule must stay: without it read ACL = everything. -->
    <!-- ===================== payroll.country.batch ===================== -->
    <record id="rule_batch_user" model="ir.rule">
        <field name="name">Payroll batch: internal users (none)</field>
        <field name="model_id" ref="model_payroll_country_batch"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_batch_officer" model="ir.rule">
        <field name="name">Payroll batch: Payroll Officer's Leave Location</field>
        <field name="model_id" ref="model_payroll_country_batch"/>
        <field name="domain_force">[('payroll_country_id.leave_location', '=', user.country)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    <record id="rule_batch_admin" model="ir.rule">
        <field name="name">Payroll batch: Payroll Manager / Admin</field>
        <field name="model_id" ref="model_payroll_country_batch"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
    <!-- ===================== payroll.country.line ===================== -->
    <record id="rule_line_user" model="ir.rule">
        <field name="name">Payroll line: internal users (none)</field>
        <field name="model_id" ref="model_payroll_country_line"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_line_officer" model="ir.rule">
        <field name="name">Payroll line: Payroll Officer's Leave Location</field>
        <field name="model_id" ref="model_payroll_country_line"/>
        <field name="domain_force">[('payroll_country_id.leave_location', '=', user.country)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    <record id="rule_line_admin" model="ir.rule">
        <field name="name">Payroll line: Payroll Manager / Admin</field>
        <field name="model_id" ref="model_payroll_country_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_manager'))]"/>
    </record>

    <!-- ===================== line / batch children ===================== -->
    <record id="rule_line_leave_user" model="ir.rule">
        <field name="name">Payroll line leave: internal users (none)</field>
        <field name="model_id" ref="model_payroll_country_line_leave"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_line_leave" model="ir.rule">
        <field name="name">Payroll line leave: Payroll Officer's Leave Location</field>
        <field name="model_id" ref="model_payroll_country_line_leave"/>
        <field name="domain_force">[('line_id.payroll_country_id.leave_location', '=', user.country)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    <record id="rule_change_log_user" model="ir.rule">
        <field name="name">Payroll manual changes: internal users (none)</field>
        <field name="model_id" ref="model_payroll_country_change_log"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_change_log" model="ir.rule">
        <field name="name">Payroll manual changes: Payroll Officer's Leave Location</field>
        <field name="model_id" ref="model_payroll_country_change_log"/>
        <field name="domain_force">[('line_id.payroll_country_id.leave_location', '=', user.country)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    <record id="rule_send_log_user" model="ir.rule">
        <field name="name">Payslip email history: internal users (none)</field>
        <field name="model_id" ref="model_payroll_payslip_send_log"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_send_log" model="ir.rule">
        <field name="name">Payslip email history: Payroll Officer's Leave Location</field>
        <field name="model_id" ref="model_payroll_payslip_send_log"/>
        <field name="domain_force">[('line_id.payroll_country_id.leave_location', '=', user.country)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    <record id="rule_excluded_user" model="ir.rule">
        <field name="name">Not fetched employees: internal users (none)</field>
        <field name="model_id" ref="model_payroll_country_excluded"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_excluded" model="ir.rule">
        <field name="name">Not fetched employees: Payroll Officer's Leave Location</field>
        <field name="model_id" ref="model_payroll_country_excluded"/>
        <field name="domain_force">[('batch_id.payroll_country_id.leave_location', '=', user.country)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    <record id="rule_notify_log_user" model="ir.rule">
        <field name="name">Payroll notification history: internal users (none)</field>
        <field name="model_id" ref="model_payroll_country_notify_log"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_notify_log" model="ir.rule">
        <field name="name">Payroll notification history: Payroll Officer's Leave Location</field>
        <field name="model_id" ref="model_payroll_country_notify_log"/>
        <field name="domain_force">[('batch_id.payroll_country_id.leave_location', '=', user.country)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>

    <record id="rule_children_admin_leave" model="ir.rule">
        <field name="name">Payroll line leave: administrator</field>
        <field name="model_id" ref="model_payroll_country_line_leave"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
    <record id="rule_children_admin_change" model="ir.rule">
        <field name="name">Payroll manual changes: administrator</field>
        <field name="model_id" ref="model_payroll_country_change_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
    <record id="rule_children_admin_send" model="ir.rule">
        <field name="name">Payslip email history: administrator</field>
        <field name="model_id" ref="model_payroll_payslip_send_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
    <record id="rule_children_admin_excluded" model="ir.rule">
        <field name="name">Not fetched employees: administrator</field>
        <field name="model_id" ref="model_payroll_country_excluded"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
    <record id="rule_children_admin_notify" model="ir.rule">
        <field name="name">Payroll notification history: administrator</field>
        <field name="model_id" ref="model_payroll_country_notify_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_manager'))]"/>
    </record>

    <!-- ===================== hr.payslip self-service ===================== -->
    <!-- Group rules are OR-ed: this only ADDS each user's own approved payslips;
         Payroll's own Officer / Manager rules keep working as before. -->
    <record id="rule_payslip_own_approved" model="ir.rule">
        <field name="name">Payslip: own approved payslips (self-service)</field>
        <field name="model_id" ref="om_hr_payroll.model_hr_payslip"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id), ('country_batch_state', '=', 'approved'), ('state', '=', 'done')]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
