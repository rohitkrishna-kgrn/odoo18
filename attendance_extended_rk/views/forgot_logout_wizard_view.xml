<odoo>

    <!-- Wizard Form View -->
    <record id="view_forgot_logout_wizard_form" model="ir.ui.view">
        <field name="name">forgot.logout.wizard.form</field>
        <field name="model">forgot.logout.wizard</field>
        <field name="arch" type="xml">
            <form string="Forgot to Logout">
                <group>
                    <field name="employee_id" readonly="1"/>
                    <field name="date"/>
                    <field name="time_spent"/>
                </group>
                <footer>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_forgot_logout_wizard" model="ir.actions.act_window">
        <field name="name">Forgot to Logout</field>
        <field name="res_model">forgot.logout.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Parent Menu -->
    <menuitem
        id="menu_attendance_extended_root"
        name="Forgot to Logout"
        parent="hr_attendance.menu_hr_attendance_root"
        sequence="45"/>

    <!-- Wizard Menu -->
    <menuitem
        id="menu_forgot_logout_wizard"
        name="Forgot to Logout"
        parent="menu_attendance_extended_root"
        action="action_forgot_logout_wizard"
        sequence="10"/>

    <!-- list View for Forgot Logout Timesheets -->
    <record id="view_forgot_logout_timesheet_list" model="ir.ui.view">
        <field name="name">forgot.logout.timesheet.list</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <list string="Forgot to Logout Timesheets" create="0" edit="0" delete="0">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="unit_amount"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Report Action -->
    <record id="action_forgot_logout_report" model="ir.actions.act_window">
        <field name="name">Forgot to Logout Reports</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_forgot_logout_timesheet_list"/>
        <field name="domain">[('name','=','Forgot to logout')]</field>
    </record>

    <!-- Reports Menu (HR Manager Only) -->
    <menuitem
        id="menu_forgot_logout_reports"
        name="Reports"
        parent="menu_attendance_extended_root"
        action="action_forgot_logout_report"
        sequence="20"
        />

</odoo>
