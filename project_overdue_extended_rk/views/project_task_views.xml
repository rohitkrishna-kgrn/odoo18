<odoo>
    <data>

        <!-- ══════════════════════════════════════════════
             1. LIST VIEW — row colour by overdue category
             ══════════════════════════════════════════════ -->
        <record id="view_task_tree_overdue_inherit" model="ir.ui.view">
            <field name="name">project.task.list.overdue.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_tree2"/>
            <field name="arch" type="xml">

                <!-- Add decoration attributes to the list element -->
                <xpath expr="//list" position="attributes">
                    <!-- green  : overdue but less than 30 days -->
                    <attribute name="decoration-success">overdue_category == 'lt30'</attribute>
                    <!-- orange : 30–60 days overdue -->
                    <attribute name="decoration-warning">overdue_category == '30_60'</attribute>
                    <!-- amber  : 60–90 days overdue (muted-warning maps to info in bootstrap) -->
                    <attribute name="decoration-info">overdue_category == '60_90'</attribute>
                    <!-- red    : more than 90 days overdue, or deadline missed with no delay log -->
                    <attribute name="decoration-danger">overdue_category == 'gt90' or delay_log_missing</attribute>
                </xpath>

                <!-- Hidden carrier fields required for decoration expressions -->
                <xpath expr="//list" position="inside">
                    <field name="overdue_category" column_invisible="1"/>
                    <field name="overdue_days" column_invisible="1"/>
                    <field name="state_additional" column_invisible="1"/>
                    <field name="delay_log_missing" column_invisible="1"/>
                </xpath>

            </field>
        </record>


        <!-- ══════════════════════════════════════════════
             2. FORM VIEW — coloured ribbon
             ══════════════════════════════════════════════ -->
        <record id="view_task_form_overdue_ribbon_inherit" model="ir.ui.view">
            <field name="name">project.task.form.overdue.ribbon.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">

                <!-- Ribbons must be INSIDE <sheet> so they anchor to the sheet's
                     position:relative container (top-right of the white card).
                     We insert them before oe_title so they are the first DOM
                     children — position:absolute means DOM order doesn't
                     affect where they visually appear. -->
                <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                    <field name="overdue_category" invisible="1"/>
                    <field name="state_additional" invisible="1"/>

                    <!-- Green ribbon: overdue but < 30 days -->
                    <widget name="web_ribbon"
                            title="Overdue &lt; 30 days"
                            bg_color="bg-success"
                            invisible="overdue_category != 'lt30'"/>

                    <!-- Orange ribbon: 30–60 days overdue -->
                    <widget name="web_ribbon"
                            title="Overdue 30–60 days"
                            bg_color="bg-warning"
                            invisible="overdue_category != '30_60'"/>

                    <!-- Info/amber ribbon: 60–90 days overdue -->
                    <widget name="web_ribbon"
                            title="Overdue 60–90 days"
                            bg_color="bg-info"
                            invisible="overdue_category != '60_90'"/>

                    <!-- Red ribbon: more than 90 days overdue -->
                    <widget name="web_ribbon"
                            title="Overdue &gt; 90 days"
                            bg_color="bg-danger"
                            invisible="overdue_category != 'gt90'"/>
                </xpath>

            </field>
        </record>


        <!-- ══════════════════════════════════════════════
             2b. FORM VIEW — Delay Reason & Communication Log
             ══════════════════════════════════════════════ -->
        <record id="view_task_form_delay_log_inherit" model="ir.ui.view">
            <field name="name">project.task.form.delay.log.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">

                <!-- Warning banner: deadline missed, log still empty -->
                <xpath expr="//t[@name='warning_section']" position="after">
                    <field name="delay_log_missing" invisible="1"/>
                    <div class="alert alert-danger d-flex align-items-center mb-0"
                         role="alert"
                         invisible="not delay_log_missing">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <span>This task's deadline has passed and no Delay Reason &amp;
                            Communication Log has been recorded. Please document the
                            delay explanation, revised delivery date, and communication
                            evidence in the "Delay Log" tab.</span>
                    </div>
                </xpath>

                <!-- Delay Reason & Communication Log tab -->
                <xpath expr="//page[@name='description_page']" position="after">
                    <page name="delay_log_page" string="Delay Log">
                        <group string="Delay Reason &amp; Communication Log">
                            <field name="delay_reason" placeholder="Explain the reason for the delay..."/>
                            <field name="delay_revised_date"/>
                            <field name="delay_evidence_ids" widget="many2many_binary" string="Communication Evidence"/>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>


        <!-- ══════════════════════════════════════════════
             3. SEARCH VIEW — overdue filters
             Tasks with stage_id.fold = True (done stage) are
             excluded via state_additional != 'completed'.
             ══════════════════════════════════════════════ -->
        <record id="view_task_search_overdue_inherit" model="ir.ui.view">
            <field name="name">project.task.search.overdue.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_search_form"/>
            <field name="arch" type="xml">

                <xpath expr="//search" position="inside">

                    <separator/>

                    <!-- Overdue &lt; 30 days: deadline was 1–29 days ago, task not done -->
                    <filter
                        name="overdue_lt30"
                        string="Overdue &lt; 30 days"
                        domain="[
                            ('date_deadline', '!=', False),
                            ('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d')),
                            ('date_deadline', '&gt;=', (context_today() + relativedelta(days=-29)).strftime('%Y-%m-%d')),
                            ('state_additional', '!=', 'completed'),
                            ('stage_id.fold', '=', False)
                        ]"
                    />

                    <!-- Overdue 30–60 days: deadline was 30–60 days ago, task not done -->
                    <filter
                        name="overdue_30_60"
                        string="Overdue 30–60 days"
                        domain="[
                            ('date_deadline', '!=', False),
                            ('date_deadline', '&lt;=', (context_today() + relativedelta(days=-30)).strftime('%Y-%m-%d')),
                            ('date_deadline', '&gt;=', (context_today() + relativedelta(days=-60)).strftime('%Y-%m-%d')),
                            ('state_additional', '!=', 'completed'),
                            ('stage_id.fold', '=', False)
                        ]"
                    />

                    <!-- Overdue 60–90 days: deadline was 61–90 days ago, task not done -->
                    <filter
                        name="overdue_60_90"
                        string="Overdue 60–90 days"
                        domain="[
                            ('date_deadline', '!=', False),
                            ('date_deadline', '&lt;=', (context_today() + relativedelta(days=-61)).strftime('%Y-%m-%d')),
                            ('date_deadline', '&gt;=', (context_today() + relativedelta(days=-90)).strftime('%Y-%m-%d')),
                            ('state_additional', '!=', 'completed'),
                            ('stage_id.fold', '=', False)
                        ]"
                    />

                    <!-- Overdue &gt; 90 days: deadline was more than 90 days ago, task not done -->
                    <filter
                        name="overdue_gt90"
                        string="Overdue &gt; 90 days"
                        domain="[
                            ('date_deadline', '!=', False),
                            ('date_deadline', '&lt;', (context_today() + relativedelta(days=-90)).strftime('%Y-%m-%d')),
                            ('state_additional', '!=', 'completed'),
                            ('stage_id.fold', '=', False)
                        ]"
                    />

                    <separator/>

                    <!-- No deadline set -->
                    <filter
                        name="no_deadline"
                        string="No Deadline"
                        domain="[('date_deadline', '=', False)]"
                    />

                    <separator/>

                    <!-- Deadline missed with no Delay Reason & Communication Log recorded -->
                    <filter
                        name="delay_log_missing"
                        string="Delay Log Missing"
                        domain="[('delay_log_missing', '=', True)]"
                    />

                    <separator/>

                    <!-- ── Upcoming Due filters (future deadlines, task not done) ── -->

                    <!-- Due in &lt; 30 days: deadline is today → today+29 -->
                    <filter
                        name="due_lt30"
                        string="Due &lt; 30 days"
                        domain="[
                            ('date_deadline', '!=', False),
                            ('date_deadline', '&gt;=', context_today().strftime('%Y-%m-%d')),
                            ('date_deadline', '&lt;=', (context_today() + relativedelta(days=29)).strftime('%Y-%m-%d')),
                            ('state_additional', '!=', 'completed'),
                            ('stage_id.fold', '=', False)
                        ]"
                    />

                    <!-- Due in 30–60 days: deadline is today+30 → today+60 -->
                    <filter
                        name="due_30_60"
                        string="Due in 30–60 days"
                        domain="[
                            ('date_deadline', '!=', False),
                            ('date_deadline', '&gt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d')),
                            ('date_deadline', '&lt;=', (context_today() + relativedelta(days=60)).strftime('%Y-%m-%d')),
                            ('state_additional', '!=', 'completed'),
                            ('stage_id.fold', '=', False)
                        ]"
                    />

                    <!-- Due in 60–90 days: deadline is today+61 → today+90 -->
                    <filter
                        name="due_60_90"
                        string="Due in 60–90 days"
                        domain="[
                            ('date_deadline', '!=', False),
                            ('date_deadline', '&gt;=', (context_today() + relativedelta(days=61)).strftime('%Y-%m-%d')),
                            ('date_deadline', '&lt;=', (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d')),
                            ('state_additional', '!=', 'completed'),
                            ('stage_id.fold', '=', False)
                        ]"
                    />

                    <!-- Due in &gt; 90 days: deadline is beyond today+90 -->
                    <filter
                        name="due_gt90"
                        string="Due &gt; 90 days"
                        domain="[
                            ('date_deadline', '!=', False),
                            ('date_deadline', '&gt;', (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d')),
                            ('state_additional', '!=', 'completed'),
                            ('stage_id.fold', '=', False)
                        ]"
                    />

                </xpath>

            </field>
        </record>

    </data>
</odoo>
