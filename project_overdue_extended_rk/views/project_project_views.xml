<odoo>
    <data>

        <!-- ══════════════════════════════════════════════
             1. FORM VIEW — warning banner
             ══════════════════════════════════════════════ -->
        <record id="view_project_form_delay_log_inherit" model="ir.ui.view">
            <field name="name">project.project.form.delay.log.inherit</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">

                <!-- Warning banner: deadline missed, log still empty -->
                <xpath expr="//widget[@name='web_ribbon']" position="after">
                    <field name="delay_log_missing" invisible="1"/>
                    <div class="alert alert-danger d-flex align-items-center mb-0"
                         role="alert"
                         invisible="not delay_log_missing">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <span>This project's deadline has passed and no delay reason
                            has been logged. Record the delay explanation in the
                            Delay Reason popup — it is logged in the chatter.</span>
                    </div>
                </xpath>

            </field>
        </record>


        <!-- ══════════════════════════════════════════════
             2. LIST VIEW — row colour when flagged
             ══════════════════════════════════════════════ -->
        <record id="view_project_list_delay_log_inherit" model="ir.ui.view">
            <field name="name">project.project.list.delay.log.inherit</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.project_list_view_group_stage"/>
            <field name="arch" type="xml">

                <xpath expr="//list" position="attributes">
                    <attribute name="decoration-danger">delay_log_missing</attribute>
                </xpath>

                <xpath expr="//list" position="inside">
                    <field name="delay_log_missing" column_invisible="1"/>
                </xpath>

            </field>
        </record>


        <!-- ══════════════════════════════════════════════
             2b. LIST VIEW — delay log badge
             Anchored on the base list (project.view_project) so the column also
             reaches the primary views derived from it.
             ══════════════════════════════════════════════ -->
        <record id="view_project_list_delay_badge_inherit" model="ir.ui.view">
            <field name="name">project.project.list.delay.badge.inherit</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.view_project"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='stage_id']" position="after">
                    <field name="delay_log_state"
                           string="Delay Log"
                           widget="badge"
                           optional="show"
                           invisible="not delay_log_state"
                           decoration-danger="delay_log_state == 'missing'"
                           decoration-success="delay_log_state == 'logged'"/>
                </xpath>

            </field>
        </record>


        <!-- ══════════════════════════════════════════════
             3. KANBAN VIEW (project dashboard) — flag badge
             ══════════════════════════════════════════════ -->
        <record id="view_project_kanban_delay_log_inherit" model="ir.ui.view">
            <field name="name">project.project.kanban.delay.log.inherit</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.view_project_kanban"/>
            <field name="arch" type="xml">

                <xpath expr="//kanban/field[@name='sequence']" position="after">
                    <field name="delay_log_missing"/>
                </xpath>

                <xpath expr="//field[@name='tag_ids']" position="after">
                    <div t-if="record.delay_log_missing.raw_value" class="text-danger d-flex align-items-baseline">
                        <span class="fa fa-exclamation-triangle me-2" aria-label="Delay Log Missing" title="Delay Log Missing"></span>
                        <span>Delay Log Missing</span>
                    </div>
                </xpath>

            </field>
        </record>


        <!-- ══════════════════════════════════════════════
             4. SEARCH VIEW — flag filter
             ══════════════════════════════════════════════ -->
        <record id="view_project_search_delay_log_inherit" model="ir.ui.view">
            <field name="name">project.project.search.delay.log.inherit</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.view_project_project_filter"/>
            <field name="arch" type="xml">

                <xpath expr="//filter[@name='inactive']" position="after">
                    <separator/>
                    <filter
                        name="delay_log_missing"
                        string="Delay Log Missing"
                        domain="[('delay_log_missing', '=', True)]"
                    />
                </xpath>

            </field>
        </record>

    </data>
</odoo>
