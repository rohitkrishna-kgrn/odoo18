<odoo>
    <!-- Main Root Menu -->
    <menuitem id="menu_leave_root" name="Leave" sequence="10" web_icon="leave_management_rk,static/description/icon.png"/>

    <!-- Leave Requests Action -->
    <record id="action_leave_request" model="ir.actions.act_window">
        <field name="name">Leave Requests</field>
        <field name="res_model">leave.request</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="leave_management_rk.view_leave_request_tree"/>
    </record>

    <!-- Leave Requests Menu (employees submit their own) -->
    <menuitem id="menu_leave_requests" name="Leave Requests"
              parent="menu_leave_root"
              action="leave_management_rk.action_leave_request"
              sequence="1"
              groups="leave_management_rk.group_leave_user,leave_management_rk.group_hr_manager"/>

    <!-- Compensation Leave Request (employees submit) -->
    <menuitem id="menu_comp_leave_request" name="Compensation Leave Request"
              parent="menu_leave_root"
              action="leave_management_rk.action_comp_leave_request"
              sequence="3"
              groups="leave_management_rk.group_leave_user,leave_management_rk.group_hr_manager"/>

    <!-- Team Approval Parent Menu (dept managers + HR) -->
    <menuitem id="menu_team_approval" name="Team Approval"
              parent="menu_leave_root"
              sequence="5"
              groups="leave_management_rk.group_dept_manager,leave_management_rk.group_hr_manager"/>

    <!-- Team Approval: Leave Requests submenu -->
    <menuitem id="menu_team_approval_leave" name="Leave Requests"
              parent="menu_team_approval"
              action="leave_management_rk.action_team_approval_leave"
              sequence="1"
              groups="leave_management_rk.group_dept_manager,leave_management_rk.group_hr_manager"/>

    <!-- Team Approval: Compensation submenu -->
    <menuitem id="menu_team_approval_comp" name="Compensation"
              parent="menu_team_approval"
              action="leave_management_rk.action_team_approval_comp"
              sequence="2"
              groups="leave_management_rk.group_dept_manager,leave_management_rk.group_hr_manager"/>

    <!-- Public Holidays Action -->
    <record id="action_public_holiday" model="ir.actions.act_window">
        <field name="name">Public Holidays</field>
        <field name="res_model">public.holiday</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Public Holidays Menu (HR only) -->
    <menuitem id="menu_public_holiday" name="Public Holidays"
              parent="menu_leave_root"
              action="leave_management_rk.action_public_holiday"
              groups="leave_management_rk.group_hr_manager"
              sequence="7"/>

    <!-- Leave Balance Report (HR + Dept Manager, read-only). This is a section
         header with two children (view / download) rather than a directly
         clickable item, since a top-level menu with children renders as a
         dropdown label in Odoo's navbar, not a link. -->
    <menuitem id="menu_leave_balance_report" name="Leave Balance Report"
              parent="menu_leave_root"
              groups="leave_management_rk.group_hr_manager,leave_management_rk.group_dept_manager"
              sequence="6"/>

    <menuitem id="menu_leave_balance_report_view" name="Leave Balance Report"
              parent="menu_leave_balance_report"
              action="leave_management_rk.action_leave_balance_report"
              groups="leave_management_rk.group_hr_manager,leave_management_rk.group_dept_manager"
              sequence="1"/>

    <!-- Download Excel (India / Dubai / Both), nested under the same report menu -->
    <menuitem id="menu_leave_balance_report_xlsx" name="Download Leave Balance (Excel)"
              parent="menu_leave_balance_report"
              action="leave_management_rk.action_leave_balance_report_xlsx"
              groups="leave_management_rk.group_hr_manager,leave_management_rk.group_dept_manager"
              sequence="2"/>

    <!-- HR Leave Balance Wizard (HR only) -->
    <menuitem id="menu_hr_leave_balance" name="Employee Leave Balance"
              parent="menu_leave_root"
              action="leave_management_rk.action_hr_leave_balance_wizard"
              groups="leave_management_rk.group_hr_manager"
              sequence="8"/>
</odoo>
