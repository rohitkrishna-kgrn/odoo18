<odoo>
    <!-- Team Approval: Leave Requests (pending manager or HR approval) -->
    <record id="action_team_approval_leave" model="ir.actions.act_window">
        <field name="name">Leave Requests</field>
        <field name="res_model">leave.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['waiting_manager', 'manager_approved'])]</field>
    </record>

    <!-- Team Approval: Compensation Leave (pending manager or HR approval) -->
    <record id="action_team_approval_comp" model="ir.actions.act_window">
        <field name="name">Compensation Leave</field>
        <field name="res_model">leave.comp.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['waiting_manager', 'manager_approved'])]</field>
    </record>
</odoo>
