<odoo>
    <record id="view_users_form_inherit_country_preferences" model="ir.ui.view">
        <field name="name">res.users.form.inherit.country.preferences</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='preferences']" position="inside">
                <field name="country" groups="base.group_system"/>
            </xpath>
        </field>
    </record>
</odoo>
