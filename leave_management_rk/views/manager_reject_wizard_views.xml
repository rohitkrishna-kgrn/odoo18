<odoo>
    <record id="view_leave_manager_reject_wizard_form" model="ir.ui.view">
        <field name="name">leave.manager.reject.wizard.form</field>
        <field name="model">leave.manager.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject with Remarks">
                <group>
                    <field name="remarks" placeholder="Enter rejection reason..." required="1"
                           widget="text"/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Confirm Rejection"
                            class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
