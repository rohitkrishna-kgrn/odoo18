<odoo>
    <record id="view_leave_cancel_wizard_form" model="ir.ui.view">
        <field name="name">leave.cancel.wizard.form</field>
        <field name="model">leave.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Leave">
                <group>
                    <field name="leave_id" invisible="1"/>
                    <field name="reason" placeholder="Enter cancellation reason..." required="1"
                           widget="text"/>
                </group>
                <footer>
                    <button name="action_confirm_cancel" type="object" string="Confirm Cancellation"
                            class="btn-danger"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
