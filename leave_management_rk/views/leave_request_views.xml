<odoo>
    <record id="view_leave_request_form" model="ir.ui.view">
        <field name="name">leave.request.form</field>
        <field name="model">leave.request</field>
        <field name="arch" type="xml">
            <form string="Leave Request">
                <header>
                    <button name="action_request" type="object" string="Submit"
                            invisible="state != 'draft'"/>
                    <button name="action_manager_approve" type="object" string="Approve"
                            invisible="state != 'waiting_manager'"
                            groups="leave_management_rk.group_dept_manager,leave_management_rk.group_hr_manager"
                            class="btn-primary"/>
                    <button name="action_manager_reject_wizard" type="object" string="Reject"
                            invisible="state != 'waiting_manager'"
                            groups="leave_management_rk.group_dept_manager,leave_management_rk.group_hr_manager"
                            class="btn-danger"/>
                    <button name="action_open_approve_wizard" type="object" string="Approve (HR)"
                            invisible="state != 'manager_approved'"
                            groups="leave_management_rk.group_hr_manager"
                            class="btn-primary"/>
                    <button name="action_reject" type="object" string="Reject (HR)"
                            invisible="state != 'manager_approved'"
                            groups="leave_management_rk.group_hr_manager"
                            class="btn-danger"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,waiting_manager,manager_approved,approved,rejected"/>
                </header>
                <sheet>
                    <field name="is_permission_type" invisible="1"/>
                    <field name="is_dubai_sick_leave" invisible="1"/>
                    <group>
                        <field name="user_id" readonly="1"/>
                        <field name="leave_type_id" readonly="state != 'draft'"/>
                        <field name="available_balance" readonly="1"
                               string="Available Balance (Days / Hrs)"/>
                        <field name="leave_month_label" readonly="1"
                               string="Leave Month"
                               invisible="not leave_month_label"/>
                        <field name="is_half_day"
                               invisible="is_permission_type"
                               readonly="state != 'draft'"/>
                        <field name="start_date"
                               string="Start Date"
                               readonly="state != 'draft'"/>
                        <field name="end_date"
                               invisible="is_half_day or is_permission_type"
                               required="not is_half_day and not is_permission_type and state == 'draft'"
                               readonly="state != 'draft'"/>
                        <field name="days_requested"
                               invisible="is_permission_type"
                               readonly="1"/>
                        <field name="hours_requested"
                               invisible="not is_permission_type"
                               string="Hours Requested"
                               readonly="state != 'draft'"/>
                        <field name="reason" readonly="state != 'draft'"/>
                        <field name="applied_date" readonly="1"
                               invisible="not applied_date"/>
                        <field name="manager_remarks"
                               invisible="not manager_remarks"
                               readonly="1"
                               string="Manager Remarks"/>
                    </group>
                    <group invisible="not is_dubai_sick_leave">
                        <field name="dha_certificate"
                               widget="binary"
                               filename="dha_certificate_filename"
                               string="Upload DHA Sick Leave Certificate"
                               required="is_dubai_sick_leave and state == 'draft'"
                               readonly="state != 'draft'"/>
                        <field name="dha_certificate_filename" invisible="1"/>
                    </group>
                    <div invisible="not is_dubai_sick_leave" class="mb-2">
                        <a href="/leave_management_rk/static/src/img/dha_template.png"
                           target="_blank"
                           class="btn btn-secondary btn-sm">Download Reference Template</a>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_leave_request_tree" model="ir.ui.view">
        <field name="name">leave.request.tree</field>
        <field name="model">leave.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="leave_type_id"/>
                <field name="available_balance" readonly="1" string="Balance"/>
                <field name="leave_month_label" string="Leave Month" optional="show"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="is_half_day"/>
                <field name="days_requested"/>
                <field name="applied_date" readonly="1"/>
                <field name="state"/>
            </list>
        </field>
    </record>
</odoo>
