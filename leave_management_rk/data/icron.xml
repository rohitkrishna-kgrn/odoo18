<odoo>
  <data noupdate="1">

    <!-- Monthly update cron - runs on 1st of every month at 00:00 -->
    <record id="ir_cron_update_leave_balances" model="ir.cron">
      <field name="name">Update Leave Balances Monthly</field>
      <field name="model_id" ref="model_leave_balance"/>
      <field name="state">code</field>
      <field name="code">model.update_monthly_leave_balances()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">months</field>
      <field name="nextcall" eval="'2025-10-01 00:00:00'"/>
      <field name="active">True</field>
    </record>

    <!-- January 1st reset cron - runs once a year -->
    <record id="ir_cron_reset_leave_balances_jan1" model="ir.cron">
      <field name="name">Reset Leave Balances on January 1st</field>
      <field name="model_id" ref="model_leave_balance"/>
      <field name="state">code</field>
      <field name="code">model.reset_leave_balances_jan1()</field>
      <field name="interval_number">12</field>  <!-- 12 months = 1 year -->
      <field name="interval_type">months</field>
      <field name="nextcall" eval="'2026-01-01 00:00:00'"/>
      <field name="active">True</field>
    </record>

  </data>
</odoo>
