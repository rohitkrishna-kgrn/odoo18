<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- MIS User: default role — sees only own projects (as PM or salesperson) -->
        <record id="group_mis_user" model="res.groups">
            <field name="name">MIS User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- MIS Manager: sees data for direct subordinates (parent_id = this user's employee) -->
        <record id="group_mis_manager" model="res.groups">
            <field name="name">MIS Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('mis_report_kgrn.group_mis_user'))]"/>
        </record>

        <!-- MIS Admin: sees all data regardless of ownership -->
        <record id="group_mis_admin" model="res.groups">
            <field name="name">MIS Admin</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('mis_report_kgrn.group_mis_manager'))]"/>
        </record>

        <!-- MIS HR: read-only access to the Performance Management scorecard
             (all employees) and the monthly report log; also the sole
             audience for the automated monthly scorecard email — no one
             else receives it. Deliberately scoped to Performance only —
             no access to Project Wise/Revenue/Outstanding. -->
        <record id="group_mis_hr" model="res.groups">
            <field name="name">MIS HR</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Performance Scorecard Recipient: plain checkbox on the user form
             (no category_id -> renders under "Other" on the Access Rights
             tab). Tick this for every department head, the Managing Partner,
             and anyone else who should receive the automated monthly
             Performance Scorecard email. The cron reads this group's members
             at send time, so recipients can be changed by an admin from the
             user form with no code change. Members of MIS HR continue to
             receive it as well. -->
        <record id="group_mis_scorecard_recipient" model="res.groups">
            <field name="name">Performance Scorecard Recipient</field>
        </record>

        <!-- MIS Coach: sees the Coach View — employees mapped to them via
             hr.employee.coach_id, project-wise, with revenue/outstanding.
             Independent of the User/Manager/Admin ladder above (coaching is
             a separate mapping from the PM/salesperson hierarchy).
             Membership is kept in sync automatically by HrEmployee's
             create/write/unlink overrides in models/mis_employee.py
             whenever coach_id changes — never assign this group by hand. -->
        <record id="group_mis_coach" model="res.groups">
            <field name="name">MIS Coach</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
