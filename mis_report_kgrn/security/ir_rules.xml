        <!-- ═══════════════════════════════════════════════════════════
             mis.performance.line  —  Performance Management scorecard

             This model is scored per EMPLOYEE (user_id), not per project,
             so it is the one place the Manager/Coach mapping is applied to
             people rather than to the projects they manage.

               Admin / HR  every employee.
               Manager     themselves, plus everyone whose employee record
                           names them as Manager OR as Coach — one merged,
                           de-duplicated list (mis_scope_uids), so somebody
                           who is both a direct report and a coachee is
                           counted once.
               User        their coachees only. A plain MIS User who coaches
                           nobody computes [] and therefore sees NO rows —
                           which is the intended "Regular User: no
                           performance access" outcome, unchanged from
                           before this model had any rule at all.

             MIS HR needs its own all-rows rule rather than simply having
             none: the moment an HR user is ALSO given an MIS role, the
             User/Manager rules above would start applying to them and would
             be the only rules they matched.

             The My Performance / Team Performance screens narrow further on
             the client (user_id = me / user_id != me), which can only ever
             subset what these rules already allow — the split is
             presentation, this is the security boundary.
        ═══════════════════════════════════════════════════════════ -->

        <record id="rule_mis_performance_admin" model="ir.rule">
            <field name="name">MIS Performance: Admin sees all</field>
            <field name="model_id" ref="model_mis_performance_line"/>
            <field name="groups" eval="[(4, ref('mis_report_kgrn.group_mis_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_mis_performance_hr" model="ir.rule">
            <field name="name">MIS Performance: HR sees all</field>
