        <!-- ═══════════════════════════════════════════════════════════
             THE ACCESS MODEL, IN ONE PLACE

             Two independent assignments on the employee form decide who
             sees whose data. Both are stock Odoo fields, neither is a
             permission:

               Manager (hr.employee.parent_id) -> user.mis_report_uids
               Coach   (hr.employee.coach_id)  -> user.mis_coachee_uids
                                                  user.mis_scope_uids
                                                     = the two, de-duplicated

             and three MIS roles, granted from the MIS Role field on the
             user form:

               MIS User    own rows, plus their coachees' rows if the
                           employee form makes them somebody's Coach
               MIS Manager the above, plus their direct reports' rows
               MIS Admin   everything
               MIS HR      all of Performance Management, plus the MIS User
                           view of Project Wise / Revenue / Outstandings
                           (implies group_mis_user since 2026-09-10)

             There is NO "MIS Coach" group. Coaching widens what an
             existing role can see and grants nothing on its own, so a
             coach with no MIS role has no MIS access at all.

             Rules from different groups OR together, and group_mis_manager
             implies group_mis_user which implies base.group_user — so the
             MIS User rule below also runs for a Manager and an Admin, and
             the coach term reaches every role through it. That is why the
             Manager rules carry no coach term of their own: adding one
             would be a duplicate of a term the user rule already supplies.

             ('field', 'in', []) is FALSE in an Odoo domain, so the empty
             list a non-coach / childless manager computes means "add no
             rows" — never "all rows".
        ═══════════════════════════════════════════════════════════ -->

        <!-- ═══════════════════════════════════════════════════════════
             mis.project.wise
        ═══════════════════════════════════════════════════════════ -->

        <record id="rule_mis_project_wise_admin" model="ir.rule">
            <field name="name">MIS Project Wise: Admin sees all</field>
            <field name="model_id" ref="model_mis_project_wise"/>
            <field name="groups" eval="[(4, ref('mis_report_kgrn.group_mis_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_mis_project_wise_manager" model="ir.rule">
            <field name="name">MIS Project Wise: Manager sees own + direct reports</field>
            <field name="model_id" ref="model_mis_project_wise"/>
            <field name="groups" eval="[(4, ref('mis_report_kgrn.group_mis_manager'))]"/>
            <field name="domain_force">['|', ('project_manager_id', '=', user.id), ('project_manager_id', 'in', user.mis_report_uids or [])]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_mis_project_wise_user" model="ir.rule">
            <field name="name">MIS Project Wise: User sees own + coachees</field>
            <field name="model_id" ref="model_mis_project_wise"/>
            <field name="groups" eval="[(4, ref('mis_report_kgrn.group_mis_user'))]"/>
            <field name="domain_force">['|', '|', ('project_manager_id', '=', user.id), ('salesperson_id', '=', user.id), ('project_manager_id', 'in', user.mis_coachee_uids or [])]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

