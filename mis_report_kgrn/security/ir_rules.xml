            <field name="domain_force">['|', ('project_manager_id', '=', user.id), ('project_manager_id', 'in', user.employee_ids[:1].child_ids.user_id.ids if user.employee_ids else [])]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
