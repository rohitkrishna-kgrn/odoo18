            <field name="perm_unlink">0</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             mis.coach.dashboard  —  keyed on coach_id, not the PM/
             salesperson hierarchy used everywhere above
        ═══════════════════════════════════════════════════════════ -->

        <record id="rule_mis_coach_dashboard_admin" model="ir.rule">
