<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_mis_performance_scorecard" model="mail.template">
            <field name="name">MIS Performance Scorecard — Monthly</field>
            <field name="model_id" ref="model_mis_performance_report_log"/>
            <field name="subject">MIS Performance Scorecard — {{ object.period_label }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 13px; color: #333;">
                    <p>Dear Team,</p>
                    <p>
                        Please find attached the MIS Performance Scorecard for
                        <strong t-out="object.period_label"/>, covering
                        <t t-out="object.line_count"/> team member(s) — value of
                        work completed, invoices raised, and payments collected
                        for the period.
                    </p>
                    <p>This report is generated automatically on the 1st of every month for the prior month.</p>
                    <p>Regards,<br/>MIS Dashboard (Automated)</p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

        <record id="ir_cron_mis_performance_scorecard" model="ir.cron">
            <field name="name">MIS: Generate Monthly Performance Scorecard</field>
            <field name="model_id" ref="model_mis_performance_report_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_monthly_scorecard()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <!-- 9:00 AM Gulf Standard Time (UTC+4, no DST) = 05:00 UTC; nextcall is stored in UTC -->
            <field name="nextcall"
                   eval="(datetime.now() + relativedelta(day=1, months=1)).strftime('%Y-%m-%d 05:00:00')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
