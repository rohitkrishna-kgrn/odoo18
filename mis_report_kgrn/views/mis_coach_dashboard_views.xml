<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_mis_coach_dashboard_list" model="ir.ui.view">
        <field name="name">mis.coach.dashboard.list</field>
        <field name="model">mis.coach.dashboard</field>
        <field name="arch" type="xml">
            <list string="Coach View" create="false" edit="false" delete="false">
                <field name="employee_id" string="Employee"/>
                <field name="project_name" string="Project"/>
                <field name="department_id"/>
                <field name="project_manager_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="project_revenue_ex_vat" string="Project Revenue (Ex VAT)" sum="Total Revenue" widget="monetary"/>
                <field name="outstanding_ex_vat" string="Outstanding (Ex VAT)" sum="Total Outstanding" widget="monetary"/>
                <field name="outstanding_inc_vat" string="Outstanding (Inc VAT)" sum="Total Outstanding (Inc VAT)" widget="monetary" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mis_coach_dashboard_search" model="ir.ui.view">
        <field name="name">mis.coach.dashboard.search</field>
        <field name="model">mis.coach.dashboard</field>
        <field name="arch" type="xml">
            <search string="Coach View">
                <field name="employee_id"/>
                <field name="project_name" string="Project"/>
                <field name="department_id"/>
                <field name="project_manager_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_department" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mis_coach_dashboard" model="ir.actions.act_window">
        <field name="name">Coach View</field>
        <field name="res_model">mis.coach.dashboard</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_mis_coach_dashboard_search"/>
        <field name="context">{'search_default_group_by_employee': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No employees are currently mapped to you as their Coach.
            </p>
        </field>
    </record>

</odoo>
