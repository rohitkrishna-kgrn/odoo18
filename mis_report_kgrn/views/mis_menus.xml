<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Root -->
    <menuitem
        id="menu_mis_dashboard_root"
        name="MIS Dashboard"
        sequence="85"
        web_icon="mis_report_kgrn,static/description/icon.png"
        groups="mis_report_kgrn.group_mis_user,mis_report_kgrn.group_mis_hr"/>

    <!-- There is no Coach menu and no MIS Coach group. A coach reads their
         coachees' rows inside the reports below, filtered by the coach term
         in rule_mis_*_user (security/ir_rules.xml) — so a coach needs an MIS
         role like anybody else, and being somebody's Coach only widens what
         that role already shows. -->

    <!-- Project Wise → only list -->
    <menuitem
        id="menu_mis_project_wise_root"
        name="Project Wise"
        parent="menu_mis_dashboard_root"
        sequence="1"
        groups="mis_report_kgrn.group_mis_user"/>

    <menuitem
        id="menu_mis_project_wise_list"
        name="Project List"
        parent="menu_mis_project_wise_root"
        action="action_mis_project_wise_client"
        sequence="1"
        groups="mis_report_kgrn.group_mis_user"/>

    <!-- Project Revenue -->
    <menuitem
        id="menu_mis_project_revenue_root"
        name="Project Revenue"
        parent="menu_mis_dashboard_root"
        sequence="2"
        groups="mis_report_kgrn.group_mis_user"/>

    <menuitem
        id="menu_mis_project_revenue_list"
        name="Revenue Report"
        parent="menu_mis_project_revenue_root"
        action="mis_report_kgrn.action_mis_project_revenue_client"
        sequence="1"
        groups="mis_report_kgrn.group_mis_user"/>

    <!-- Outstandings -->
    <menuitem
        id="menu_mis_outstanding_root"
        name="Outstandings"
        parent="menu_mis_dashboard_root"
        sequence="3"
        groups="mis_report_kgrn.group_mis_user"/>

    <!-- Performance Management.
         My Performance and Team Performance were removed 2026-09-09 (for
         everyone, not just MIS User) — see static/src/js/mis_report_view.js
         and mis_performance_views.xml. Every remaining child (Sales/Operations/
         Other Teams/Scorecard Log/Warning Notices/Run Check) is Admin+HR
         only, so the parent no longer needs Manager or User in its groups —
         both are explicitly unlinked below, not just omitted, because
         <menuitem groups="..."> only LINKS the groups listed
         (Command.link per group in Odoo's convert.py) and never unlinks a
         group already on the record just because it's missing from this
         string. -->
    <menuitem
        id="menu_mis_performance_root"
        name="Performance Management"
        parent="menu_mis_dashboard_root"
        sequence="4"
        groups="-mis_report_kgrn.group_mis_user,-mis_report_kgrn.group_mis_manager,mis_report_kgrn.group_mis_admin,mis_report_kgrn.group_mis_hr"/>

    <menuitem
        id="menu_mis_perf_sales"
        name="Sales"
        parent="menu_mis_performance_root"
        action="mis_report_kgrn.action_mis_perf_sales"
        sequence="3"
        groups="mis_report_kgrn.group_mis_admin,mis_report_kgrn.group_mis_hr"/>

    <menuitem
        id="menu_mis_perf_operations"
        name="Operations"
        parent="menu_mis_performance_root"
        action="mis_report_kgrn.action_mis_perf_operations"
        sequence="4"
        groups="mis_report_kgrn.group_mis_admin,mis_report_kgrn.group_mis_hr"/>

    <menuitem
        id="menu_mis_perf_other"
        name="Other Teams"
        parent="menu_mis_performance_root"
        action="mis_report_kgrn.action_mis_perf_other"
        sequence="5"
        groups="mis_report_kgrn.group_mis_admin,mis_report_kgrn.group_mis_hr"/>

    <menuitem
        id="menu_mis_perf_report_log"
        name="Scorecard Log"
        parent="menu_mis_performance_root"
        action="mis_report_kgrn.action_mis_performance_report_log"
        sequence="6"
        groups="mis_report_kgrn.group_mis_admin,mis_report_kgrn.group_mis_hr"/>

    <menuitem
        id="menu_mis_warning_notice"
        name="Warning Notices"
        parent="menu_mis_performance_root"
        action="mis_report_kgrn.action_mis_warning_notice"
        sequence="7"
        groups="mis_report_kgrn.group_mis_admin,mis_report_kgrn.group_mis_hr"/>

    <menuitem
        id="menu_mis_run_escalation"
        name="Run Warning Notice Check"
        parent="menu_mis_performance_root"
        action="mis_report_kgrn.action_server_mis_run_escalation"
        sequence="8"
        groups="mis_report_kgrn.group_mis_admin,mis_report_kgrn.group_mis_hr"/>

    <!-- Configuration (Admin only) -->
    <menuitem
        id="menu_mis_config_root"
        name="Configuration"
        parent="menu_mis_dashboard_root"
        sequence="99"
        groups="mis_report_kgrn.group_mis_admin"/>

    <menuitem
        id="menu_mis_revenue_role_config"
        name="Revenue Roles"
        parent="menu_mis_config_root"
        action="mis_report_kgrn.action_mis_revenue_role"
        sequence="1"
        groups="mis_report_kgrn.group_mis_admin"/>

    <menuitem
        id="menu_mis_outstanding_list"
        name="Outstanding Report"
        parent="menu_mis_outstanding_root"
        action="action_mis_outstanding_client"
        sequence="1"
        groups="mis_report_kgrn.group_mis_user"/>

</odoo>
