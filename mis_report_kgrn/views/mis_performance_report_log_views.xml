<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_mis_performance_report_log_list" model="ir.ui.view">
        <field name="name">mis.performance.report.log.list</field>
        <field name="model">mis.performance.report.log</field>
        <field name="arch" type="xml">
            <list string="Monthly Scorecard Log" create="0" edit="0" delete="0">
                <field name="period_label"/>
                <field name="generated_date"/>
                <field name="line_count"/>
                <field name="email_sent"/>
                <field name="recipient_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_mis_performance_report_log_form" model="ir.ui.view">
        <field name="name">mis.performance.report.log.form</field>
        <field name="model">mis.performance.report.log</field>
        <field name="arch" type="xml">
            <form string="Monthly Scorecard" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="period_label"/>
                        <field name="generated_date"/>
                        <field name="line_count"/>
                        <field name="email_sent"/>
                        <field name="recipient_ids" widget="many2many_tags"/>
                        <field name="report_file" filename="report_filename"/>
                        <field name="report_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mis_performance_report_log" model="ir.actions.act_window">
        <field name="name">Monthly Scorecard Log</field>
        <field name="res_model">mis.performance.report.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
