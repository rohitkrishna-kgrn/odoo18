<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_mis_outstanding_search" model="ir.ui.view">
        <field name="name">mis.outstanding.line.search</field>
        <field name="model">mis.outstanding.line</field>
        <field name="arch" type="xml">
            <search string="Outstanding Report">
                <field name="project_name"       string="Project"/>
                <field name="so_number"          string="SO Number"/>
                <field name="customer_id"        string="Customer"/>
                <field name="project_manager_id" string="Project Manager"/>
                <field name="salesperson_id"     string="Salesperson"/>
                <field name="department_id"      string="Department"/>
                <field name="company_id"         string="Company"/>
                <field name="deadline" string="Deadline From"
                      filter_domain="[('deadline', '&gt;=', self)]"/>
                <field name="deadline" string="Deadline To"
                      filter_domain="[('deadline', '&lt;=', self)]"/>
                <field name="project_create_date" string="Created From"
                       filter_domain="[('project_create_date', '&gt;=', self)]"/>
                <field name="project_create_date" string="Created To"
                       filter_domain="[('project_create_date', '&lt;=', self)]"/>
                <filter string="Overdue"         name="overdue"      domain="[('days_overdue', '&gt;', 0)]"/>
                <filter string="Created Date" name="filter_create_date" date="project_create_date"/>
                <filter string="Pending Tasks"   name="has_pending"  domain="[('tasks_pending', '&gt;', 0)]"/>
                <filter string="Completed"       name="completed"    domain="[('is_completed', '=', True)]"/>
                <filter string="In Progress"     name="in_progress"  domain="[('is_completed', '=', False)]"/>
                <group expand="1" string="Group By">
                    <filter string="Company"        name="group_company"     context="{'group_by': 'company_id'}"/>
                    <filter string="Department"     name="group_department"  context="{'group_by': 'department_id'}"/>
                    <filter string="Project Manager" name="group_manager"    context="{'group_by': 'project_manager_id'}"/>
                    <filter string="Customer"       name="group_customer"    context="{'group_by': 'customer_id'}"/>
                    <filter string="Salesperson"    name="group_salesperson" context="{'group_by': 'salesperson_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_mis_outstanding_list" model="ir.ui.view">
        <field name="name">mis.outstanding.line.list</field>
        <field name="model">mis.outstanding.line</field>
        <field name="arch" type="xml">
            <list string="Outstanding Report"
                  create="false" edit="false" delete="false"
                  decoration-success="is_completed == True"
                  decoration-danger="is_completed == False">

                <field name="company_id"         optional="show"/>
                <field name="department_id"      optional="show"/>
                <field name="project_manager_id" optional="show" widget="many2one"/>
                <field name="project_id"         string="Project"    optional="show" widget="many2one"/>
                <field name="customer_id"        string="Customer"   optional="show" widget="many2one"/>
                <field name="sale_order_id"      string="SO"         optional="show" widget="many2one"/>
                <field name="salesperson_id"     optional="show"     widget="many2one"/>

                <field name="deadline"           optional="show"/>
                <field name="days_overdue"       optional="show"/>

                <field name="project_value_ex_vat"  string="Project Value (Ex VAT)"  optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="project_value_inc_vat" string="Project Value (Inc VAT)" optional="hide" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="so_total_ex_vat"        string="SO Total (Ex VAT)"       optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="so_total_inc_vat"       string="SO Total (Inc VAT)"      optional="hide" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="advance_amount"         string="Advance (SO)"            optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>

                <field name="tasks_total"     string="Total Tasks"     optional="show"/>
                <field name="tasks_completed" string="Completed Tasks" optional="show"/>
                <field name="tasks_pending"   string="Pending Tasks"   optional="show"/>
                <field name="completed_tasks_value_ex_vat" string="Completed Value (Ex VAT)" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>

                <!-- Three invoice buckets -->
                <field name="completed_invoiced_qty"             string="Completed &amp; Paid (Qty)"              optional="show"/>
                <field name="completed_invoiced_amount"          string="Completed &amp; Paid (Amt)"              optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="completed_posted_not_paid_qty"      string="Completed, Posted Not Paid (Qty)"        optional="show"/>
                <field name="completed_posted_not_paid_amount"   string="Completed, Posted Not Paid (Amt)"        optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="completed_not_invoiced_qty"         string="Completed, No Invoice (Qty)"             optional="show"/>
                <field name="completed_not_invoiced_amount"      string="Completed, No Invoice (Amt)"             optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>

                <field name="last_invoice_date"  optional="show"/>
                <field name="invoice_days_ago"   string="Invoice (Days Ago)" optional="show"/>

                <field name="is_completed"   column_invisible="1"/>
                <field name="currency_id"    column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_mis_outstanding_list" model="ir.actions.act_window">
        <field name="name">Outstanding Report</field>
        <field name="res_model">mis.outstanding.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_mis_outstanding_search"/>
        <field name="context">{
            "search_default_group_company": 1,
            "search_default_group_department": 1,
            "search_default_group_manager": 1
        }</field>
    </record>

</odoo>
