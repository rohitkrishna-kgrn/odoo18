<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- OWL client actions (Performance Management dashboards) -->
    <record id="action_mis_perf_sales" model="ir.actions.client">
        <field name="name">Sales Performance</field>
        <field name="tag">mis_performance_sales</field>
    </record>

    <record id="action_mis_perf_operations" model="ir.actions.client">
        <field name="name">Operations Performance</field>
        <field name="tag">mis_performance_operations</field>
    </record>

    <record id="action_mis_perf_other" model="ir.actions.client">
        <field name="name">Other Teams Performance</field>
        <field name="tag">mis_performance_other</field>
    </record>

    <!-- My Performance / Team Performance (action_mis_perf_my / _team) were
         removed 2026-09-09 along with their menu items and the
         mis_performance_my / mis_performance_team OWL registrations in
         static/src/js/mis_report_view.js. rule_mis_performance_manager and
         rule_mis_performance_user in security/ir_rules.xml were left in
         place — this only removed the UI, not the underlying model access. -->

</odoo>
