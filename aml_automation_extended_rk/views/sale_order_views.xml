<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_aml_form" model="ir.ui.view">
        <field name="name">sale.order.aml.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add KYC type after order fields -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="kyc_type" widget="radio" options="{'horizontal': true}"
                       required="not id"/>
                <field name="aml_gate_completed" readonly="1"/>
                <field name="aml_gate_status" invisible="1"/>
                <field name="aml_gate_override_allowed" invisible="1"/>
            </xpath>

            <!-- AML smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- Only AML staff can open the requests themselves, so the
                     button is theirs; everyone else still sees the AML/KYC
                     Completed flag above. -->
                <button name="action_view_aml_requests" type="object"
                    class="oe_stat_button" icon="fa-shield"
                    groups="aml_automation_extended_rk.group_aml_user,aml_automation_extended_rk.group_aml_manager"
                    invisible="aml_request_count == 0">
                    <field name="aml_request_count" widget="statinfo" string="AML"/>
                </button>
            </xpath>

            <!-- Exception path: allow project creation before AML/KYC is Completed.
                 Limited to the company's designated Quotation Approver via the
                 aml_gate_override_allowed computed flag (the same check is
                 re-applied server-side in write()). Hidden once aml_gate_status
                 is 'completed' (a real AML approval/bypass) but NOT once it is
                 'overridden' - the approver must still be able to see/revert
                 their own override. -->
            <xpath expr="//page[@name='other_information']" position="after">
                <page string="AML Gate Override" name="aml_gate_override_page"
                      invisible="aml_gate_status == 'completed' or not aml_gate_override_allowed">
                    <group>
                        <field name="aml_gate_override"/>
                        <field name="aml_gate_override_reason" invisible="not aml_gate_override"
                               required="aml_gate_override"/>
                        <field name="aml_gate_override_by" readonly="1" invisible="not aml_gate_override"/>
                        <field name="aml_gate_override_date" readonly="1" invisible="not aml_gate_override"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Services search filter: orders where the AML/KYC form was actually
         sent (has at least one aml.request) but the gate isn't cleared yet.
         Excludes orders that never had a form sent at all. Anchored on the
         base sale.order search view (not the Services-specific "quotation"
         primary view) so it shows on every Services menu, same pattern as
         view_sales_order_filter_inherit_salesperson_manager in
         crm_extended_rk. -->
    <record id="view_sales_order_filter_inherit_pending_aml" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.pending.aml</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <filter string="Pending AML" name="pending_aml"
                        domain="[('aml_request_ids', '!=', False), ('aml_gate_completed', '=', False)]"/>
            </filter>
        </field>
    </record>

</odoo>
