<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_aml_form" model="ir.ui.view">
        <field name="name">sale.order.aml.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add KYC type after order fields -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="kyc_type" widget="radio" options="{'horizontal': true}"
                       required="not id"/>
                <field name="aml_gate_completed" readonly="1"/>
                <field name="aml_form_status" readonly="1" invisible="aml_form_status == 'none'"/>
                <field name="aml_action_allowed" invisible="1"/>
                <field name="aml_bypass_allowed" invisible="1"/>
            </xpath>

            <!-- Manual AML form dispatch, replacing the old automatic send-on-approve.
                 Shown right after Approve, only to the AML team / the designated
                 Quotation Approver (aml_action_allowed). "Send AML Form" is one-shot -
                 hidden as soon as any request exists for this order (use "Resend KYC
                 Form Email" on the request after that). "AML Bypass" stays available
                 even after the form was sent, for as long as the pipeline hasn't
                 reached a final outcome (aml_bypass_allowed) - bypassing at that point
                 expires the KYC link already emailed to the client. -->
            <xpath expr="//button[@name='action_approve_order']" position="after">
                <button name="action_send_aml_form" string="Send AML Form" type="object"
                    class="btn-primary"
                    invisible="approval_state != 'approved' or aml_request_count &gt; 0 or not aml_action_allowed"/>
                <button name="action_open_aml_bypass_wizard" string="AML Bypass" type="object"
                    class="btn-warning"
                    invisible="approval_state != 'approved' or not aml_action_allowed or not aml_bypass_allowed"/>
            </xpath>

            <!-- AML smart button - shown to every user once the AML/KYC form
                 has been sent or bypassed (aml_request_count is always >= 1
                 at that point, see aml.bypass.wizard which creates a request
                 even for an outright bypass). Clicking it opens the actual
                 case file only for the AML team, who hold model access to
                 aml.request; everyone else gets a status summary instead
                 (see action_view_aml_requests). -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_aml_requests" type="object"
                    class="oe_stat_button" icon="fa-shield"
                    invisible="aml_request_count == 0">
                    <field name="aml_request_count" widget="statinfo" string="AML"/>
                </button>
            </xpath>

        </field>
    </record>

    <!-- Services search filters: orders where the AML/KYC form was actually
         sent (has at least one aml.request) but the gate isn't cleared yet;
         orders where the form was sent to the client (aml_form_status is
         only ever set by action_send_aml_form's "Send AML Form" button, so
         this excludes orders whose AML gate was cleared purely by an
         outright bypass); and orders whose AML/KYC check was bypassed.
         Anchored on the base sale.order search view (not the
         Services-specific "quotation" primary view) so they show on every
         Services menu, same pattern as
         view_sales_order_filter_inherit_salesperson_manager in
         crm_extended_rk. -->
    <record id="view_sales_order_filter_inherit_pending_aml" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.pending.aml</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <filter string="Pending AML" name="pending_aml"
                        domain="[('aml_request_ids', '!=', False), ('aml_gate_completed', '=', False)]"/>
                <filter string="AML Forms Sent" name="aml_forms_sent"
                        domain="[('aml_form_status', '=', 'sent')]"/>
                <filter string="AML Bypassed" name="aml_bypassed"
                        domain="[('aml_request_ids.state', '=', 'bypassed')]"/>
            </filter>
        </field>
    </record>

    <!-- Reason column for the "AML Bypassed" filter above, on both Services
         list views - Quotations (view_quotation_tree_with_onboarding) and
         Sales Orders (view_order_tree) are separate base tree views, same
         split account_extended_rk already bridges for partner_credit_hold /
         billing_plan_code. Hidden by default (optional="hide") like those,
         toggleable from the list's column picker. -->
    <record id="view_quotation_list_aml_bypass_reason" model="ir.ui.view">
        <field name="name">sale.order.list.aml.bypass.reason.quotation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="aml_bypass_reason" string="AML Bypass Reason" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_order_list_aml_bypass_reason" model="ir.ui.view">
        <field name="name">sale.order.list.aml.bypass.reason.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="amount_total" position="before">
                <field name="aml_bypass_reason" string="AML Bypass Reason" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
