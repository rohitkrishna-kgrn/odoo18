<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- AML Officers only see/access the requests assigned to them -->
        <record id="rule_aml_request_officer_assigned" model="ir.rule">
            <field name="name">AML Request: Officer sees own assigned records</field>
            <field name="model_id" ref="model_aml_request"/>
            <field name="domain_force">[('aml_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_aml_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- AML Users also see Draft/New requests regardless of assignment -
             Accept/Bypass/Cancel/Resend KYC Email (now open to AML Users,
             same as AML Managers) only ever apply before an officer has been
             assigned, so the officer-assigned rule above would otherwise hide
             every one of these records from a plain AML User. Combines with
             the rule above via OR (same group, non-global rules OR together
             in Odoo), so a User sees: their own assigned cases in any state,
             plus every Draft/New case regardless of assignment. -->
        <record id="rule_aml_request_user_new_draft" model="ir.rule">
            <field name="name">AML Request: User also sees Draft/New records (pre-assignment)</field>
            <field name="model_id" ref="model_aml_request"/>
            <field name="domain_force">[('state', 'in', ('draft', 'new'))]</field>
            <field name="groups" eval="[(4, ref('group_aml_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- AML Managers see/access all requests regardless of assignment -->
        <record id="rule_aml_request_manager_all" model="ir.rule">
            <field name="name">AML Request: Manager sees all records</field>
            <field name="model_id" ref="model_aml_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_aml_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
