<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ─────────────────────────────────────────────── -->
    <record id="view_task_transfer_list" model="ir.ui.view">
        <field name="name">task.transfer.list</field>
        <field name="model">task.transfer</field>
        <field name="arch" type="xml">
            <list string="Task Transfers" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="from_user_ids" widget="many2many_tags"/>
                <field name="to_user_ids" widget="many2many_tags"/>
                <field name="transferred_by"/>
                <field name="transfer_date"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────────────── -->
    <record id="view_task_transfer_form" model="ir.ui.view">
        <field name="name">task.transfer.form</field>
        <field name="model">task.transfer</field>
        <field name="arch" type="xml">
            <form string="Task Transfer" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Task Details">
                            <field name="task_id" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                        </group>
                        <group string="Transfer Info">
                            <field name="transferred_by" readonly="1"/>
                            <field name="transfer_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Removed From Task">
                            <field name="from_user_ids" widget="many2many_tags" readonly="1" nolabel="1"/>
                        </group>
                        <group string="Added To Task">
                            <field name="to_user_ids" widget="many2many_tags" readonly="1" nolabel="1"/>
                        </group>
                    </group>
                    <group string="Transfer Reason">
                        <field name="reason" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Search View ───────────────────────────────────────────── -->
    <record id="view_task_transfer_search" model="ir.ui.view">
        <field name="name">task.transfer.search</field>
        <field name="model">task.transfer</field>
        <field name="arch" type="xml">
            <search string="Search Transfers">
                <field name="name"/>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="transferred_by"/>
                <field name="from_user_ids"/>
                <field name="to_user_ids"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_transferred_by" string="Transferred By" context="{'group_by': 'transferred_by'}"/>
                    <filter name="group_by_date" string="Transfer Date" context="{'group_by': 'transfer_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Window Action ─────────────────────────────────────────── -->
    <record id="action_task_transfer_history" model="ir.actions.act_window">
        <field name="name">Transfer History</field>
        <field name="res_model">task.transfer</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_task_transfer_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No task transfers yet.</p>
            <p>
                Use the <b>Transfer Task</b> button on any task form, or
                open <b>New Transfer</b> from the menu, to reassign tasks
                between team members.
            </p>
        </field>
    </record>

</odoo>
