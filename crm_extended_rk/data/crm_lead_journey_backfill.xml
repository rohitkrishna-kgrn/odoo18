<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Rebuild the journey log from the history already in the database, so
         the timeline and the reports are not empty on the day this ships.
         The method skips any lead that already has events, so this running
         again on every future upgrade is a no-op. -->
    <function model="crm.lead" name="_backfill_journey_events"/>
</odoo>
