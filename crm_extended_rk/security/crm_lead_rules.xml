<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Own-documents salespeople may reassign a lead: afterwards the
             "Personal Leads" rule no longer matches, so let the previous owner
             keep reading it (rules of one group are OR-ed). -->
        <record id="crm_lead_rule_previous_owner" model="ir.rule">
            <field name="name">Leads: previous salesperson can read</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">[('previous_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
