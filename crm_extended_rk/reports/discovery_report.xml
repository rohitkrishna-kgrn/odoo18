<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Top/bottom margins reserve space for the repeating header/footer so
         multi-page content never overlaps them. Left/right 0 -> full bleed. -->
    <record id="paperformat_discovery" model="report.paperformat">
        <field name="name">Discovery Form A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">18</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_spacing">0</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_discovery_form" model="ir.actions.report">
        <field name="name">Discovery Form</field>
        <field name="model">crm.lead.discovery.form</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">crm_extended_rk.report_discovery_form_document</field>
        <field name="report_file">crm_extended_rk.report_discovery_form_document</field>
        <field name="paperformat_id" ref="paperformat_discovery"/>
        <field name="binding_model_id" ref="model_crm_lead_discovery_form"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Discovery Form - %s - %s' % (object.form_label or '', object.lead_id.name or '').replace('/', '-')</field>
    </record>

    <template id="report_discovery_form_document">
        <t t-call="web.html_container">
            <style>
                * { -webkit-print-color-adjust: exact; print-color-adjust: exact; box-sizing: border-box; }
                /* Neutralise the report layout's bootstrap container -> full bleed */
                body, #wrapwrap, main { max-width: none !important; width: 100% !important; margin: 0 !important; padding: 0 !important; background: #fff !important; }
                body { font-family: 'Segoe UI', Arial, sans-serif; color: #111827; font-size: 14px; }
                .disc-serif { font-family: Georgia, 'Times New Roman', serif; }

                /* ---- Repeating header (sits in the 18mm top margin) ---- */
                .disc-header {
                    position: fixed; top: 0; left: 0; right: 0; height: 18mm;
                    background: #fff; border-bottom: 1px solid #e5e9ef;
                }
                .disc-header table { width: 100%; height: 18mm; border-collapse: collapse; }
                .disc-header td { vertical-align: middle; }
                .disc-header td.hleft { padding-left: 16mm; white-space: nowrap; }
                .disc-header td.hright {
                    padding-right: 16mm; text-align: right; font-size: 11px;
                    letter-spacing: 1.5px; text-transform: uppercase; color: #6b7280;
                }
                .disc-header .hlogo { display: inline-block; vertical-align: middle; margin-right: 10px; }
                .disc-header .hlogo img { height: 24px; display: block; }
                .disc-header .hname { font-weight: 700; font-size: 15px; color: #0d2b45; vertical-align: middle; }

                /* ---- Repeating footer (sits in the 14mm bottom margin) ---- */
                .disc-footer {
                    position: fixed; bottom: 0; left: 0; right: 0; height: 14mm;
                    background: #fff; border-top: 1px solid #e5e9ef;
                }
                .disc-footer table { width: 100%; height: 14mm; border-collapse: collapse; }
                .disc-footer td { vertical-align: middle; font-size: 11px; color: #6b7280; }
                .disc-footer td.fleft { padding-left: 16mm; }
                .disc-footer td.fright {
                    padding-right: 16mm; text-align: right;
                    letter-spacing: 1.5px; text-transform: uppercase;
                }

                /* ---- Cover (white, fills the whole content area) ---- */
                .disc-cover {
                    background: #fff; color: #111827; height: 265mm;
                    position: relative; overflow: hidden; page-break-after: always;
                    padding: 40mm 20mm 0;
                }
                .disc-cover::after {
                    content: ''; position: absolute; right: -80mm; bottom: -70mm;
                    width: 190mm; height: 190mm; border-radius: 50%;
                    background: rgba(13,43,69,0.035);
                }
                .disc-tag {
                    display: inline-block;
                    border: 1.5px solid #0d2b45; border-radius: 4px;
                    padding: 8px 14px; font-size: 14px; letter-spacing: 3px;
                    text-transform: uppercase; color: #0d2b45; font-weight: 600;
                }
                .disc-cover-title {
                    font-size: 52px; font-weight: 700; line-height: 1.05;
                    margin: 22px 0 0; text-transform: uppercase; letter-spacing: .5px; color: #0d2b45;
                }
                .disc-accent { width: 80px; height: 5px; background: #f26522; margin: 26px 0; }
                .disc-completed { font-size: 22px; color: #374151; }
                .disc-completed b { color: #0d2b45; }
                .disc-cover-meta {
                    position: absolute; left: 20mm; right: 20mm; bottom: 18mm;
                    border-top: 2px solid #e5e9ef; padding-top: 16px;
                }
                .disc-cover-meta table { width: 100%; border-collapse: collapse; }
                .disc-cover-meta td { width: 25%; vertical-align: top; }
                .disc-cover-meta .lbl {
                    font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: #9aa3af;
                }
                .disc-cover-meta .val { font-size: 17px; font-weight: 700; color: #0d2b45; margin-top: 6px; }

                /* ---- Content (white) ---- */
                .disc-content { padding: 8mm 16mm 6mm; background: #fff; }
                .disc-sec { page-break-inside: avoid; margin-bottom: 9mm; }
                .disc-sec h2 {
                    font-size: 22px; color: #0d2b45; font-weight: 700;
                    border-bottom: 2px solid #eceff3; padding-bottom: 8px; margin: 0 0 4px;
                }
                .disc-sec h2 .num { color: #f26522; }
                table.disc-kv { width: 100%; border-collapse: collapse; }
                table.disc-kv td {
                    padding: 10px 14px; vertical-align: top; font-size: 15px;
                    border-bottom: 1px solid #eef1f4;
                }
                table.disc-kv td.k { width: 44%; color: #6b7280; background: #f7f9fb; }
                table.disc-kv td.v { color: #111827; font-weight: 600; }
                ul.disc-vlist { margin: 0; padding-left: 16px; }
                ul.disc-vlist li { margin: 2px 0; }
                .disc-ent-label {
                    font-size: 13px; letter-spacing: 1.5px; text-transform: uppercase;
                    color: #8a94a3; margin: 14px 0 7px; font-weight: 700;
                }
                table.disc-ent { width: 100%; border-collapse: collapse; font-size: 13px; }
                table.disc-ent th {
                    background: #0d2b45; color: #fff; padding: 9px 9px;
                    text-align: left; font-weight: 600; font-size: 12px;
                }
                table.disc-ent td {
                    border: 1px solid #e5e9ef; padding: 9px 9px; vertical-align: top; color: #1f2937;
                }
                table.disc-ent tr:nth-child(even) td { background: #fbfcfd; }
                .disc-ent .ent-name { font-weight: 700; color: #0d2b45; }
                .disc-svc { color: #f26522; font-weight: 700; }
                .disc-sign img {
                    max-height: 110px; border: 1px solid #e5e9ef; border-radius: 6px;
                    padding: 6px; background: #fff; margin-top: 6px;
                }
            </style>

            <!-- Repeating header -->
            <div class="disc-header">
                <table><tr>
                    <td class="hleft">
                        <span t-if="logo_src" class="hlogo"><img t-att-src="logo_src"/></span>
                        <span class="hname"><t t-esc="company.name"/></span>
                    </td>
                    <td class="hright">Discovery &amp; Readiness Assessment</td>
                </tr></table>
            </div>

            <!-- Repeating footer -->
            <div class="disc-footer">
                <table><tr>
                    <td class="fleft"><t t-esc="company.name"/> | kgrnaudit.com | <t t-esc="company.email or 'info@kgrnaudit.com'"/></td>
                    <td class="fright">Confidential</td>
                </tr></table>
            </div>

            <t t-foreach="docs" t-as="doc">
                <t t-set="r" t-value="report[doc.id]"/>

                <!-- ===== COVER ===== -->
                <div class="disc-cover">
                    <div class="disc-tag"><t t-esc="r['form_label']"/></div>
                    <div class="disc-cover-title disc-serif">Discovery &amp; Readiness Assessment</div>
                    <div class="disc-accent"></div>
                    <div class="disc-completed">Completed for <b><t t-esc="r['client']"/></b></div>

                    <div class="disc-cover-meta">
                        <table>
                            <tr>
                                <td><div class="lbl">Order Ref</div><div class="val"><t t-esc="r['order_ref']"/></div></td>
                                <td><div class="lbl">Client</div><div class="val"><t t-esc="r['client']"/></div></td>
                                <td><div class="lbl">Contact</div><div class="val"><t t-esc="r['contact']"/></div></td>
                                <td><div class="lbl">Submitted</div><div class="val"><t t-esc="r['submitted_str'] or '-'"/></div></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- ===== CONTENT ===== -->
                <div class="disc-content">
                    <t t-foreach="r['sections']" t-as="section">
                        <div class="disc-sec">
                            <h2 class="disc-serif"><span class="num"><t t-esc="section['id']"/></span> - <t t-esc="section['title']"/></h2>

                            <table class="disc-kv" t-if="section['rows']">
                                <t t-foreach="section['rows']" t-as="row">
                                    <tr>
                                        <td class="k"><t t-esc="row['label']"/></td>
                                        <td class="v">
                                            <t t-if="len(row['values']) == 1"><t t-esc="row['values'][0]"/></t>
                                            <ul class="disc-vlist" t-else="">
                                                <li t-foreach="row['values']" t-as="v"><t t-esc="v"/></li>
                                            </ul>
                                        </td>
                                    </tr>
                                </t>
                            </table>

                            <!-- Entity details: one key/value block per entity -->
                            <t t-if="section['entities']">
                                <div class="disc-ent-label">Entity Details</div>
                                <t t-foreach="section['entities']" t-as="ent">
                                    <table class="disc-kv" style="margin-bottom:6px;">
                                        <tr>
                                            <td class="k" colspan="2" style="background:#0d2b45;color:#fff;font-weight:700;">
                                                <t t-esc="ent_index + 1"/>. <t t-esc="ent['name'] or 'Entity %s' % (ent_index + 1)"/>
                                            </td>
                                        </tr>
                                        <t t-foreach="ent['cells']" t-as="cell">
                                            <tr>
                                                <td class="k"><t t-esc="cell['label']"/></td>
                                                <td class="v">
                                                    <t t-if="len(cell['values']) == 1"><t t-esc="cell['values'][0]"/></t>
                                                    <ul class="disc-vlist" t-else="">
                                                        <li t-foreach="cell['values']" t-as="v"><t t-esc="v"/></li>
                                                    </ul>
                                                </td>
                                            </tr>
                                        </t>
                                    </table>
                                </t>
                            </t>

                            <!-- Signature -->
                            <div class="disc-sign" t-if="section['signature']">
                                <div class="disc-ent-label">Signature</div>
                                <img t-att-src="section['signature']"/>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

</odoo>
