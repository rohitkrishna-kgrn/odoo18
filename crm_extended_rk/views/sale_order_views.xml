<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit Sale Order form view -->
    <record id="view_order_form_inherit_crm_extended_rk" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.crm.extended.rk</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add reminder_date right after partner_id -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="reminder_date"/>
            </xpath>

            <!-- Extend sale order lines list view to add new fields -->
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="engagement_start"/>
                <field name="engagement_end"/>
                <field name="manager_id"/>
                <field name="estimated_hours"/>
                <field name="deadline"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_tag_ids" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tag_ids</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- The approved list now lives on the field itself
                 (models/crm_tag.py), so the view only hides the create link.
                 Keeping the names here too would let the two lists drift. -->
            <field name="tag_ids" position="attributes">
                <attribute name="options">{'color_field': 'color', 'no_create_edit': True, 'no_create': True}</attribute>
            </field>
        </field>
    </record>

    <record id="view_order_form_inherit_status" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.order_status</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
        <!-- find the reminder_date field and insert after it -->
            <xpath expr="//field[@name='reminder_date']" position="after">
                <field name="order_status" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_advance_amount" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.advance.amount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Insert advance_amount after payment_term_id -->
            <field name="payment_term_id" position="after">
                <field name="advance_amount"/>
                <field name="auto_invoice"/>
            </field>
        </field>
    </record>

    <record id="view_order_form_inherit_einvoicing" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.einvoicing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <!-- Locked ON when the linked opportunity is an eInvoicing one -->
                <field name="opportunity_einvoicing" invisible="1"/>
                <field name="einvoicing_service" widget="boolean_toggle"
                       readonly="opportunity_einvoicing"/>
                <field name="entity_count"
                       invisible="not einvoicing_service"
                       required="einvoicing_service"/>
                <field name="entity_amount_total"
                       invisible="not entity_ids"/>
            </field>
        </field>
    </record>

    <!-- Entities tab: one row per covered entity, generated by entity_count -->
    <record id="view_order_form_inherit_entities" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.entities</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Entities" name="entities"
                      invisible="not einvoicing_service and not entity_ids">
                    <div class="text-muted mb-2">
                        One row per entity covered by this engagement, generated from
                        <b>Number of Entities</b> above. Raise that number to add rows,
                        lower it to drop them off the bottom. The names and prices below
                        are printed under the Commercial Structure in the proposal PDF.
                    </div>
                    <!-- Invoice counts are read from the eInvoicing discovery form
                         only; they are never typed here. -->
                    <div class="mb-2">
                        <button name="action_fetch_discovery_invoice_counts" type="object"
                                string="Fetch Invoice Counts" class="btn-secondary"
                                icon="fa-download"/>
                        <span class="text-muted ms-2" invisible="not discovery_counts_date">
                            Annual invoice counts read from
                            <field name="discovery_counts_form_id" readonly="1" nolabel="1"
                                   options="{'no_open': True}" class="oe_inline"/>
                            on
                            <field name="discovery_counts_date" readonly="1" nolabel="1"
                                   class="oe_inline"/>.
                        </span>
                        <span class="text-muted ms-2" invisible="discovery_counts_date">
                            Annual invoice counts come from the eInvoicing discovery
                            form — fetch them once the client has submitted it.
                        </span>
                    </div>
                    <field name="entity_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="entity_no" string="Entity" readonly="1"/>
                            <field name="name" placeholder="e.g. ABC Pvt Ltd"/>
                            <field name="inbound_count_display" string="Annual Inbound"
                                   readonly="1"/>
                            <field name="outbound_count_display" string="Annual Outbound"
                                   readonly="1"/>
                            <field name="discovery_state" string="Discovery Form"
                                   widget="badge" readonly="1"
                                   decoration-success="discovery_state == 'matched'"
                                   decoration-warning="discovery_state in ['incomplete', 'ambiguous']"
                                   decoration-danger="discovery_state == 'unmatched'"
                                   decoration-muted="discovery_state == 'none'"/>
                            <field name="discovery_needs_review" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="price" widget="monetary"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="entity_amount_total"
                               class="oe_subtotal_footer_separator"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>


    <!-- Inherit Project form view to add estimated_hours -->
    <record id="view_project_form_inherit_estimated_hours" model="ir.ui.view">
        <field name="name">project.project.form.inherit.estimated.hours</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <field name="estimated_hours"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit product form view to add estimated_hours -->
    <record id="view_product_template_form_inherit_estimated_hours" model="ir.ui.view">
        <field name="name">product.template.form.inherit.estimated.hours</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>  <!-- Correct reference -->
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supplier_taxes_id']" position="after">
                <field name="estimated_hours"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_list_upload_inherit_paid_pending" model="ir.ui.view">
        <field name="name">sale.order.list.upload.inherit.paid.pending</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_list_upload"/>
        <field name="arch" type="xml">
            <!-- Locate the activities field (usually field with widget 'activity') -->
            <xpath expr="//field[@name='activity_ids']" position="after">
            <field name="posted_invoice_total"/>
            <field name="paid_amount"/>
            <field name="pending_amount"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_invoice_button" model="ir.ui.view">
        <field name="name">sale.order.form.invoice.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_invoice_wizard"
                        string="Create Invoice"
                        type="object"
                        class="btn-primary"
                        invisible="auto_invoice == True"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_invoice_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.invoice.wizard.form</field>
        <field name="model">sale.order.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Invoice">
                <group>
                    <field name="invoice_amount"/>
                </group>
                <footer>
                    <button string="Create" type="object" name="create_partial_invoice" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
