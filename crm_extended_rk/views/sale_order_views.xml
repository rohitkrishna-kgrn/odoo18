<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit Sale Order form view -->
    <record id="view_order_form_inherit_crm_extended_rk" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.crm.extended.rk</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add reminder_date right after partner_id -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="reminder_date"/>
            </xpath>

            <!-- Extend sale order lines list view to add new fields -->
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="engagement_start"/>
                <field name="engagement_end"/>
                <field name="manager_id"/>
                <field name="estimated_hours"/>
                <field name="deadline"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_tag_ids" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tag_ids</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- The approved list now lives on the field itself
                 (models/crm_tag.py), so the view only hides the create link.
                 Keeping the names here too would let the two lists drift. -->
            <field name="tag_ids" position="attributes">
                <attribute name="options">{'color_field': 'color', 'no_create_edit': True, 'no_create': True}</attribute>
            </field>
        </field>
    </record>

    <record id="view_order_form_inherit_status" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.order_status</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
        <!-- find the reminder_date field and insert after it -->
            <xpath expr="//field[@name='reminder_date']" position="after">
                <field name="order_status" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_advance_amount" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.advance.amount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Insert advance_amount after payment_term_id -->
            <field name="payment_term_id" position="after">
                <field name="advance_amount"/>
                <field name="auto_invoice"/>
            </field>
        </field>
    </record>

    <record id="view_order_form_inherit_einvoicing" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.einvoicing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <!-- Locked ON when the linked opportunity is an eInvoicing one -->
                <field name="opportunity_einvoicing" invisible="1"/>
                <field name="einvoicing_service" widget="boolean_toggle"
                       readonly="opportunity_einvoicing"/>
                <field name="entity_count"
                       invisible="not einvoicing_service"
                       required="einvoicing_service"/>
                <field name="entity_amount_total"
                       invisible="not entity_ids"/>
            </field>

            <!-- Subscription overage rate: the last line above Untaxed Amount,
                 the same place it takes in the proposal PDF, and typed by hand.
                 The monetary widget parks its symbol on an absolutely
                 positioned overlay that trails the digits as they are typed, so
                 the symbol is switched off ('no_symbol') and the currency
                 printed beside the box instead - it stays put while typing, and
                 the fixed-width box keeps it off the number. -->
            <xpath expr="//page[@name='order_lines']//field[@name='tax_totals']"
                   position="before">
                <field name="has_asp_subscription" invisible="1"/>
                <div class="d-flex float-end align-items-baseline gap-2" colspan="2"
                     invisible="not einvoicing_service or not has_asp_subscription">
                    <label for="einv_overage_per_1000"/>
                    <div class="text-end" style="width:120px;">
                        <field name="einv_overage_per_1000" nolabel="1"
                               options="{'no_symbol': True}" class="oe_inline"/>
                    </div>
                    <field name="currency_id" nolabel="1" readonly="1"
                           options="{'no_open': True}" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Entities tab: one row per covered entity, generated by entity_count -->
    <record id="view_order_form_inherit_entities" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.entities</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Entities" name="entities"
                      invisible="not einvoicing_service and not entity_ids">
                    <div class="text-muted mb-2">
                        One row per entity covered by this engagement, generated from
                        <b>Number of Entities</b> above. Raise that number to add rows,
                        lower it to drop them off the bottom. The names, invoice counts,
                        services and prices below are printed under the Commercial
                        Structure in the proposal PDF.
                    </div>
                    <!-- Invoice counts come from the eInvoicing discovery form
                         when the client has submitted one; the two count cells
                         below stay editable for an entity it does not cover. -->
                    <div class="mb-2">
                        <button name="action_fetch_discovery_invoice_counts" type="object"
                                string="Fetch Invoice Counts" class="btn-secondary"
                                icon="fa-download"/>
                        <span class="text-muted ms-2" invisible="not discovery_counts_date">
                            Annual invoice counts read from
                            <field name="discovery_counts_form_id" readonly="1" nolabel="1"
                                   options="{'no_open': True}" class="oe_inline"/>
                            on
                            <field name="discovery_counts_date" readonly="1" nolabel="1"
                                   class="oe_inline"/>. Any count can still be
                            typed over below, and a typed one is left alone the
                            next time they are fetched.
                        </span>
                        <span class="text-muted ms-2" invisible="discovery_counts_date">
                            Annual invoice counts come from the eInvoicing discovery
                            form — fetch them once the client has submitted it, or
                            type them in below.
                        </span>
                    </div>
                    <field name="has_discovery_entities" invisible="1"/>
                    <field name="discovery_entity_ids" invisible="1"/>
                    <field name="available_discovery_entity_ids" invisible="1"/>
                    <field name="entity_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="entity_no" string="Entity" readonly="1"/>
                            <!-- Names come from the client's own discovery form
                                 when there is one; typed by hand when there is
                                 not, or for an entity the form never mentioned. -->
                            <field name="discovery_entity_id" string="Entity Name"
                                   column_invisible="not parent.has_discovery_entities"
                                   domain="[('id', 'in', parent.available_discovery_entity_ids)]"
                                   options="{'no_create': True, 'no_open': True}"
                                   placeholder="Pick from the discovery form"/>
                            <!-- Free-text fallback, only when there is no discovery
                                 form to pick from. The dropdown writes this field. -->
                            <field name="name" string="Entity Name"
                                   column_invisible="parent.has_discovery_entities"
                                   placeholder="e.g. ABC Pvt Ltd"/>
                            <!-- Editable: a blank cell means "not known yet" and
                                 is kept apart from a stated 0, so it is a text
                                 cell rather than an integer one. -->
                            <field name="inbound_count_display" string="Annual Inbound"
                                   placeholder="e.g. 1,200"/>
                            <field name="outbound_count_display" string="Annual Outbound"
                                   placeholder="e.g. 800"/>
                            <!-- Names only in the PDF: this picks what the entity
                                 is covered for, not what it is billed for. -->
                            <field name="service_ids" string="Services"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Pick the services"/>
                            <field name="discovery_state" string="Counts Source"
                                   widget="badge" readonly="1"
                                   decoration-success="discovery_state == 'matched'"
                                   decoration-info="discovery_state == 'manual'"
                                   decoration-warning="discovery_state in ['incomplete', 'ambiguous']"
                                   decoration-danger="discovery_state == 'unmatched'"
                                   decoration-muted="discovery_state == 'none'"/>
                            <field name="discovery_needs_review" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="price" widget="monetary"/>
                        </list>
                    </field>
                    <!-- Total line: the three totals side by side.
                         `col="6"` is what puts them on one row - each labelled
                         field takes two of the six columns - and it is
                         deliberately a plain group rather than hand-rolled
                         flex: a d-flex row of fixed-width boxes fought the
                         field widget's own CSS and the values ended up printed
                         over the next label. `oe_subtotal_footer` is no good
                         either, it stacks one field per line.
                         All three are typeable: the counts are summed from the
                         rows until something is typed over them, and clearing
                         a cell hands it back to the rows. -->
                    <div class="mt-3 pt-2 border-top">
                        <group col="6">
                            <field name="entity_inbound_total_display"
                                   string="Total Annual Inbound"
                                   placeholder="e.g. 1,332"/>
                            <field name="entity_outbound_total_display"
                                   string="Total Annual Outbound"
                                   placeholder="e.g. 3,522"/>
                            <field name="entity_amount_total"
                                   string="Entity Total"/>
                        </group>
                        <div class="text-muted small">
                            Summed from the rows above, and typeable over. Clear a
                            cell to hand it back to the rows; with no rows at all,
                            what is typed here is what the proposal prints.
                        </div>
                    </div>
                </page>
            </xpath>
        </field>
    </record>


    <!-- Inherit Project form view to add estimated_hours -->
    <record id="view_project_form_inherit_estimated_hours" model="ir.ui.view">
        <field name="name">project.project.form.inherit.estimated.hours</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <field name="estimated_hours"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit product form view to add estimated_hours -->
    <record id="view_product_template_form_inherit_estimated_hours" model="ir.ui.view">
        <field name="name">product.template.form.inherit.estimated.hours</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>  <!-- Correct reference -->
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supplier_taxes_id']" position="after">
                <field name="estimated_hours"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_list_upload_inherit_paid_pending" model="ir.ui.view">
        <field name="name">sale.order.list.upload.inherit.paid.pending</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_list_upload"/>
        <field name="arch" type="xml">
            <!-- Locate the activities field (usually field with widget 'activity') -->
            <xpath expr="//field[@name='activity_ids']" position="after">
            <field name="posted_invoice_total"/>
            <field name="paid_amount"/>
            <field name="pending_amount"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_invoice_button" model="ir.ui.view">
        <field name="name">sale.order.form.invoice.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_invoice_wizard"
                        string="Create Invoice"
                        type="object"
                        class="btn-primary"
                        invisible="auto_invoice == True"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_invoice_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.invoice.wizard.form</field>
        <field name="model">sale.order.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Invoice">
                <group>
                    <field name="invoice_amount"/>
                </group>
                <footer>
                    <button string="Create" type="object" name="create_partial_invoice" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Services lists: search field + Group By for the salesperson's manager.
         Anchored on the base sale.order search view so it shows on every
         Services menu (Quotations and Service Engagement). The native
         "Salesperson" Group By already lives in that same group. -->
    <record id="view_sales_order_filter_inherit_salesperson_manager" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.salesperson.manager</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="salesperson_manager_id" string="Salesperson's Manager"/>
            </field>
            <!-- "team_id" on the order itself is unreliable (it's often a
                 stale default set at order creation and never updated), so
                 team scoping below is done off the salesperson's CURRENT team
                 membership instead: res.users.sale_team_id is the team of the
                 salesperson's single active crm.team.member row (Configuration
                 > Sales Teams > that team > Members), kept correct
                 automatically whenever membership changes.

                 These must stay plain domain filters (no "group_by" in
                 context): Odoo's search view parser reclassifies any filter
                 whose context resolves a group_by field as a pure "groupBy"
                 item and then never reads its domain at all (see
                 visitFilter() in web/static/src/search/search_arch_parser.js)
                 - so combining a domain with group_by on one filter silently
                 drops the domain and shows every record. Group by Salesperson
                 separately (already offered below) to fold/unfold within the
                 filtered team. -->
            <filter name="my_sale_orders_filter" position="after">
                <filter string="My Sales Team" name="my_sales_team_filter"
                        domain="['|', ('user_id', '=', uid), ('user_id.sale_team_id.user_id', '=', uid)]"/>
                <!-- One quick filter per active Sales Team, so a team's name is
                     directly clickable under Filters and instantly narrows the
                     list to only that team's current Members (Configuration >
                     Sales Teams > that team > Members), not everyone whose
                     order happens to be tagged with that team_id. These teams
                     have no XML id (created from the UI), so they are matched
                     by name; a newly created team needs a new line here to
                     appear in this list. -->
                <filter string="Sales" name="groupby_team_sales"
                        domain="[('user_id.sale_team_id.name', '=', 'Sales')]"/>
                <filter string="Gokul" name="groupby_team_gokul"
                        domain="[('user_id.sale_team_id.name', '=', 'Gokul')]"/>
                <filter string="TEST" name="groupby_team_test"
                        domain="[('user_id.sale_team_id.name', '=', 'TEST')]"/>
                <filter string="TEST TEAM" name="groupby_team_test_team"
                        domain="[('user_id.sale_team_id.name', '=', 'TEST TEAM')]"/>
            </filter>
            <filter name="salesperson" position="after">
                <filter string="Sales Team" name="groupby_team"
                        context="{'group_by': 'team_id'}"/>
                <filter string="Salesperson's Manager" name="groupby_salesperson_manager"
                        context="{'group_by': 'salesperson_manager_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
