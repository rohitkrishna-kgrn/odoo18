<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form_discovery" model="ir.ui.view">
        <field name="name">crm.lead.form.discovery</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Discovery form / service type + linked sale order on the sheet (labelled).
                 Stays editable at all times: sending never locks it, so another
                 (same or different type) discovery form can be sent later. -->
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="discovery_form_type"/>
                <field name="sale_order_id" readonly="1"/>
                <field name="is_stage_new" invisible="1"/>
                <field name="is_stage_lost" invisible="1"/>
                <field name="is_stage_qualified" invisible="1"/>
                <field name="is_stage_not_qualified" invisible="1"/>
            </xpath>

            <!-- Notebook tab: reasons logged whenever the lead is moved to/from
                 Not Qualified via the header buttons. Read-only audit trail;
                 entries are only ever created through the reason wizard. -->
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page name="qualification_reasons" string="Qualification Reasons">
                    <field name="stage_reason_ids">
                        <list string="Qualification Reasons" create="false" edit="false" delete="false">
                            <field name="date"/>
                            <field name="stage_id"/>
                            <field name="reason"/>
                            <field name="user_id"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- Smart button: browse every discovery form sent for this opportunity -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_discovery_forms" type="object"
                        class="oe_stat_button" icon="fa-list-alt"
                        invisible="discovery_form_count == 0">
                    <field name="discovery_form_count" widget="statinfo"
                           string="Discovery Forms"/>
                </button>
            </xpath>

            <!-- Mandatory lead information: Company Name, Email, Phone, Tags (Lead
                 Source) and Source must all be filled in before a lead/opportunity
                 can be created or saved. -->
            <xpath expr="//page[@name='lead']//field[@name='partner_name']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']//field[@name='email_from']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']//field[@name='phone']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']//field[@name='source_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>

            <!-- Stage may only be changed through buttons: make the statusbar
                 readonly / non-clickable (drag &amp; drop is disabled in the kanban below). -->
            <xpath expr="//field[@name='stage_id'][@widget='statusbar_duration']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="options">{'clickable': '0', 'fold_field': 'fold'}</attribute>
            </xpath>

            <!-- Remove the native "Won" button (stage is button-driven only) -->
            <xpath expr="//header/button[@name='action_set_won_rainbowman']" position="replace"/>

            <!-- Manual stage buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_move_to_qualified" type="object"
                        string="Move to Qualified" class="btn-primary"
                        invisible="not is_stage_new"/>
                <button name="action_move_to_new" type="object"
                        string="Move to New"
                        invisible="not is_stage_lost"/>
                <button name="action_open_not_qualified_wizard" type="object"
                        string="Not Qualified"
                        invisible="not (is_stage_new or is_stage_qualified)"/>
                <button name="action_open_qualified_wizard" type="object"
                        string="Qualified" class="btn-primary"
                        invisible="not is_stage_not_qualified"/>
            </xpath>

            <!-- Header: compact "send" trigger. Always available once a form type is
                 picked — every click sends a fresh submission, so more than one
                 discovery form (same or different type) can be sent over time.
                 Sent forms + their client responses are browsed via the
                 "Discovery Forms" smart button above (list with download/preview). -->
            <xpath expr="//header" position="inside">
                <button name="action_send_discovery_form" type="object"
                        string="Send Discovery Form" class="btn-primary o_send_discovery_form_btn"
                        icon="fa-paper-plane"
                        invisible="not discovery_form_type"/>
            </xpath>

        </field>
    </record>

    <!-- Disable drag &amp; drop between stages in the pipeline kanban -->
    <record id="crm_case_kanban_view_leads_no_drag" model="ir.ui.view">
        <field name="name">crm.lead.kanban.no.drag</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="records_draggable">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- Per-stage filters + Stage group-by on the pipeline search view -->
    <record id="crm_lead_search_stage_filters" model="ir.ui.view">
        <field name="name">crm.lead.search.stage.filters</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <filter name="filter_lost" position="after">
                <separator/>
                <filter string="Stage: New" name="stage_new"
                        domain="[('stage_id.name', '=', 'New')]"/>
                <filter string="Stage: Qualified" name="stage_qualified"
                        domain="[('stage_id.name', '=', 'Qualified')]"/>
                <filter string="Stage: Not Qualified" name="stage_not_qualified"
                        domain="[('stage_id.name', '=', 'Not Qualified')]"/>
                <filter string="Stage: Proposition" name="stage_proposition"
                        domain="[('stage_id.name', '=', 'Proposition')]"/>
                <filter string="Stage: Service Engagement" name="stage_service_engagement"
                        domain="[('stage_id.name', '=', 'Service Engagement')]"/>
                <filter string="Stage: Won" name="stage_won"
                        domain="[('stage_id.name', '=', 'Won')]"/>
                <filter string="Stage: Lost" name="stage_lost_stage"
                        domain="[('stage_id.name', '=', 'Lost')]"/>
            </filter>
        </field>
    </record>

</odoo>
