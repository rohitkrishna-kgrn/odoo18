<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form_discovery" model="ir.ui.view">
        <field name="name">crm.lead.form.discovery</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- eInvoicing flag + linked sale order on the sheet (labelled) -->
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="einvoicing_service" widget="boolean_toggle"
                       readonly="discovery_form_state != 'not_sent'"/>
                <field name="sale_order_id" readonly="1"/>
                <field name="is_stage_new" invisible="1"/>
                <field name="is_stage_lost" invisible="1"/>
            </xpath>

            <!-- Stage may only be changed through buttons: make the statusbar
                 readonly / non-clickable (drag &amp; drop is disabled in the kanban below). -->
            <xpath expr="//field[@name='stage_id'][@widget='statusbar_duration']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="options">{'clickable': '0', 'fold_field': 'fold'}</attribute>
            </xpath>

            <!-- Remove the native "Won" button (stage is button-driven only) -->
            <xpath expr="//header/button[@name='action_set_won_rainbowman']" position="replace"/>

            <!-- Manual stage buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_move_to_qualified" type="object"
                        string="Move to Qualified" class="btn-primary"
                        invisible="not is_stage_new"/>
                <button name="action_move_to_new" type="object"
                        string="Move to New"
                        invisible="not is_stage_lost"/>
            </xpath>

            <!-- Header: eInvoicing toggle gates the send / resend buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_send_discovery_form" type="object"
                        string="Send Discovery Form to Client"
                        class="btn-primary" icon="fa-paper-plane"
                        invisible="not einvoicing_service or discovery_form_state != 'not_sent'"/>
                <button name="action_send_discovery_form" type="object"
                        string="Resend Discovery Form" icon="fa-refresh"
                        invisible="not einvoicing_service or discovery_form_state == 'not_sent'"/>
                <field name="discovery_form_state" widget="badge"
                        decoration-info="discovery_form_state == 'sent'"
                        decoration-success="discovery_form_state == 'submitted'"
                        invisible="discovery_form_state == 'not_sent'"/>
            </xpath>

            <!-- Notebook page with the submitted response -->
            <xpath expr="//notebook" position="inside">
                <page string="Discovery Form" name="discovery_form"
                      invisible="discovery_form_state == 'not_sent'">
                    <group>
                        <group>
                            <field name="discovery_form_state" readonly="1"/>
                            <field name="discovery_sent_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="discovery_submitted_date" readonly="1"/>
                            <field name="discovery_token" readonly="1"
                                   groups="base.group_no_one"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="discovery_form_state != 'sent'">
                        The discovery form has been sent to the client and is awaiting submission.
                    </div>
                    <div class="oe_button_box" invisible="discovery_form_state != 'submitted'">
                        <button name="action_download_discovery_pdf" type="object"
                                class="btn-secondary" icon="fa-file-pdf-o"
                                string="Download PDF"/>
                    </div>
                    <separator string="Client Response"
                               invisible="discovery_form_state != 'submitted'"/>
                    <field name="discovery_summary" nolabel="1"
                           invisible="discovery_form_state != 'submitted'"/>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Disable drag &amp; drop between stages in the pipeline kanban -->
    <record id="crm_case_kanban_view_leads_no_drag" model="ir.ui.view">
        <field name="name">crm.lead.kanban.no.drag</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="records_draggable">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- Per-stage filters + Stage group-by on the pipeline search view -->
    <record id="crm_lead_search_stage_filters" model="ir.ui.view">
        <field name="name">crm.lead.search.stage.filters</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <filter name="filter_lost" position="after">
                <separator/>
                <filter string="Stage: New" name="stage_new"
                        domain="[('stage_id.name', '=', 'New')]"/>
                <filter string="Stage: Qualified" name="stage_qualified"
                        domain="[('stage_id.name', '=', 'Qualified')]"/>
                <filter string="Stage: Proposition" name="stage_proposition"
                        domain="[('stage_id.name', '=', 'Proposition')]"/>
                <filter string="Stage: Service Engagement" name="stage_service_engagement"
                        domain="[('stage_id.name', '=', 'Service Engagement')]"/>
                <filter string="Stage: Won" name="stage_won"
                        domain="[('stage_id.name', '=', 'Won')]"/>
                <filter string="Stage: Lost" name="stage_lost_stage"
                        domain="[('stage_id.name', '=', 'Lost')]"/>
            </filter>
        </field>
    </record>

</odoo>
