<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_set_reason_wizard_form" model="ir.ui.view">
        <field name="name">crm.lead.set.reason.wizard.form</field>
        <field name="model">crm.lead.set.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason">
                <field name="lead_id" invisible="1"/>
                <field name="target_stage_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Explain why..." nolabel="1"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
