<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_set_source_wizard_form" model="ir.ui.view">
        <field name="name">crm.lead.set.source.wizard.form</field>
        <field name="model">crm.lead.set.source.wizard</field>
        <field name="arch" type="xml">
            <form string="Select a Source">
                <field name="lead_id" invisible="1"/>
                <p>A Source is required before this lead can move to Qualified.</p>
                <group>
                    <field name="source_id" options="{'no_create_edit': True}"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
